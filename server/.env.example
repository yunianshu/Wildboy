DATABASE_URL=jdbc:postgresql://localhost:5432/wildboy
DATABASE_USER=wildboy
DATABASE_PASSWORD=replace-with-a-local-secret
# Obtain credentials from WeChat official console, never commit real values.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ADMIN_USERNAME=
# BCrypt hash, not plaintext. Generate with your password manager/deployment process.
ADMIN_PASSWORD_HASH=
CORS_ORIGINS=http://localhost:5173
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/apiclient_key.pem
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_PUBLIC_KEY_PATH=/run/secrets/wechatpay_public_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/notify
# Development only, never on an internet-facing service:
# SPRING_PROFILES_ACTIVE=dev

# Base64 32-byte AES key supplied by operator; do not commit a real key.
IDENTITY_ENCRYPTION_KEY=
