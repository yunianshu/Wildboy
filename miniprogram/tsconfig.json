{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "strict": true,
    "types": [
      "miniprogram-api-typings"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "lib": [
      "ES2020"
    ],
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
