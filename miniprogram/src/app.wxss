@import "styles/motion.wxss";
page {
  background: #F6F8F3;
  color: #20372C;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
}
view,
text,
button {
  box-sizing: border-box;
}
button {
  font-size: 28rpx;
  border-radius: 10rpx;
  text-align: center;
}
button::after {
  border: 0;
}
image {
  display: block;
}
.ui-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.page {
  padding: 32rpx 28rpx 64rpx;
}
.eyebrow {
  font-size: 19rpx;
  letter-spacing: 5rpx;
  color: #5D7064;
  font-weight: 600;
}
.title {
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  margin: 12rpx 0 16rpx;
}
.muted {
  color: #5D7064;
  font-size: 24rpx;
  line-height: 1.8;
}
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 52rpx 0 24rpx;
}
.section-title {
  font-size: 38rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
}
.section-link {
  font-size: 24rpx;
  color: #5D7064;
  padding: 12rpx 0 12rpx 20rpx;
}
.primary,
.secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  line-height: 1.4;
}
.primary {
  background: #247A52;
  color: #FFFFFF;
  min-height: 84rpx;
  font-weight: 600;
}
.primary[disabled] {
  background: #E2E9E1;
  color: #fff;
}
.secondary {
  background: #EAF4E7;
  color: #1D6342;
  min-height: 76rpx;
}
.pill {
  display: inline-block;
  border: 1rpx solid #7B8D80;
  border-radius: 40rpx;
  padding: 8rpx 18rpx;
  font-size: 21rpx;
}
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx 20rpx;
}
.activity-card {
  min-width: 0;
}
.activity-image {
  width: 100%;
  height: 272rpx;
  border-radius: 12rpx;
  background: #EAF4E7;
}
.card-meta {
  font-size: 19rpx;
  color: #5D7064;
  letter-spacing: 2rpx;
  margin: 18rpx 0 10rpx;
}
.card-title {
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.45;
  color: #20372C;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.card-detail {
  font-size: 22rpx;
  color: #5D7064;
  margin-top: 10rpx;
  line-height: 1.6;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 22rpx;
}
.free {
  font-weight: 650;
}
.state {
  padding: 56rpx 20rpx;
  text-align: center;
  color: #5D7064;
  line-height: 1.8;
}
.state button {
  margin-top: 24rpx;
  width: 280rpx;
}
.loading-line {
  padding: 32rpx;
  text-align: center;
  font-size: 23rpx;
  color: #5D7064;
}
.error {
  color: #B03A2E;
}
.divider {
  height: 1rpx;
  background: #E2E9E1;
  margin: 32rpx 0;
}
.field {
  margin: 30rpx 0;
}
.label {
  display: block;
  font-size: 25rpx;
  margin-bottom: 14rpx;
  font-weight: 600;
}
input {
  height: 94rpx;
  background: #FFFFFF;
  border: 1rpx solid #7B8D80;
  padding: 0 24rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
}
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
.notice {
  font-size: 23rpx;
  line-height: 1.8;
  background: #EAF4E7;
  padding: 24rpx;
  border-radius: 10rpx;
  color: #5D7064;
}
.sticky-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #F6F8F3;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E2E9E1;
  z-index: 10;
}
.back-space {
  padding-bottom: 180rpx;
}
.small {
  font-size: 22rpx;
}
.body-copy {
  font-size: 28rpx;
  line-height: 1.95;
  white-space: pre-wrap;
  word-break: break-word;
}
.badge {
  background: #EAF5EE;
  color: #286747;
  border-radius: 6rpx;
  padding: 7rpx 12rpx;
  font-size: 20rpx;
  display: inline-block;
}
.image-empty {
  background: #F1ECEE;
}
.legal-link {
  color: #1D6342;
  text-decoration: underline;
}
