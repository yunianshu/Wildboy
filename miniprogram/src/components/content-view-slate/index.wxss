.rich-text{display:block;white-space:pre-wrap;font-size:14px;line-height:1.85;margin:12px 0;overflow-wrap:anywhere;word-break:normal}.rich-image{margin:16px 0}.rich-image image{width:100%;border-radius:8px;background:var(--rf-soft)}.rich-image text{display:block;text-align:center;color:var(--rf-muted);font-size:12px;line-height:1.6;margin-top:8px}.rich-table-scroll{width:100%;margin:24rpx 0}.rich-table{display:table;min-width:100%}.rich-row{display:table-row}.rich-row:nth-child(odd){background:var(--rf-bg)}.rich-cell{display:table-cell;padding:16rpx;min-width:140rpx;max-width:360rpx;font-size:26rpx;white-space:pre-wrap}
