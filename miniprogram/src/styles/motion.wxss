/* Keep native routing and fixed-position controls under the host's control. */
.page-motion {
  opacity: 1;
}

.page-motion.motion-enter-a,
.page-motion.motion-enter-b {
  animation-duration: 170ms;
  animation-timing-function: var(--motion-ease, cubic-bezier(0.16, 1, 0.3, 1));
  animation-iteration-count: 1;
  animation-fill-mode: none;
}

.page-motion.motion-enter-a {
  animation-name: wildboy-page-enter-a;
}

.page-motion.motion-enter-b {
  animation-name: wildboy-page-enter-b;
}

@keyframes wildboy-page-enter-a {
  from { opacity: .92; }
  to { opacity: 1; }
}

@keyframes wildboy-page-enter-b {
  from { opacity: .92; }
  to { opacity: 1; }
}

/* Clip the moving content while the native bottom bar stays in place. */
.tab-page-viewport {
  min-height: 100vh;
  overflow-x: hidden;
  overflow-x: clip;
}

.motion-tab-from-left { --tab-enter-offset: -24vw; }
.motion-tab-from-right { --tab-enter-offset: 24vw; }

.page-motion.motion-tab-a,
.page-motion.motion-tab-b {
  animation-duration: 240ms;
  animation-timing-function: var(--motion-ease, cubic-bezier(0.16, 1, 0.3, 1));
}

.page-motion.motion-tab-a { animation-name: wildboy-tab-enter-a; }
.page-motion.motion-tab-b { animation-name: wildboy-tab-enter-b; }

@keyframes wildboy-tab-enter-a {
  from { transform: translateX(var(--tab-enter-offset)); }
  to { transform: none; }
}

@keyframes wildboy-tab-enter-b {
  from { transform: translateX(var(--tab-enter-offset)); }
  to { transform: none; }
}

/* Dialog panels get a bounded arrival; the page root never scales. */
.motion-dialog-enter {
  opacity: 1;
  animation: wildboy-dialog-enter 180ms var(--motion-spring, cubic-bezier(.22, .9, .25, 1.1));
}

@keyframes wildboy-dialog-enter {
  from { opacity: .92; transform: scale(.98); }
  to { opacity: 1; transform: scale(1); }
}

/* WebView hosts can expose the system preference here. The official wx
   system/MediaQueryObserver APIs do not expose a Reduce Motion JS flag. */
@media (prefers-reduced-motion: reduce) {
  .page-motion.motion-enter-a,
  .page-motion.motion-enter-b,
  .page-motion.motion-tab-a,
  .page-motion.motion-tab-b,
  .motion-dialog-enter {
    animation: none !important;
  }
}
