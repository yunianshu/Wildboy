.category-search-row { position: relative; display: flex; align-items: center; min-height: 44px; overflow: hidden; }
.category-search-row .category-search-tabs { flex: 1; min-width: 0; width: 0; }
.category-search-row .category-search-covered,
.category-search-expanded .category-search-toggle { visibility: hidden; pointer-events: none; }
.category-search-row button.category-search-toggle,
.category-search-row .category-search-layer button {
  display: flex; align-items: center; justify-content: center; flex: none;
  box-sizing: border-box; width: auto; min-width: 44px; height: 44px;
  margin: 0; padding: 0 8px; background: transparent; color: var(--rf-primary-text);
  font-size: 13px; line-height: 1.2;
}
.category-search-row button.category-search-active { background: var(--rf-soft); }
.category-search-icon { position: relative; width: 14px; height: 14px; margin: 0 3px 3px 0; border: 2px solid currentColor; border-radius: 50%; }
.category-search-icon::after { content: ""; position: absolute; right: -5px; bottom: -3px; width: 7px; height: 2px; border-radius: 2px; background: currentColor; transform: rotate(45deg); }
.category-search-layer {
  position: absolute; inset: 0; z-index: 2; box-sizing: border-box;
  display: flex; align-items: center; gap: 8px;
  animation: category-search-reveal 220ms cubic-bezier(.22,.68,.28,1) both;
}
.category-search-field {
  display: flex; flex: 1 1 0; align-items: center; min-width: 0; height: 44px;
  box-sizing: border-box; padding-left: 12px; gap: 8px;
  border: 1px solid var(--rf-field-line); border-radius: var(--rf-control-radius);
  background: var(--rf-surface);
}
.category-search-field-icon { flex: 0 0 11px; width: 11px; height: 11px; color: var(--rf-muted); }
.category-search-field .category-search-input {
  box-sizing: border-box; flex: 1 1 0; width: 0; min-width: 0; height: 42px;
  margin: 0; padding: 0 5px 0 0; border: 0; border-radius: 0;
  background: transparent; color: var(--rf-ink); font-size: 14px;
}
.category-search-row .category-search-layer .category-search-clear { padding: 0; }
.category-search-row .category-search-layer .category-search-cancel { padding: 0 3px; color: var(--rf-muted); }
.category-search-row button.button-hover { background: var(--rf-soft); }
.section-tab-panel-search { margin-top: 12px; border-top: 0; border-radius: 10px; }
@keyframes category-search-reveal {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}
@media (prefers-reduced-motion: reduce) { .category-search-layer { animation: none; } }
