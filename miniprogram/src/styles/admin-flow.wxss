.na-page {
  --color-surface: #ffffff;
  --color-text: #203e34;
  --color-primary: #193f34;
  --color-on-primary: #fffdf4;
  --color-muted: #596a60;
  --color-border: #dde4db;
  --color-secondary: #e8eedf;
  --color-danger: #923b31;
  --color-error: #923b31;
  padding: 12px 16px 24px;
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 14px;
  line-height: 1.5;
}
.na-page.na-with-footer { padding-bottom: calc(112px + env(safe-area-inset-bottom)); }
.na-page .na-stack { display: flex; flex-direction: column; gap: 16px; }
.na-page .na-heading { margin: 0; font-size: 24px; font-weight: 700; line-height: 1.4; }
.na-page .na-subheading { margin: 0; font-size: 18px; font-weight: 600; line-height: 1.5; }
.na-page .na-muted { color: var(--color-muted); font-size: 12px; line-height: 1.5; }
.na-page .na-copy { font-size: 14px; line-height: 1.6; }
.na-page .na-row { display: flex; gap: 12px; align-items: center; min-width: 0; }
.na-page .na-grow { flex: 1; min-width: 0; }
.na-page .na-record { display: flex; flex-direction: column; gap: 12px; padding: 16px; background: #fff; border-radius: 12px; }
.na-page .na-record-title { font-size: 15px; font-weight: 600; line-height: 1.5; word-break: break-all; }
.na-page .na-thumb { flex: 0 0 56px; width: 56px; height: 56px; border-radius: 8px; background: var(--color-secondary); }
.na-page .na-preview { display: block; width: 100%; height: 132px; border-radius: 12px; background: var(--color-secondary); }
.na-page .na-badge { flex: 0 0 auto; padding: 4px 8px; border-radius: 6px; background: var(--color-secondary); color: var(--color-primary); font-size: 12px; font-weight: 500; }
.na-page .na-tabs { display: flex; gap: 8px; min-width: 0; }
.na-page .na-tabs button.ui-button { flex: 1; min-width: 0; width: auto; min-height: 38px; padding: 6px 4px; margin: 0; border-radius: 8px; font-size: 13px; }
.na-page .na-tabs .na-active { background: var(--color-primary); color: #fff; }
.na-page .na-tabs.na-scroll-tabs { flex-wrap: wrap; }
.na-page .na-scroll-tabs button.ui-button { flex: 1 0 auto; }
.na-page .na-actions { display: flex; gap: 8px; align-items: stretch; }
.na-page .na-actions > button.ui-button { flex: 1; width: 0; min-width: 0; margin: 0; padding: 8px 6px; }
.na-page button.ui-button { display: flex; align-items: center; justify-content: center; text-align: center; min-height: 40px; padding: 8px 12px; border-radius: 10px; font-size: 14px; line-height: 20px; }
.na-page button.primary.ui-button { min-height: 44px; }
.na-page .na-note { display: flex; gap: 8px; align-items: flex-start; padding: 12px; border-radius: 12px; background: var(--color-secondary); color: var(--color-muted); font-size: 12px; line-height: 1.5; }
.na-page .na-note .ui-icon { flex: 0 0 18px; width: 18px; height: 18px; }
.na-page .na-error { color: var(--color-danger); }
.na-page .na-field { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.na-page .na-field > text, .na-page .na-label { color: var(--color-muted); font-size: 12px; font-weight: 500; }
.na-page .na-field input, .na-page .na-field textarea, .na-page .na-picker {
  box-sizing: border-box; width: 100%; padding: 12px 16px; margin: 0; border: 1px solid var(--color-border); border-radius: 12px; background: #fff; color: var(--color-text); font-family: inherit; font-size: 14px; line-height: 22px;
}
.na-page .na-field input, .na-page .na-picker { height: 48px; min-height: 48px; }
.na-page .na-field input { padding: 0 16px; }
.na-page .na-field textarea { height: 140px; min-height: 96px; }
.na-page .na-field .na-tall-input { height: 180px; }
.na-page .na-picker { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.na-page .na-picker .ui-icon { flex: 0 0 20px; width: 20px; height: 20px; }
.na-page .na-date-row { display: flex; gap: 8px; }
.na-page .na-date-row picker:first-child { flex: 1.4; min-width: 0; }
.na-page .na-date-row picker:last-child { flex: 1; min-width: 0; }
.na-page .na-pair { display: flex; gap: 12px; align-items: flex-start; }
.na-page .na-pair > .na-field { flex: 1; min-width: 0; }
.na-page .na-presets { white-space: nowrap; width: 100%; }
.na-page .na-preset { display: inline-block; box-sizing: border-box; width: 64px; height: 48px; margin-right: 8px; border: 2px solid transparent; border-radius: 8px; }
.na-page .na-preset.na-selected { border-color: var(--color-primary); }
.na-page .na-switch-row { display: flex; gap: 8px; align-items: center; justify-content: space-between; min-height: 44px; }
.na-page .na-switch-row switch { flex: 0 0 auto; }
.na-page .na-footer { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; display: flex; gap: 12px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); border-top: 1px solid var(--color-border); background: #fff; }
.na-page .na-footer > button.ui-button { flex: 1; width: 0; margin: 0; padding-left: 8px; padding-right: 8px; }
.na-page .na-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(15,35,27,.48); }
.na-page .na-dialog { box-sizing: border-box; display: flex; flex-direction: column; gap: 16px; width: 100%; max-height: 88vh; overflow-y: auto; max-width: 420px; padding: 20px; border-radius: 12px; background: var(--color-page); }
.na-page .na-editor-dialog { max-width: 520px; }
.na-page .na-editor-dialog .na-footer { position: static; padding: 0; border: 0; background: transparent; }
.na-page .na-editor-dialog .na-footer > button.ui-button { width: 0; }
.na-page .na-danger-solid { background: var(--color-danger); color: #fff; }
.na-page .na-money { font-size: 22px; font-weight: 700; color: var(--color-primary); }
.na-page .na-divider { border-bottom: 1px solid var(--color-border); padding-bottom: 12px; }
.na-page .na-plain { display: block; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; font-size: 14px; line-height: 1.7; }
.na-page .na-block-image { display: block; width: 100%; border-radius: 8px; }
.na-page .na-tools { display: flex; gap: 6px; }
.na-page .na-tools > button.ui-button { flex: 1; min-width: 0; width: 0; padding: 8px 4px; margin: 0; }
.na-page .na-state-title { font-size: 22px; font-weight: 700; line-height: 1.5; }
.na-page .na-state { display: flex; flex-direction: column; gap: 16px; padding: 32px 16px; }
.na-page .na-state-icon { align-self: center; width: 40px; height: 40px; }
.na-page .na-history { display: flex; flex-direction: column; gap: 12px; }
