@import "../../styles/slate-theme.wxss";
.article-cover {
  width: 100%;
  border-radius: 12px;
  margin-bottom: 16px;
  background: var(--rf-soft);
}
.article-page .title { margin: 0 0 8px; }
.article-page .primary { margin-top: 20px; }
.article-page .secondary { margin-top: 12px; }
.article-summary {
  color: var(--rf-muted);
  line-height: 1.8;
  margin: 20rpx 0 36rpx;
  white-space: pre-wrap;
}

