<view class="page page-motion {{pageMotionClass}}">
  <ui-state wx:if="{{loading}}" kind="loading">正在读取文章…</ui-state>
  <ui-state wx:elif="{{error}}" kind="error">{{error}}<button class="secondary ui-button ui-button-block" bindtap="retry">重试</button></ui-state>
  <ui-state wx:elif="{{empty}}" kind="empty">{{empty}}<button class="secondary ui-button ui-button-block" bindtap="retry">刷新</button></ui-state>
  <block wx:elif="{{article}}">
    <image wx:if="{{article.coverUrl}}" class="article-cover" src="{{article.coverUrl}}" mode="widthFix" />
    <view class="title">{{article.title}}</view>
    <view wx:if="{{article.summary}}" class="article-summary">{{article.summary}}</view>
    <markdown-view nodes="{{article.contentNodes}}" />
  </block>
</view>
