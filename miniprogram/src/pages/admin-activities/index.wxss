.create {
  margin: 32rpx 0;
}
.tabs {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0 32rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 4rpx;
  background: #e8ecdf;
  border-radius: 40rpx;
  font-size: 24rpx;
}
.active {
  background: #193f34;
  color: white;
}
.activity {
  background: #fffdf7;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 26rpx;
}
.activity-top {
  display: flex;
  gap: 22rpx;
  margin-bottom: 20rpx;
}
.activity-top image {
  width: 160rpx;
  height: 170rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}
.activity-copy {
  flex: 1;
  min-width: 0;
}
.activity-title {
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.5;
  margin-bottom: 12rpx;
  word-break: break-all;
}
.activity-copy .muted {
  margin-top: 10rpx;
}
.actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.actions button {
  margin: 0;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}
.danger {
  background: #f3e8df;
  color: #a05037;
}
