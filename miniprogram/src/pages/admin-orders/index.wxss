.page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.section-title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 20rpx 0;
}
.muted {
  color: #777;
  font-size: 24rpx;
  margin: 12rpx 0;
}
.actions {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}
.actions button {
  flex: 1;
}
.card {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 20rpx 0;
}
.card image {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.main {
  flex: 1;
  min-width: 0;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.form label {
  display: block;
  margin: 24rpx 0;
}
.form input,
.form textarea,
.picker {
  box-sizing: border-box;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
  width: 100%;
}
.form input {
  height: 84rpx;
}
.form textarea {
  height: 260rpx;
}
.presets {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.presets image {
  width: 100rpx;
  height: 100rpx;
}
.form button {
  margin-top: 24rpx;
}
.error {
  color: #a33;
  white-space: pre-wrap;
  word-break: break-all;
}
.filters {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin: 24rpx 0;
}
.filters button {
  margin: 0;
}
.order {
  background: #fff;
  padding: 24rpx;
  border-radius: 18rpx;
  margin: 20rpx 0;
}
.number {
  font-size: 24rpx;
  word-break: break-all;
  color: #777;
}
.line {
  margin: 16rpx 0;
}
.address {
  margin: 18rpx 0;
  padding: 16rpx;
  background: #f6f4ed;
  word-break: break-all;
}
.order button {
  margin-top: 20rpx;
}
