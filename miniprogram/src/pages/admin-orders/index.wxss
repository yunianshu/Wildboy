@import "../../styles/slate-theme.wxss";
.page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.section-title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 20rpx 0;
}
.muted {
  color: var(--rf-muted);
  font-size: 24rpx;
  margin: 12rpx 0;
}
.actions {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}
.actions button {
  flex: 1;
}
.card {
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 20rpx 0;
}
.card image {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.main {
  flex: 1;
  min-width: 0;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.form label {
  display: block;
  margin: 24rpx 0;
}
.form input,
.form textarea,
.picker {
  box-sizing: border-box;
  background: #FFFFFF;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
  width: 100%;
}
.form input {
  height: 84rpx;
}
.form textarea {
  height: 260rpx;
}
.presets {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.presets image {
  width: 100rpx;
  height: 100rpx;
}
.form button {
  margin-top: 24rpx;
}
.error {
  color: var(--rf-danger);
  white-space: pre-wrap;
  word-break: break-all;
}
.filters {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin: 24rpx 0;
}
.filters button {
  width: 100%;
  min-width: 0;
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 8rpx;
  font-size: 25rpx;
}
.filters .active {
  background: var(--rf-primary);
  color: var(--rf-on-primary);
  font-weight: 600;
}
.order {
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 18rpx;
  margin: 20rpx 0;
}
.number {
  font-size: 24rpx;
  word-break: break-all;
  color: var(--rf-muted);
}
.line {
  margin: 16rpx 0;
  word-break: break-all;
}
.address {
  margin: 18rpx 0;
  padding: 16rpx;
  background: var(--rf-bg);
  word-break: break-all;
}
.order button {
  margin-top: 20rpx;
}
.order .reveal {
  display: inline-flex;
  width: auto;
  min-height: 72rpx;
  margin-left: 0;
  margin-right: 0;
  padding: 12rpx 20rpx;
  font-size: 25rpx;
}
.confirmation {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--rf-bg);
  line-height: 1.6;
  word-break: break-word;
}
.shipping-form label {
  margin: 16rpx 0 0;
}
.shipping-form input {
  margin-top: 8rpx;
}
.shipping-form .error {
  margin-top: 12rpx;
}
.confirm-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.confirm-actions button { flex: 1; width: 0; min-width: 0; margin: 0; padding-left: 12rpx; padding-right: 12rpx; }

@import "../../styles/slate-components.wxss";
