<view class="page page-motion {{pageMotionClass}}">
  <view wx:if="{{success}}" class="success">
    <view class="success-symbol"><image class="status-icon" src="/assets/icons-slate/check.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
    <view class="title">{{recoveredRegistration ? '已找到有效报名' : '山野见！'}}</view>
    <view class="muted">
      你已成功报名「{{activity.title}}」
      <view />
      出发时间 {{activity.dateText}}
    </view>
    <view wx:if="{{recoveredRegistration}}" class="booking-summary">
      <view class="notice">以下为系统保存的报名记录。本次填写的信息未覆盖原报名，请核对参与人。</view>
      <view class="participant-card" wx:for="{{recoveredRegistration.participants}}" wx:key="id">
        <view>{{index + 1}}. {{item.participantName}}</view><view class="muted">{{item.phone}}</view>
      </view>
    </view>
    <view class="notice">
      活动安排可能变化，出发前请再次核对。
    </view>
    <button class="primary" bindtap="done">查看活动安排</button>
    <button class="secondary" bindtap="myActivities">我的报名</button>
  </view>
  <block wx:else>
    <view class="title">活动报名</view>
    <ui-state wx:if="{{loading}}" kind="loading">正在确认活动…</ui-state>
    <ui-state wx:elif="{{error}}" kind="error">
      {{error}}
      <button class="secondary ui-button ui-button-block" bindtap="retry" disabled="{{submitting}}">重试</button>
    </ui-state>
    <block wx:elif="{{activity}}">
      <view class="booking-summary">
        <text class="badge">{{activity.priceCents > 0 ? '收费报名' : '免费报名 · 无需支付'}}</text>
        <view class="booking-title">{{activity.title}}</view>
        <view class="muted">{{activity.dateText}} · {{activity.location}}</view>
      </view>
      <view wx:if="{{activity.priceCents > 0}}" class="booking-summary">
        <view class="section-title">报名费用</view>
        <ui-state wx:if="{{quoteLoading}}" kind="loading" compact="{{true}}">正在确认费用…</ui-state>
        <view wx:elif="{{quote}}">
          <view>应付 {{quoteTotal}}<text wx:if="{{quote.originalTotalCents > quote.totalCents}}" class="muted"> · 优惠前 {{quoteOriginal}}</text></view>
          <view wx:for="{{quoteLines}}" wx:key="key">{{item.label}}</view>
          <view wx:if="{{quote.participantPricing}}" class="muted">{{quote.participantPricing === 'ACCOUNT_ALL' ? '同行按报名账号等级优惠' : '每单最多 1 个优惠名额'}}</view>
        </view>
        <view wx:elif="{{quoteLoginRequired}}">登录后确认报价<button class="secondary" bindtap="login">微信登录</button></view>
        <view wx:elif="{{quoteError}}" class="error">{{quoteError}}<button class="secondary" bindtap="refreshQuote" disabled="{{submitting}}">重新获取费用</button></view>
        <view class="muted">请以活动订单中的报名与支付状态为准。</view>
        <button class="text-button" bindtap="paidOrders" disabled="{{submitting}}">查看本活动订单</button>
      </view>
      <view class="section-head">
        <view class="section-title">参与人信息</view>
        <text class="muted">共 {{participants.length}} 人 · 剩余 {{activity.available}} 个名额</text>
      </view>
      <view
        class="participant-card"
        wx:for="{{participants}}"
        wx:key="index"
        wx:for-index="index"
      >
        <view class="participant-head">
          <text>参与人 {{index + 1}}</text>
          <button
            wx:if="{{participants.length > 1}}"
            class="text-button"
            data-index="{{index}}"
            bindtap="removeParticipant"
            disabled="{{submitting || recoveryNeeded}}"
          >删除</button>
        </view>
        <view class="field">
          <text class="label">姓名</text>
          <input
            value="{{item.participantName}}"
            maxlength="40"
            placeholder="请填写真实姓名"
            data-index="{{index}}"
            data-field="participantName"
            bindinput="inputParticipant"
            disabled="{{submitting || recoveryNeeded}}"
          />
        </view>
        <view wx:if="{{activity.identityRequired}}" class="field">
          <text class="label">身份证号（本活动身份核验需要）</text>
          <input
            value="{{item.idNumber}}"
            maxlength="18"
            placeholder="用于本次活动身份核验"
            data-index="{{index}}"
            data-field="idNumber"
            bindinput="inputParticipant"
            disabled="{{submitting || recoveryNeeded}}"
          />
        </view>
        <view class="field">
          <text class="label">手机号</text>
          <input
            value="{{item.phone}}"
            type="number"
            maxlength="11"
            placeholder="用于活动联系"
            data-index="{{index}}"
            data-field="phone"
            bindinput="inputParticipant"
            disabled="{{submitting || recoveryNeeded}}"
          />
        </view>
      </view>
      <button
        class="secondary add-participant"
        bindtap="addParticipant"
        disabled="{{submitting || recoveryNeeded || participants.length >= activity.available}}"
      >新增报名人</button>
      <checkbox-group bindchange="consentChange">
        <view class="consent">
          <checkbox
            value="yes"
            checked="{{consent}}"
            color="#9E2845"
            aria-label="同意当前协议及参与人信息使用"
            disabled="{{submitting || recoveryNeeded}}"
          />
          <view>我已阅读并同意当前版本<text class="legal-link" catchtap="privacy" aria-role="link" aria-label="隐私政策，版本 {{legal.privacy.version}}">《隐私政策》</text><text class="legal-link" catchtap="terms" aria-role="link" aria-label="用户协议，版本 {{legal.terms.version}}">《用户协议》</text>，同意将所有参与人的姓名、{{activity.identityRequired ? "身份证号和" : ""}}手机号用于本次活动身份核验、组织与联系。</view>
        </view>
      </checkbox-group>
      <view wx:if="{{legalError}}" class="error">
        {{legalError}}
        <button class="secondary" bindtap="retry" disabled="{{submitting}}">重新读取协议</button>
      </view>
      <view class="notice">
        每个账号每场活动限一笔有效报名，可添加多位参与人。
      </view>
      <view wx:if="{{fieldError}}" class="error form-error">
        {{fieldError}}
      </view>
      <button
        class="primary submit"
        loading="{{submitting}}"
        disabled="{{submitting || (!recoveryNeeded && (!activity.enabled || !legal || (activity.priceCents > 0 && (!quote || quoteLoading))))}}"
        bindtap="submit"
      >
        {{submitting ? '正在确认…' : (recoveryNeeded ? '核对报名结果' : (activity.priceCents > 0 && quote ? (quote.totalCents === 0 ? '确认免支付报名' : '确认费用并创建订单') : activity.label))}}
      </button>
      <view class="muted small center">
        {{activity.priceCents > 0 ? '报名结果请以“活动订单”为准。' : '报名结果请以“我的报名”为准。'}}
      </view>
    </block>
  </block>
</view>

<ui-dialog wx:if="{{participantModalOpen}}" title="新增报名人" bindclose="cancelParticipant">

    <scroll-view scroll-y class="dialog-body {{activity.identityRequired ? 'dialog-body-identity' : ''}}">
      <view class="field">
        <text class="label">姓名</text>
        <input value="{{participantDraft.participantName}}" maxlength="40" placeholder="请填写真实姓名" data-field="participantName" bindinput="inputParticipantDraft" />
      </view>
      <view wx:if="{{activity.identityRequired}}" class="field">
        <text class="label">身份证号</text>
        <input value="{{participantDraft.idNumber}}" maxlength="18" placeholder="用于本次活动身份核验" data-field="idNumber" bindinput="inputParticipantDraft" />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input value="{{participantDraft.phone}}" type="number" maxlength="11" placeholder="用于活动联系" data-field="phone" bindinput="inputParticipantDraft" confirm-type="done" bindconfirm="confirmParticipant" />
      </view>
      <view wx:if="{{participantError}}" class="error dialog-error">{{participantError}}</view>
    </scroll-view>

  <view slot="footer" class="dialog-actions">
      <button class="secondary" bindtap="cancelParticipant">取消</button>
      <button class="primary" bindtap="confirmParticipant">确认添加</button>
    </view>
</ui-dialog>
