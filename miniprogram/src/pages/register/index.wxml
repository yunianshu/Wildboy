<view class="page">
  <view wx:if="{{success}}" class="success">
    <view class="success-symbol">✓</view>
    <text class="eyebrow">SEE YOU OUTSIDE</text>
    <view class="title">山野见！</view>
    <view class="muted">
      你已成功报名「{{activity.title}}」
      <view />
      出发时间 {{activity.dateText}}
    </view>
    <view class="notice">
      活动安排可能变化，出发前请再次核对。
    </view>
    <button class="primary" bindtap="done">查看活动安排</button>
    <button class="secondary" bindtap="myActivities">我的报名</button>
  </view>
  <block wx:else>
    <view class="title">活动报名</view>
    <view wx:if="{{loading}}" class="state">正在确认活动…</view>
    <view wx:elif="{{error}}" class="state error">
      {{error}}
      <button class="secondary" bindtap="retry">重试</button>
    </view>
    <block wx:elif="{{activity}}">
      <view class="booking-summary">
        <text class="badge">免费报名 · 无需支付</text>
        <view class="booking-title">{{activity.title}}</view>
        <view class="muted">{{activity.dateText}} · {{activity.location}}</view>
      </view>
      <view class="section-head">
        <view class="section-title">参与人信息</view>
        <text class="muted">共 {{participants.length}} 人 · 剩余 {{activity.available}} 个名额</text>
      </view>
      <view
        class="participant-card"
        wx:for="{{participants}}"
        wx:key="index"
        wx:for-index="index"
      >
        <view class="participant-head">
          <text>参与人 {{index + 1}}</text>
          <button
            wx:if="{{participants.length > 1}}"
            class="text-button"
            data-index="{{index}}"
            bindtap="removeParticipant"
            disabled="{{submitting}}"
          >删除</button>
        </view>
        <view class="field">
          <text class="label">姓名</text>
          <input
            value="{{item.participantName}}"
            maxlength="40"
            placeholder="请填写真实姓名"
            data-index="{{index}}"
            data-field="participantName"
            bindinput="inputParticipant"
            disabled="{{submitting}}"
          />
        </view>
        <view wx:if="{{activity.identityRequired}}" class="field">
          <text class="label">身份证号（本活动身份核验需要）</text>
          <input
            value="{{item.idNumber}}"
            maxlength="18"
            placeholder="用于本次活动身份核验"
            data-index="{{index}}"
            data-field="idNumber"
            bindinput="inputParticipant"
            disabled="{{submitting}}"
          />
        </view>
        <view class="field">
          <text class="label">手机号</text>
          <input
            value="{{item.phone}}"
            type="number"
            maxlength="11"
            placeholder="用于活动联系"
            data-index="{{index}}"
            data-field="phone"
            bindinput="inputParticipant"
            disabled="{{submitting}}"
          />
        </view>
      </view>
      <button
        class="secondary add-participant"
        bindtap="addParticipant"
        disabled="{{submitting || participants.length >= activity.available}}"
      >＋ 新增报名人</button>
      <checkbox-group bindchange="consentChange">
        <view class="consent">
          <checkbox
            value="yes"
            checked="{{consent}}"
            color="#193F34"
            aria-label="同意当前协议及参与人信息使用"
            disabled="{{submitting}}"
          />
          <view>我已阅读并同意当前版本<text class="legal-link" catchtap="privacy" aria-role="link" aria-label="隐私政策，版本 {{legal.privacy.version}}">《隐私政策》</text><text class="legal-link" catchtap="terms" aria-role="link" aria-label="用户协议，版本 {{legal.terms.version}}">《用户协议》</text>，同意将所有参与人的姓名、{{activity.identityRequired ? "身份证号和" : ""}}手机号用于本次活动身份核验、组织与联系。</view>
        </view>
      </checkbox-group>
      <view wx:if="{{legalError}}" class="error">
        {{legalError}}
        <button class="secondary" bindtap="retry">重新读取协议</button>
      </view>
      <view class="notice">
        每个账号每场活动限一笔有效报名，可添加多位参与人。
      </view>
      <view wx:if="{{fieldError}}" class="error form-error">
        {{fieldError}}
      </view>
      <button
        class="primary submit"
        loading="{{submitting}}"
        disabled="{{submitting || !activity.enabled || !legal}}"
        bindtap="submit"
      >
        {{submitting ? '正在确认名额…' : activity.label}}
      </button>
      <view class="muted small center">
        报名结果请以“我的报名”为准。
      </view>
    </block>
  </block>
</view>

<view wx:if="{{participantModalOpen}}" class="participant-overlay" catchtap="cancelParticipant" catchtouchmove="stopModalEvent">
  <view class="participant-dialog" catchtap="stopModalEvent" role="dialog" aria-modal="true" aria-label="新增报名人">
    <view class="dialog-head">
      <view class="section-title">新增报名人</view>
      <button class="dialog-close" bindtap="cancelParticipant" aria-label="关闭新增报名人">×</button>
    </view>
    <scroll-view scroll-y class="dialog-body">
      <view class="field">
        <text class="label">姓名</text>
        <input value="{{participantDraft.participantName}}" maxlength="40" placeholder="请填写真实姓名" data-field="participantName" bindinput="inputParticipantDraft" />
      </view>
      <view wx:if="{{activity.identityRequired}}" class="field">
        <text class="label">身份证号</text>
        <input value="{{participantDraft.idNumber}}" maxlength="18" placeholder="用于本次活动身份核验" data-field="idNumber" bindinput="inputParticipantDraft" />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input value="{{participantDraft.phone}}" type="number" maxlength="11" placeholder="用于活动联系" data-field="phone" bindinput="inputParticipantDraft" confirm-type="done" bindconfirm="confirmParticipant" />
      </view>
      <view wx:if="{{participantError}}" class="error dialog-error">{{participantError}}</view>
    </scroll-view>
    <view class="dialog-actions">
      <button class="secondary" bindtap="cancelParticipant">取消</button>
      <button class="primary" bindtap="confirmParticipant">确认添加</button>
    </view>
  </view>
</view>
