@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.booking-summary {
  padding: 28rpx;
  background: var(--rf-soft);
  border-radius: 12rpx;
  margin: 32rpx 0;
}
.booking-title {
  font-size: 34rpx;
  font-weight: 650;
  margin: 18rpx 0 10rpx;
}
.consent {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--rf-muted);
}
.submit {
  margin: 24rpx 0 12rpx;
}
.form-error {
  padding-top: 24rpx;
  font-size: 25rpx;
}
.boarding-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
  min-height: 48px;
  padding: 8px 12px;
  border: 1px solid var(--rf-field-line);
  border-radius: var(--rf-control-radius);
  background: var(--rf-surface);
  font-size: 14px;
  text-align: left;
  overflow-wrap: anywhere;
}
.boarding-picker-chevron {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-right: 4rpx;
  border-right: 2rpx solid var(--rf-muted);
  border-bottom: 2rpx solid var(--rf-muted);
  transform: rotate(45deg);
}
.participant-card {
  padding: 24rpx 0;
}
.participant-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-weight: 650;
}
.participant-head .text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 10rpx 16rpx;
  line-height: 1.4;
  text-align: center;
  color: var(--rf-danger);
  font-size: 26rpx;
}
.add-participant {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  max-width: 220rpx;
  min-width: 0;
  min-height: 72rpx;
  padding: 10rpx 20rpx;
  line-height: 1.4;
  text-align: center;
  margin: 8rpx 0 20rpx;
}
.center {
  text-align: center;
}
.success {
  text-align: center;
  padding-top: 60rpx;
}
.success-symbol {
  font-size: 70rpx;
  background: var(--rf-line);
  width: 150rpx;
  height: 150rpx;
  line-height: 150rpx;
  border-radius: 50%;
  margin: 0 auto 40rpx;
}
.success .notice {
  margin: 40rpx 0;
}
.success button {
  width: 100%;
  margin-top: 12px;
}

.participant-layer {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.participant-mask { position: absolute; inset: 0; background: rgba(0, 0, 0, .3); }
.participant-sheet {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 560px;
  border-radius: 20px 20px 0 0;
  background: var(--rf-surface, #fff);
  padding-bottom: env(safe-area-inset-bottom);
}
.participant-sheet-title { padding: 18px 16px 10px; font-size: 17px; font-weight: 650; }
.participant-sheet-scroll { display: block; max-height: 65vh; }
.participant-sheet-body { padding: 0 16px 16px; }
.participant-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.participant-actions button { flex: 1; margin: 0; }

.status-icon { width: 56rpx; height: 56rpx; }
.success-symbol { display: flex; align-items: center; justify-content: center; }

@import "../../styles/slate-components.wxss";
