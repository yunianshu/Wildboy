@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.booking-summary {
  padding: 28rpx;
  background: var(--rf-soft);
  border-radius: 12rpx;
  margin: 32rpx 0;
}
.booking-title {
  font-size: 34rpx;
  font-weight: 650;
  margin: 18rpx 0 10rpx;
}
.consent {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--rf-muted);
}
.consent checkbox {
  transform: scale(0.8);
  transform-origin: left top;
  flex-shrink: 0;
  width: 55rpx;
}
.submit {
  margin: 24rpx 0 12rpx;
}
.form-error {
  padding-top: 24rpx;
  font-size: 25rpx;
}
.participant-card {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--rf-line);
}
.participant-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-weight: 650;
}
.participant-head .text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 10rpx 16rpx;
  line-height: 1.4;
  text-align: center;
  color: var(--rf-danger);
  font-size: 26rpx;
}
.add-participant {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  max-width: 220rpx;
  min-width: 0;
  min-height: 72rpx;
  padding: 10rpx 20rpx;
  line-height: 1.4;
  text-align: center;
  margin: 8rpx 0 20rpx;
}
.center {
  text-align: center;
}
.success {
  text-align: center;
  padding-top: 60rpx;
}
.success-symbol {
  font-size: 70rpx;
  background: var(--rf-line);
  width: 150rpx;
  height: 150rpx;
  line-height: 150rpx;
  border-radius: 50%;
  margin: 0 auto 40rpx;
}
.success .notice {
  margin: 40rpx 0;
}
.success button {
  margin-top: 24rpx;
}

.participant-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(17, 31, 22, 0.48);
}
.participant-dialog {
  width: 100%;
  max-width: 620rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  padding: 28rpx;
  box-shadow: 0 24rpx 80rpx rgba(17, 31, 22, 0.18);
}
.dialog-head, .dialog-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.dialog-close {
  margin: 0;
  padding: 0;
  width: 72rpx;
  height: 72rpx;
  line-height: 1;
  background: transparent;
  color: var(--rf-muted);
  font-size: 44rpx;
}
.dialog-close::after { border: 0; }
.dialog-body { max-height: 52vh; }
.dialog-actions { margin-top: 12rpx; }
.dialog-actions button { flex: 1; margin: 0; }
.dialog-error { padding: 12rpx 0; font-size: 25rpx; }

.status-icon { width: 56rpx; height: 56rpx; }
.dialog-close-icon { width: 30rpx; height: 30rpx; }
.success-symbol { display: flex; align-items: center; justify-content: center; }

@import "../../styles/slate-components.wxss";
