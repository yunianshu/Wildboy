.booking-summary {
  padding: 28rpx;
  background: #e9eddf;
  border-radius: 12rpx;
  margin: 32rpx 0;
}
.booking-title {
  font-size: 34rpx;
  font-weight: 650;
  margin: 18rpx 0 10rpx;
}
.consent {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  line-height: 1.8;
  color: #6a7561;
}
.consent checkbox {
  transform: scale(0.8);
  transform-origin: left top;
  flex-shrink: 0;
  width: 55rpx;
}
.submit {
  margin: 32rpx 0 20rpx;
}
.form-error {
  padding-top: 24rpx;
  font-size: 25rpx;
}
.participant-card {
  padding: 24rpx 0;
  border-top: 1rpx solid #d9dfd2;
}
.participant-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-weight: 650;
}
.participant-head .text-button {
  color: #8a4b31;
  font-size: 26rpx;
}
.add-participant {
  width: 100%;
  margin: 12rpx 0 28rpx;
}
.center {
  text-align: center;
}
.success {
  text-align: center;
  padding-top: 60rpx;
}
.success-symbol {
  font-size: 70rpx;
  background: #dde8c8;
  width: 150rpx;
  height: 150rpx;
  line-height: 150rpx;
  border-radius: 50%;
  margin: 0 auto 40rpx;
}
.success .notice {
  margin: 40rpx 0;
}
.success button {
  margin-top: 24rpx;
}

.participant-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(17, 31, 22, 0.48);
}
.participant-dialog {
  width: 100%;
  max-width: 620rpx;
  border-radius: 24rpx;
  background: #fafaf6;
  padding: 28rpx;
  box-shadow: 0 24rpx 80rpx rgba(17, 31, 22, 0.18);
}
.dialog-head, .dialog-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.dialog-close {
  margin: 0;
  padding: 0;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: transparent;
  color: #6a7561;
  font-size: 44rpx;
}
.dialog-close::after { border: 0; }
.dialog-body { max-height: 52vh; }
.dialog-actions { margin-top: 24rpx; }
.dialog-actions button { flex: 1; margin: 0; }
.dialog-error { padding: 12rpx 0; font-size: 25rpx; }
