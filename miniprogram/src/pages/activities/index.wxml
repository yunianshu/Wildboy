<view class="tab-page-viewport"
  bindtouchstart="startTabSwipe" bindtouchmove="moveTabSwipe"
  bindtouchend="endTabSwipe" bindtouchcancel="cancelTabSwipe">
  <view class="activities-page page-motion {{pageMotionClass}}">
    <view class="slate-tab-header uf-custom-header" style="padding-top:{{headerLayout.top}}px">
      <view class="uf-capsule-row" style="height:{{headerLayout.height}}px;padding-right:{{headerLayout.rightInset}}px"><view class="uf-title">活动</view></view>
    </view>
    <view class="page slate-tab-content activities-content">
      <view class="category-search-row {{searchOpen ? 'category-search-expanded' : ''}}" mark:tabSwipeIgnore="{{true}}">
      <scroll-view scroll-x class="section-tabs activity-category-tabs category-search-tabs {{searchOpen ? 'category-search-covered' : ''}}" aria-hidden="{{searchOpen}}" enhanced show-scrollbar="{{false}}" scroll-left="{{filterScrollLeft}}" id="activity-filters-viewport" mark:tabSwipeIgnore="{{true}}" bindtouchstart="onFilterTouchStart">
        <view class="section-tab-list" id="activity-filters-track">
          <button class="section-tab {{selected === '' ? 'section-tab-current' : ''}}" data-code="" id="activity-category-all" bindtap="select" hover-class="section-tab-pressed" aria-label="全部活动{{selected === '' ? '，已选中' : ''}}">全部活动</button>
          <button wx:for="{{categories}}" wx:key="code" class="section-tab {{selected === item.code ? 'section-tab-current' : ''}}" data-code="{{item.code}}" id="activity-category-{{item.code}}" bindtap="select" hover-class="section-tab-pressed" aria-label="{{item.name}}{{selected === item.code ? '，已选中' : ''}}">{{item.name}}</button>
        </view>
      </scroll-view>
      <button class="category-search-toggle {{searchTitle ? 'category-search-active' : ''}}" bindtap="openSearch" aria-hidden="{{searchOpen}}" aria-label="{{searchTitle ? '搜索已筛选，点击编辑' : '搜索活动'}}"><view class="category-search-icon" aria-hidden="{{true}}" /></button>
      <view wx:if="{{searchOpen}}" class="category-search-layer">
        <view class="category-search-field">
          <view class="category-search-icon category-search-field-icon" aria-hidden="{{true}}" />
          <input class="category-search-input" type="text" confirm-type="search" maxlength="100" value="{{searchInput}}" focus="{{searchOpen}}" placeholder="搜索全部活动" aria-label="活动名称" bindinput="updateSearchInput" bindconfirm="search" />
          <button wx:if="{{searchInput || searchTitle}}" class="category-search-clear" aria-label="清除搜索" bindtap="clearSearch"><icon type="clear" size="16" color="#5D7064" /></button>
        </view>
        <button class="category-search-cancel" bindtap="closeSearch" aria-label="收起搜索">收起</button>
      </view>
      </view>
      <view class="section-tab-panel {{searchOpen ? 'section-tab-panel-search' : ''}}">
        <ui-state wx:if="{{loading}}" kind="loading">正在加载活动…</ui-state>
        <ui-state wx:elif="{{!items.length && !error}}" kind="empty">
          {{searchTitle ? '没有找到“' + searchTitle + '”相关的活动' : (selected ? '该分类暂无活动' : '暂无活动')}}
          <button wx:if="{{searchTitle}}" class="secondary ui-button" bindtap="clearSearch">清除搜索</button>
        </ui-state>
        <view class="grid">
          <view class="activity-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openActivity" aria-role="button" hover-class="activity-card-pressed">
            <image class="activity-image" src="{{item.coverUrl}}" mode="aspectFill" aria-hidden="{{true}}" lazy-load />
            <view class="card-title">{{item.title}}</view>
            <view class="card-meta">{{item.categoryName}} · {{item.dateText}} 出发</view>
            <view class="card-detail">{{item.location}}</view>
            <view class="card-footer">
              <text class="free">{{item.priceLabel}}</text>
              <text class="card-availability">{{item.enabled ? '余 ' + item.available + ' 位' : item.label}}</text>
            </view>
          </view>
        </view>
        <ui-state wx:if="{{error}}" kind="error">{{error}}<button class="secondary ui-button ui-button-block" bindtap="retry">重试</button></ui-state>
        <ui-state wx:if="{{loadingMore}}" kind="loading" compact="{{true}}">正在加载…</ui-state>
        <view wx:elif="{{items.length && !error}}" class="loading-line">{{hasMore ? '上拉加载更多' : '已显示全部活动'}}</view>
      </view>
    </view>
  </view>
</view>
