@import "../../styles/slate-theme.wxss";
@import "../../styles/section-tabs.wxss";
@import "../../styles/user-flow.wxss";
@import "../../styles/slate-components.wxss";
@import "../../styles/category-search.wxss";

.activity-card-pressed { background: var(--rf-soft); }
.activities-content .grid { display: flex; flex-direction: column; gap: 0; }
.activity-card {
  display: grid;
  grid-template-columns: 92px minmax(0, 1fr);
  gap: 4px 12px;
  padding: 14px 0;
}
.activity-card + .activity-card { border-top: 1px solid var(--rf-line); }
.activity-image { grid-column: 1; grid-row: 1 / 5; width: 92px; height: 102px; border-radius: 8px; background: var(--rf-soft); }
.card-title { grid-column: 2; color: var(--rf-ink); font-size: 16px; line-height: 1.45; font-weight: 600; overflow-wrap: anywhere; }
.card-meta, .card-detail { grid-column: 2; margin: 0; font-size: 12px; line-height: 1.5; letter-spacing: 0; color: var(--rf-muted); }
.card-detail { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.card-footer { grid-column: 2; margin: 2px 0 0; align-items: center; gap: 4px 8px; flex-wrap: wrap; color: var(--rf-primary-text); font-size: 14px; }
.card-availability { color: var(--rf-muted); font-size: 12px; }
.loading-line { padding: 16px 0 4px; }
@media (max-width: 350px) {
  .activity-card { grid-template-columns: 72px minmax(0, 1fr); gap: 4px 10px; }
  .activity-image { width: 72px; height: 92px; }
}
