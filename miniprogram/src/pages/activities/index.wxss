@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.filters { width: 100%; margin: 0 0 16px; height: 44px; white-space: nowrap; }
.filter-track { display: inline-flex; align-items: center; min-height: 44px; padding-right: 8px; }
.filter { display: inline-flex; justify-content: center; align-items: center; flex-shrink: 0; min-height: 44px; padding: 0 16px; margin-right: 8px; border-radius: 8px; background: var(--rf-soft); color: var(--rf-primary-text); font-size: 13px; line-height: 1.4; }
.filter.active { color: var(--rf-on-primary); background: var(--rf-primary); }
.activities-content .grid { display: flex; flex-direction: column; gap: 12px; }
.activity-card { display: grid; grid-template-columns: 96px minmax(0,1fr); gap: 5px 12px; padding: 12px 0; }
.activity-image { grid-column: 1; grid-row: 1 / 5; width: 96px; height: 104px; border-radius: 8px; background: var(--rf-soft); }
.card-meta { grid-column: 2; margin: 0; font-size: 11px; line-height: 1.5; letter-spacing: 0; color: var(--rf-muted); }
.card-title { grid-column: 2; color: var(--rf-ink); font-size: 16px; line-height: 1.45; font-weight: 600; }
.card-detail { grid-column: 2; margin: 0; color: var(--rf-muted); font-size: 12px; }
.card-footer { grid-column: 2; margin: 0; align-items: center; gap: 8px; flex-wrap: wrap; color: var(--rf-primary-text); font-size: 12px; }
.card-footer .muted { font-size: 11px; }
.loading-line { padding: 20px 0; }

@import "../../styles/slate-components.wxss";

.activity-search { margin: 12rpx 0; min-height: 88rpx; padding: 0 24rpx; border: 1rpx solid var(--rf-line); border-radius: 16rpx; background: var(--rf-surface); }
