.activities-hero {
  position: relative;
  height: 390rpx;
  padding: 0 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #173f34 0%, #365c49 62%, #6f8061 100%);
  color: #fff;
}
.activities-hero::after {
  content: "";
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  right: -100rpx;
  bottom: -160rpx;
  border: 1rpx solid rgba(255, 255, 255, .18);
  border-radius: 50%;
}
.brand {
  position: absolute;
  left: 32rpx;
  display: flex;
  flex-direction: column;
}
.brand-name {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}
.brand-caption {
  margin-top: 4rpx;
  font-size: 15rpx;
  letter-spacing: 3rpx;
  opacity: .78;
}
.activities-heading {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 42rpx;
}
.hero-kicker {
  font-size: 15rpx;
  letter-spacing: 3rpx;
  opacity: .72;
}
.hero-title {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}
.hero-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  opacity: .84;
}
.activities-content {
  padding-top: 0;
}
.filters {
  width: 100%;
  height: 72rpx;
  margin: 22rpx 0 24rpx;
  white-space: nowrap;
}
.filter-track {
  display: inline-flex;
  align-items: center;
  height: 72rpx;
  padding-right: 12rpx;
}
.filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: 32rpx;
  background: #e9eddf;
  color: #73816a;
  font-size: 24rpx;
  line-height: 1;
  vertical-align: middle;
}
.active {
  background: #193f34;
  color: #fffdf4;
}
