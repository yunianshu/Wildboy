@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
@import "../../styles/slate-components.wxss";

.profile-content {
  max-width: 480px;
  margin: 0 auto;
}
.profile-intro {
  margin: 0 0 16px;
  color: var(--rf-muted);
}
.profile-fields {
  padding: 12px 16px 16px;
  border: 1px solid var(--rf-line);
}
button.avatar-picker {
  display: flex;
  align-items: center;
  gap: 12px;
  box-sizing: border-box;
  width: 100%;
  min-height: 72px;
  margin: 0;
  padding: 8px 0;
  border-radius: var(--rf-control-radius);
  background: transparent;
  color: var(--rf-ink);
  text-align: left;
  line-height: 1.5;
}
button.avatar-picker::after {
  border: 0;
}
button.avatar-picker-pressed {
  background: var(--rf-soft);
}
.avatar-preview {
  display: flex;
  flex: 0 0 56px;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  overflow: hidden;
  border-radius: 50%;
  background: var(--rf-soft);
}
.avatar-photo {
  width: 100%;
  height: 100%;
}
.avatar-placeholder {
  width: 28px;
  height: 28px;
}
.avatar-copy {
  flex: 1;
  min-width: 0;
}
.profile-label {
  display: block;
  color: var(--rf-ink);
  font-size: 15px;
  font-weight: 600;
}
.avatar-action {
  margin-top: 2px;
  color: var(--rf-primary-text);
  font-size: 13px;
}
.avatar-chevron {
  flex: 0 0 16px;
  width: 16px;
  height: 16px;
}
.avatar-picker[disabled] .avatar-action {
  color: var(--rf-muted);
}
.avatar-picker[disabled] .avatar-chevron {
  opacity: .45;
}
.avatar-hint {
  margin-top: 4px;
}
.nickname-field {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--rf-line);
}
.nickname-field input {
  margin-top: 8px;
}
.nickname-placeholder {
  color: var(--rf-muted);
}
.profile-content > .uf-note,
.profile-content > .error {
  margin-top: 12px;
}
.profile-content > .uf-note button {
  margin-left: -8px;
}
.profile-save {
  margin-top: 20px;
}
.profile-save-note {
  margin-bottom: 12px;
}
.uf-page button.profile-skip {
  display: flex;
  width: 100%;
  margin-top: 4px;
}
