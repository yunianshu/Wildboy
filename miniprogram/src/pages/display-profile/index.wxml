<view class="uf-page display-profile-page page-motion {{pageMotionClass}}">
  <ui-state wx:if="{{loading}}" kind="loading">正在读取资料</ui-state>

  <view wx:elif="{{user}}" class="profile-content">
    <view class="profile-intro">头像和昵称均为选填，不影响登录与报名。</view>

    <view class="uf-card profile-fields">
      <button
        class="avatar-picker"
        open-type="chooseAvatar"
        bindchooseavatar="chooseAvatar"
        disabled="{{saving || !canChooseAvatar}}"
        hover-class="avatar-picker-pressed"
        aria-label="{{avatarPreview ? '更换头像' : '选择头像'}}"
      >
        <view class="avatar-preview">
          <image wx:if="{{avatarPreview}}" class="avatar-photo" src="{{avatarPreview}}" mode="aspectFill" binderror="avatarError" />
          <image wx:else class="avatar-placeholder" src="/assets/icons-slate/user.svg" mode="aspectFit" />
        </view>
        <view class="avatar-copy">
          <view class="profile-label">头像</view>
          <view class="avatar-action">{{avatarPreview ? '更换头像' : '选择头像'}}</view>
        </view>
        <image class="avatar-chevron" src="/assets/icons-slate/chevron-right.svg" mode="aspectFit" />
      </button>
      <view class="uf-caption avatar-hint">JPG 或 PNG，最大 2 MB，尺寸不超过 1024 × 1024</view>

      <view class="nickname-field">
        <label class="profile-label" for="display-nickname">昵称</label>
        <input
          wx:for="{{inputKeys}}"
          wx:key="*this"
          data-review-key="{{item}}"
          id="display-nickname"
          type="nickname"
          value="{{nickname}}"
          maxlength="32"
          bindinput="inputNickname"
          bindblur="blurNickname"
          bindnicknamereview="reviewNickname"
          disabled="{{saving || reviewing || !canReviewNickname}}"
          placeholder="输入昵称或选择微信昵称"
          placeholder-class="nickname-placeholder"
        />
      </view>
    </view>

    <view wx:if="{{!canChooseAvatar || !canReviewNickname}}" class="uf-note">当前微信版本不支持完整的头像和昵称设置，请升级微信或暂时跳过。</view>
    <view wx:if="{{reviewing}}" class="uf-note">
      <view>正在等待微信审核昵称。未响应时可重新输入或跳过。</view>
      <button class="text-button" bindtap="resetNicknameReview" disabled="{{saving}}">重新输入昵称</button>
    </view>
    <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>

    <view class="profile-save">
      <view class="uf-caption profile-save-note">未填写的项目会保留原资料。手机号和活动联系人可在「联系资料」中设置。</view>
      <button class="primary ui-button ui-button-block" bindtap="save" loading="{{saving}}" disabled="{{saving}}">{{saving ? '正在保存' : '保存资料'}}</button>
      <button class="text-button profile-skip" bindtap="skip" disabled="{{saving}}">{{onboarding ? '暂时跳过' : '暂不修改'}}</button>
    </view>
  </view>

  <view wx:else class="profile-content uf-stack">
    <ui-state kind="error">{{error}}<button class="secondary ui-button ui-button-block" bindtap="retry">重试</button></ui-state>
    <button class="text-button" bindtap="skip">返回</button>
  </view>
</view>
