<view class="na-page na-with-footer page-motion {{pageMotionClass}}"><view class="na-stack">
  <view wx:if="{{authorized}}" class="na-row"><button wx:if="{{authorized}}" class="ui-button secondary {{(loadingMore) ? 'button-disabled' : ''}}" bindtap="openFilters" disabled="{{loadingMore}}">筛选用户</button></view>
  <view class="na-muted">{{query ? '搜索：' + query : '全部活动用户'}}{{profile ? ' · ' + (profile === 'COMPLETE' ? '资料已完善' : '资料未完善') : ''}}</view>
  <view class="na-note"><image class="ui-icon" src="/assets/icons/info.svg" aria-hidden="true"/>手机号默认脱敏。资料由用户本人修改。仅可为已验证的微信账号调整权限；变更后目标需重新登录，资料和报名历史保留。</view>
  <ui-state wx:if="{{error}}" kind="error" compact="{{!!items.length}}">{{error}}<button class="ui-button ui-button-block secondary" bindtap="retry">重试</button><button wx:if="{{!authorized}}" class="ui-button ui-button-block primary" bindtap="login">管理员身份验证</button></ui-state>
  <ui-state wx:if="{{loading}}" kind="loading">正在加载用户…</ui-state>
  <block wx:if="{{authorized}}"><view wx:if="{{roleNotice}}" class="na-note" aria-role="status">{{roleNotice}}</view><view wx:if="{{roleError}}" class="na-error" aria-role="alert">{{roleError}}</view><button wx:if="{{roleRecoveryNeeded}}" class="secondary ui-button ui-button-block {{(!!roleBusyId || loading) ? 'button-disabled' : ''}}" bindtap="refresh" disabled="{{!!roleBusyId || loading}}">重新读取角色状态</button>
    <ui-state wx:if="{{!items.length && !loading && !error}}" kind="empty">没有匹配的用户</ui-state>
    <view wx:for="{{items}}" wx:key="id" class="na-record">
      <view class="na-row"><view class="na-grow"><view class="na-record-title">{{item.nickname}}</view><view class="na-muted">{{item.realName || '姓名未填写'}} · {{item.phone || '手机号未填写'}}</view></view><text class="na-badge">{{item.profileCompleted ? '已完善' : '未完善'}}</text></view>
      <view class="na-muted">{{item.roleText}} · {{item.sourceText}}</view><view class="na-muted">有效报名 {{item.confirmedRegistrationCount}} · 待付款 {{item.pendingRegistrationCount || 0}} · 全部记录 {{item.registrationCount}}</view>
      <button class="ui-button ui-button-block secondary {{(detailLoading || !!roleBusyId) ? 'button-disabled' : ''}}" data-id="{{item.id}}" bindtap="openUser" disabled="{{detailLoading || !!roleBusyId}}">查看用户与报名</button><button wx:if="{{item.canChangeRole}}" class="secondary ui-button ui-button-block {{(!!roleBusyId || loading || loadingMore || detailLoading || roleRecoveryNeeded || roleReadOnly) ? 'button-disabled' : ''}}" data-id="{{item.id}}" bindtap="changeRole" disabled="{{!!roleBusyId || loading || loadingMore || detailLoading || roleRecoveryNeeded || roleReadOnly}}" loading="{{roleBusyId === item.id}}">{{item.role === 'ADMIN' ? '撤销管理员权限' : '设为管理员'}}</button><view wx:else class="na-muted">{{item.blockText}}</view>
    </view>
    <button wx:if="{{hasMore}}" class="ui-button ui-button-block secondary {{(loadingMore) ? 'button-disabled' : ''}}" bindtap="retry" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多用户</button>
    <view wx:elif="{{!loading && !error}}" class="na-muted">已显示全部 {{total}} 位用户</view>
  </block>
</view><view wx:if="{{authorized}}" class="na-footer"><button class="ui-button ui-button-block secondary {{(loading || loadingMore || !!roleBusyId) ? 'button-disabled' : ''}}" bindtap="refresh" disabled="{{loading || loadingMore || !!roleBusyId}}">刷新用户</button></view></view>
<view wx:if="{{filterOpen}}" class="participant-overlay users-overlay" catchtap="closeFilters" catchtouchmove="stopModalEvent"><view class="participant-dialog user-filter-dialog motion-dialog-enter" catchtap="stopModalEvent" aria-role="dialog" aria-modal="true" aria-label="筛选用户">
  <view class="dialog-head"><view class="section-title">筛选用户</view><button class="dialog-close ui-button" bindtap="closeFilters" aria-label="关闭筛选"><image class="ui-icon" src="/assets/icons/close.svg" mode="aspectFit" aria-hidden="true"/></button></view>
  <scroll-view scroll-y class="dialog-body user-filter-body">
  <view class="field"><text class="label">昵称、姓名、编号或完整手机号</text><input value="{{queryDraft}}" maxlength="80" bindinput="filterInput" placeholder="输入查找内容"/></view>
  <view class="field"><text class="label">资料状态</text><picker range="{{['全部状态', '资料已完善', '资料未完善']}}" value="{{profileDraft === 'COMPLETE' ? 1 : profileDraft === 'INCOMPLETE' ? 2 : 0}}" bindchange="profileChange"><view class="na-picker">{{profileDraft === 'COMPLETE' ? '资料已完善' : profileDraft === 'INCOMPLETE' ? '资料未完善' : '全部状态'}}<image class="ui-icon picker-icon" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view></picker></view>
  <view class="field"><text class="label">用户权限</text><picker range="{{['全部权限', '普通用户', '管理员']}}" value="{{roleDraft === 'USER' ? 1 : roleDraft === 'ADMIN' ? 2 : 0}}" bindchange="roleFilterChange"><view class="na-picker">{{roleDraft === 'USER' ? '普通用户' : roleDraft === 'ADMIN' ? '管理员' : '全部权限'}}<image class="ui-icon picker-icon" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view></picker></view><view class="field"><text class="label">账号来源</text><picker range="{{['全部来源', '微信账号', '密码管理账号', '演示账号', '其他账号']}}" value="{{sourceDraft === 'WECHAT' ? 1 : sourceDraft === 'PASSWORD' ? 2 : sourceDraft === 'DEMO' ? 3 : sourceDraft === 'OTHER' ? 4 : 0}}" bindchange="sourceChange"><view class="na-picker">{{sourceDraft === 'WECHAT' ? '微信账号' : sourceDraft === 'PASSWORD' ? '密码管理账号' : sourceDraft === 'DEMO' ? '演示账号' : sourceDraft === 'OTHER' ? '其他账号' : '全部来源'}}<image class="ui-icon picker-icon" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view></picker></view>
  </scroll-view>
  <view class="dialog-actions"><button class="secondary ui-button ui-button-block" bindtap="resetFilters">清空条件</button><button class="primary ui-button ui-button-block {{(loadingMore) ? 'primary-disabled' : ''}}" bindtap="applyFilters" disabled="{{loadingMore}}">查询用户</button></view>
</view></view>
<view wx:if="{{detailId}}" class="participant-overlay users-overlay" catchtap="closeUser" catchtouchmove="stopModalEvent"><view class="participant-dialog user-detail-dialog motion-dialog-enter" catchtap="stopModalEvent" aria-role="dialog" aria-modal="true" aria-label="用户资料与报名历史">
  <view class="dialog-head"><view class="section-title">用户资料与报名历史</view><button class="dialog-close ui-button" bindtap="closeUser" aria-label="关闭用户详情"><image class="ui-icon" src="/assets/icons/close.svg" mode="aspectFit" aria-hidden="true"/></button></view>
  <ui-state wx:if="{{detailLoading && !detail}}" kind="loading" compact="{{true}}">正在读取用户…</ui-state>
  <view wx:if="{{detailError}}" class="error">{{detailError}}</view>
  <scroll-view wx:if="{{detail}}" scroll-y class="dialog-body user-detail-body"><view class="uf-stack">
    <view><view class="section-title">{{detail.user.nickname}}</view><view class="uf-caption">{{detail.user.realName || '姓名未填写'}} · {{detail.user.phone || '手机号未填写'}}</view><view class="uf-caption">用户编号：{{detail.user.id}}</view></view>
    <view class="uf-caption">注册 {{detail.user.createdText}} · 资料更新 {{detail.user.profileUpdatedText}}</view>
    <view class="uf-caption">{{detail.user.roleText}} · {{detail.user.sourceText}}</view><button wx:if="{{detail.user.canChangeRole}}" class="secondary ui-button ui-button-block {{(!!roleBusyId || detailLoading || roleRecoveryNeeded || roleReadOnly) ? 'button-disabled' : ''}}" data-id="{{detail.user.id}}" bindtap="changeRole" disabled="{{!!roleBusyId || detailLoading || roleRecoveryNeeded || roleReadOnly}}">{{detail.user.role === 'ADMIN' ? '撤销管理员权限' : '设为管理员'}}</button><view wx:else class="uf-caption">{{detail.user.blockText}}</view><view class="uf-row uf-between"><view class="section-title">报名历史</view><picker range="{{['全部', '有效报名', '已取消 / 已退款', '待付款']}}" value="{{detailStatus === 'CONFIRMED' ? 1 : detailStatus === 'CANCELLED' ? 2 : detailStatus === 'PENDING_PAYMENT' ? 3 : 0}}" bindchange="detailStatusChange" disabled="{{detailLoading}}"><view class="na-picker">{{detailStatus === 'CONFIRMED' ? '有效报名' : detailStatus === 'CANCELLED' ? '已取消 / 已退款' : detailStatus === 'PENDING_PAYMENT' ? '待付款' : '全部'}}<image class="ui-icon picker-icon" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view></picker></view>
    <view wx:if="{{!detail.registrations.items.length}}" class="uf-caption">暂无报名记录</view>
    <view wx:for="{{detail.registrations.items}}" wx:key="id" class="na-record"><view class="na-record-title">{{item.activityTitle}}</view><view class="uf-caption">{{item.createdText}} · {{item.sourceText}} · {{item.statusText}} · {{item.participants.length}} 位参与人</view><view wx:for="{{item.participants}}" wx:for-item="participant" wx:key="id">{{participant.participantName}} · {{participant.phone}}{{participant.idNumber ? ' · 证件已脱敏' : ''}}</view><button class="secondary ui-button ui-button-block" data-id="{{item.activityId}}" bindtap="roster">查看活动名单</button></view>
    <view wx:if="{{detail.registrations.total > detail.registrations.size}}" class="dialog-actions"><button class="secondary ui-button ui-button-block {{(detailLoading || detail.registrations.page === 0) ? 'button-disabled' : ''}}" bindtap="previousDetail" disabled="{{detailLoading || detail.registrations.page === 0}}">上一页</button><button class="secondary ui-button ui-button-block {{(detailLoading || !detail.registrations.hasMore) ? 'button-disabled' : ''}}" bindtap="nextDetail" disabled="{{detailLoading || !detail.registrations.hasMore}}">下一页</button></view>
    <view class="uf-caption">第 {{detail.registrations.page + 1}} 页 · 共 {{detail.registrations.total}} 条记录</view>
  </view></scroll-view>
  <view class="dialog-actions {{detailError ? '' : 'single-action'}}"><button wx:if="{{detailError}}" class="secondary ui-button ui-button-block {{(detailLoading) ? 'button-disabled' : ''}}" bindtap="retryDetail" disabled="{{detailLoading}}">重试</button><button class="primary ui-button ui-button-block" bindtap="closeUser">关闭</button></view>
</view></view>
