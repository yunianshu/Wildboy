@import "../../styles/slate-theme.wxss";
@import "../../styles/admin-flow.wxss";
@import "../../styles/user-flow.wxss";
.admin-users-picker { min-width: 120px; }
.user-filter-body { height: 380px; max-height: calc(100vh - 232px); min-height: 0; }
.user-filter-body .field:last-child { margin-bottom: 0; }
.user-detail-body { height: 56vh; max-height: calc(100vh - 232px); min-height: 0; }
.dialog-body .na-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  box-sizing: border-box;
  width: 100%;
  min-height: 48px;
  padding: 8px 12px;
  border: 1px solid var(--rf-field-line);
  border-radius: 10px;
  background: #FFFFFF;
  color: var(--rf-primary-text);
  font-size: 14px;
  line-height: 22px;
}
.dialog-body .picker-icon { flex-shrink: 0; width: 18px; height: 18px; transform: rotate(90deg); }
.user-detail-body .na-record {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px;
  border-radius: 10px;
  background: var(--rf-bg);
  word-break: break-all;
}
.user-detail-body .na-record-title { font-size: 15px; font-weight: 600; line-height: 1.5; }
.user-detail-body .uf-caption, .user-detail-body .section-title { word-break: break-all; }

@import "../../styles/slate-components.wxss";
