@import "../../styles/slate-theme.wxss";
@import "../../styles/section-tabs.wxss";
/* 我的活动订单 · 对照 Pen 画板「小程序 / 活动订单」(3yIfJ) */
.activity-orders-page .title { margin-bottom: 8rpx; }
.activity-orders-page .page-intro { margin-bottom: 20rpx; }
.activity-orders-page .refresh { margin-top: 0; }

.order-card { padding: 26rpx; margin-top: 26rpx; border: 1px solid var(--rf-line); border-radius: 16rpx; background: var(--rf-surface); }
.order-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.order-title { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }

/* 状态胶囊：与设计 token 一致（warning/success/info/neutral） */
.activity-orders-page .badge.wait { background: var(--rf-warning-bg); color: var(--rf-warning); }
.activity-orders-page .badge.ok { background: var(--rf-bg); color: var(--rf-primary-text); }
.activity-orders-page .badge.info { background: var(--rf-bg); color: var(--rf-muted); }
.activity-orders-page .badge.neutral { background: var(--rf-bg); color: var(--rf-muted); }

.order-meta { margin-bottom: 6rpx; color: var(--rf-primary-text); }
.order-amount { font-size: 32rpx; font-weight: 600; }
.activity-orders-page .original { text-decoration: line-through; opacity: .8; }
.price-lines { margin-top: 4rpx; }
.order-number { margin-top: 12rpx; color: var(--rf-muted); font-size: 21rpx; word-break: break-all; }

.order-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.sub-actions { flex-wrap: wrap; }
.small-button { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; min-height: 72rpx; padding: 10rpx 12rpx; line-height: 1.4; font-size: 25rpx; text-align: center; }
.inline-error { margin-top: 14rpx; }

.expand-panel, .confirm-panel { margin-top: 18rpx; padding: 18rpx; border-radius: 12rpx; background: var(--rf-bg); }
.panel-title { font-size: 27rpx; font-weight: 600; margin-bottom: 8rpx; }
.participant-row { display: flex; flex-wrap: wrap; gap: 6rpx 14rpx; padding: 6rpx 0; }
.participant-name { font-weight: 600; }
.refund-textarea { width: 100%; box-sizing: border-box; min-height: 128rpx; margin: 14rpx 0; padding: 14rpx; background: #FFFFFF; border: 1rpx solid var(--rf-soft); border-radius: 10rpx; font-size: 26rpx; }
.expand-panel button, .confirm-panel button { margin-top: 12rpx; }
.confirm-panel .order-actions button { margin-top: 0; }

.activity-orders-page .more { margin-top: 26rpx; }
.activity-orders-page .order-head .order-title { justify-content: flex-start; padding: 4px 0; font-size: 16px; line-height: 1.45; text-align: left; }
.activity-orders-page .order-head .badge { max-width: 46%; white-space: normal; text-align: center; }
.activity-orders-page .order-number { display: flex; align-items: center; gap: 8px; font-size: 12px; line-height: 1.5; }
.activity-orders-page .order-number > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.activity-orders-page .order-number > .text-button { flex-shrink: 0; padding-right: 0; }
.activity-orders-page .sub-actions { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 8px; }
.activity-orders-page .sub-actions > button:only-child { grid-column: 1 / -1; }
.activity-orders-page .expand-panel { padding: 12px; margin-top: 12px; border-radius: 8px; }
.activity-orders-page .participant-row { gap: 4px 12px; padding: 8px 0; border-bottom: 1px solid var(--rf-line); }
.activity-orders-page .participant-row:last-child { border-bottom: 0; }
.activity-orders-page .expand-panel > button { width: 100%; }

@import "../../styles/slate-components.wxss";

.activity-order-tabs { margin-top: 16px; }
