.picture {
  height: 760rpx;
  position: relative;
  color: #fff;
}
.picture image,
.shade {
  position: absolute;
  width: 100%;
  height: 100%;
}
.shade {
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.2),
    transparent,
    rgba(0, 0, 0, 0.5)
  );
}
.brand {
  position: absolute;
  top: 90rpx;
  left: 42rpx;
  font-weight: 800;
  font-size: 76rpx;
}
.brand text,
.slogan text {
  display: block;
  font-weight: 400;
  font-size: 25rpx;
  margin-top: 12rpx;
}
.slogan {
  position: absolute;
  bottom: 100rpx;
  left: 42rpx;
  font-size: 46rpx;
  font-weight: 700;
}
.panel {
  position: relative;
  margin-top: -44rpx;
  padding: 48rpx 36rpx 70rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: #f6f4ed;
}
.agreement {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  line-height: 1.7;
  margin: 24rpx 0;
}
.primary {
  margin: 28rpx 0;
}
.text-button {
  margin-top: 40rpx;
  background: transparent;
  color: #173f35;
}
.admin-link {
  text-align: center;
  font-size: 23rpx;
  color: #6c766c;
  margin-top: 28rpx;
}
.error {
  margin: 20rpx 0;
}
.agreement checkbox {
  flex-shrink: 0;
  width: 56rpx;
  transform: scale(0.8);
  transform-origin: left top;
}
.agreement-copy {
  flex: 1;
  min-width: 0;
}
