<view class="welcome">
  <view class="picture">
    <image src="/assets/hero-hiking.jpg" mode="aspectFill" />
    <view class="shade" />
    <view class="brand">
      wildboy.
      <text>野一点，自由一点</text>
    </view>
    <view class="slogan">
      把日常留在身后
      <text>下一程，和同频的人一起出发。</text>
    </view>
  </view>
  <view class="panel">
    <view class="title">
      {{mode === 'consent' ? '协议已更新' : '欢迎加入 Wildboy'}}
    </view>
    <view wx:if="{{loading}}" class="state">正在加载协议…</view>
    <block wx:if="{{current}}">
      <checkbox-group bindchange="agreement">
        <view class="agreement">
          <checkbox
            value="yes"
            checked="{{agreed}}"
            disabled="{{busy}}"
            color="#173F35"
            aria-label="我已阅读并同意当前版本隐私政策和用户协议"
          />
          <view class="agreement-copy">我已阅读并同意当前版本<text class="legal-link" catchtap="readPrivacy" aria-role="link" aria-label="隐私政策，版本 {{current.privacy.version}}">《隐私政策》</text><text class="legal-link" catchtap="readTerms" aria-role="link" aria-label="用户协议，版本 {{current.terms.version}}">《用户协议》</text></view>
        </view>
      </checkbox-group>
    </block>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button
      wx:if="{{!current && !loading}}"
      class="secondary"
      bindtap="retry"
    >
      重新获取协议
    </button>
    <button
      class="primary"
      disabled="{{loading || busy || !current || !agreed}}"
      loading="{{busy}}"
      bindtap="submit"
    >
      {{mode === 'consent' ? '确认当前协议' : '微信登录'}}
    </button>
    <button class="text-button" bindtap="browse">先逛逛</button>
    <view class="admin-link" bindtap="admin">管理员登录</view>
  </view>
</view>
