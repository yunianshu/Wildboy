<view class="welcome page-motion {{pageMotionClass}}">
  <view class="login-brand">WILDBOY<text>野小子户外俱乐部</text></view>
  <view class="panel">
    <view class="title">
      {{mode === 'consent' ? '协议已更新' : '欢迎加入 Wildboy'}}
    </view>
    <ui-state wx:if="{{loading}}" kind="loading">正在加载协议…</ui-state>
    <block wx:if="{{current}}">
      <checkbox-group bindchange="agreement">
        <view class="agreement">
          <checkbox
            value="yes"
            checked="{{agreed}}"
            disabled="{{busy}}"
            color="#9E2845"
            aria-label="我已阅读并同意当前版本隐私政策和用户协议"
          />
          <view class="agreement-copy">我已阅读并同意当前版本<text class="legal-link" catchtap="readPrivacy" aria-role="link" aria-label="隐私政策，版本 {{current.privacy.version}}">《隐私政策》</text><text class="legal-link" catchtap="readTerms" aria-role="link" aria-label="用户协议，版本 {{current.terms.version}}">《用户协议》</text></view>
        </view>
      </checkbox-group>
    </block>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button
      wx:if="{{!current && !loading}}"
      class="secondary"
      bindtap="retry"
    >
      重新获取协议
    </button>
    <button
      class="primary"
      disabled="{{loading || busy || !current || !agreed}}"
      loading="{{busy}}"
      bindtap="submit"
    >
      {{mode === 'consent' ? '确认当前协议' : '微信登录'}}
    </button>
    <button class="text-button" bindtap="browse">先逛逛</button>
    <view wx:if="{{adminLoginEnabled}}" class="admin-link" bindtap="admin">管理员登录</view>
    <view wx:elif="{{adminCapabilityLoading}}" class="admin-link">正在读取管理入口…</view>
    <view wx:elif="{{adminCapabilityError}}" class="error">{{adminCapabilityError}}<button class="text-button" bindtap="loadAdminCapability">重新读取管理入口</button></view>
  </view>
</view>
