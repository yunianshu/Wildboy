@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.order-product { display: flex; gap: 24rpx; padding: 24rpx; margin-top: 30rpx; border-radius: 16rpx; background: var(--rf-soft); }
.order-product image { width: 180rpx; height: 180rpx; flex-shrink: 0; border-radius: 10rpx; }
.order-product-info { flex: 1; min-width: 0; }
.product-name { font-size: 30rpx; font-weight: 650; line-height: 1.5; }
.order-product .muted { margin-top: 10rpx; }
.price { margin-top: 16rpx; color: var(--rf-primary-text); font-size: 31rpx; font-weight: 700; }
.checkout-page textarea { width: 100%; height: 170rpx; padding: 22rpx 24rpx; border: 1rpx solid var(--rf-soft); border-radius: 10rpx; background: #FFFFFF; font-size: 29rpx; box-sizing: border-box; }
.consent { display: flex; align-items: flex-start; margin-top: 30rpx; color: var(--rf-muted); font-size: 24rpx; line-height: 1.8; }
.consent checkbox { flex-shrink: 0; width: 55rpx; transform: scale(.8); transform-origin: left top; }
.form-error { padding-top: 24rpx; font-size: 25rpx; }
.submit { margin-top: 30rpx; }
.result-card { padding: 48rpx 28rpx; margin-bottom: 26rpx; border-radius: 18rpx; background: var(--rf-soft); text-align: center; }
.result-card.paid { background: var(--rf-soft); }
.result-mark { font-size: 66rpx; }
.result-total { margin-top: 20rpx; color: var(--rf-muted); font-size: 23rpx; }
.result-card + .notice { margin-bottom: 26rpx; }
.checkout-page > button { margin-top: 18rpx; }
.payment-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.payment-actions button { flex: 1; min-width: 0; margin: 0; min-height: 80rpx; padding: 12rpx 16rpx; }
.checkout-page .orders-link { width: auto; min-height: 72rpx; margin: 8rpx auto 0; padding: 12rpx 24rpx; background: transparent; font-weight: 400; }

.shipping-card { padding: 28rpx; border-radius: 20rpx; background: white; margin-bottom: 28rpx; }
.shipping-name { font-weight: 600; font-size: 30rpx; }
.shipping-detail { margin-top: 14rpx; font-size: 27rpx; line-height: 1.6; word-break: break-all; }
.shipping-change { text-align: right; color: var(--rf-muted); margin-top: 18rpx; font-size: 25rpx; }

.result-mark { display: flex; align-items: center; justify-content: center; }
.result-icon { width: 44rpx; height: 44rpx; }
.row-chevron { width: 26rpx; height: 26rpx; margin-left: 6rpx; vertical-align: middle; }
.shipping-change { display: flex; align-items: center; justify-content: flex-end; }
.shipping-select { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 24px; }
.shipping-select .row-chevron { flex-shrink: 0; }

@import "../../styles/slate-components.wxss";
