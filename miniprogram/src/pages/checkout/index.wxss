.order-product { display: flex; gap: 24rpx; padding: 24rpx; margin-top: 30rpx; border-radius: 16rpx; background: #e8ecdf; }
.order-product image { width: 180rpx; height: 180rpx; flex-shrink: 0; border-radius: 10rpx; }
.order-product-info { flex: 1; min-width: 0; }
.product-name { font-size: 30rpx; font-weight: 650; line-height: 1.5; }
.order-product .muted { margin-top: 10rpx; }
.price { margin-top: 16rpx; color: #8a4b31; font-size: 31rpx; font-weight: 700; }
.checkout-page textarea { width: 100%; height: 170rpx; padding: 22rpx 24rpx; border: 1rpx solid #dce1d5; border-radius: 10rpx; background: #fffdf7; font-size: 29rpx; box-sizing: border-box; }
.consent { display: flex; align-items: flex-start; margin-top: 30rpx; color: #6a7561; font-size: 24rpx; line-height: 1.8; }
.consent checkbox { flex-shrink: 0; width: 55rpx; transform: scale(.8); transform-origin: left top; }
.form-error { padding-top: 24rpx; font-size: 25rpx; }
.submit { margin-top: 30rpx; }
.result-card { padding: 48rpx 28rpx; margin-bottom: 26rpx; border-radius: 18rpx; background: #eee9dc; text-align: center; }
.result-card.paid { background: #e2ead5; }
.result-mark { font-size: 66rpx; }
.result-total { margin-top: 20rpx; color: #7c8178; font-size: 23rpx; }
.result-card + .notice { margin-bottom: 26rpx; }
.checkout-page > button { margin-top: 18rpx; }
