<view class="page checkout-page">
  <view wx:if="{{loading}}" class="state">正在核对商品与协议…</view>
  <block wx:elif="{{order}}">
    <view wx:if="{{recoveredOrder}}" class="notice">已找回原订单，未重复下单。付款前请核对收货信息。</view>
    <view class="result-card {{(order.status === 'PAID' || order.status === 'SHIPPED') ? 'paid' : ''}}">
      <view class="result-mark">{{(order.status === 'PAID' || order.status === 'SHIPPED') ? '✓' : '…'}}</view>
      <view class="title">{{order.status === 'PENDING_PAYMENT' && awaitingConfirmation ? '支付结果确认中' : orderStatusText}}</view>
      <view class="muted">订单号 {{order.orderNo}}</view>
      <view class="result-total">订单金额 {{orderTotalText}}</view>
      <view class="muted">{{order.recipientName}} · {{order.phone}}</view>
      <view class="muted">{{order.address}}</view>
    </view>
    <view wx:if="{{order.status === 'PENDING_PAYMENT' && orderDeadlineText}}" class="notice">付款截止 {{orderDeadlineText}}，超时后核实关单并释放库存。</view>
    <view wx:if="{{order.reconciliationRequired}}" class="notice">支付状态待核对，库存暂时保留。请刷新结果或联系管理员，不要重复下单。</view>
    <view wx:if="{{error}}" class="error form-error">{{error}}</view>
    <view wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="notice">已付款请刷新结果，勿重复下单；未付款可继续支付。</view>
    <button wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="refreshOrder">刷新支付结果</button>
    <button wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="secondary" loading="{{busy}}" disabled="{{busy}}" bindtap="payExisting">继续支付</button>
    <button class="secondary" bindtap="orders">查看我的订单</button>
  </block>
  <block wx:elif="{{product}}">
    <view class="title">确认订单</view>
    <view class="order-product"><image src="{{product.imageUrl}}" mode="aspectFill" /><view class="order-product-info"><view class="product-name">{{product.name}}</view><view class="muted">数量 × {{quantity}}</view><view class="price">{{totalText}}</view></view></view>
    <view class="section-head"><view class="section-title">收货地址</view></view>
    <view wx:if="{{addressLoading}}" class="state">正在加载地址…</view>
    <view wx:elif="{{addressError}}" class="error">{{addressError}}<button class="secondary" bindtap="retryAddress">重试</button></view>
    <view class="shipping-card" bindtap="chooseAddress" role="button" aria-label="选择收货地址">
      <block wx:if="{{selectedAddressId}}"><view class="shipping-name">{{recipientName}} · {{phone}}</view><view class="shipping-detail">{{address}}</view><view class="shipping-change">更换地址 ›</view></block>
      <view wx:else>选择收货地址 ›</view>
    </view>
    <checkbox-group bindchange="consentChange"><view class="consent"><checkbox value="yes" checked="{{consent}}" color="#193F34" disabled="{{busy}}" aria-label="同意当前协议及订单信息使用" /><view>我已阅读并同意当前版本<text class="legal-link" catchtap="privacy" aria-role="link" aria-label="隐私政策，版本 {{legal.privacy.version}}">《隐私政策》</text><text class="legal-link" catchtap="terms" aria-role="link" aria-label="用户协议，版本 {{legal.terms.version}}">《用户协议》</text>，同意为订单履约处理收货与支付信息。</view></view></checkbox-group>
    <view class="notice">价格与库存以下单确认为准。取消支付后，可在“我的订单”继续付款。</view>
    <view wx:if="{{error}}" class="error form-error">{{error}}</view>
    <button class="primary submit" loading="{{busy}}" disabled="{{busy || !legal || addressLoading || !selectedAddressId || addressError}}" bindtap="submit">{{busy ? '正在处理订单…' : '提交订单并支付 ' + totalText}}</button>
  </block>
  <view wx:if="{{error && !product && !order}}" class="state error">{{error}}<button class="secondary" bindtap="retry">重试</button></view>
</view>
