<view class="page checkout-page">
  <view wx:if="{{loading}}" class="state">正在核对商品与协议…</view>
  <block wx:elif="{{order}}">
    <view class="result-card {{order.status === 'PAID' ? 'paid' : ''}}">
      <view class="result-mark">{{order.status === 'PAID' ? '✓' : '…'}}</view>
      <view class="title">{{order.status === 'PAID' ? '支付已确认' : (order.status === 'CANCELLED' ? '订单已取消' : '支付结果确认中')}}</view>
      <view class="muted">订单号 {{order.orderNo}}</view>
      <view class="result-total">订单金额 {{orderTotalText}}</view>
    </view>
    <view wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="notice">只有服务端确认已支付才会显示成功。若已付款，请刷新结果；不要重复创建新订单。</view>
    <button wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="primary" loading="{{busy}}" bindtap="refreshOrder">刷新支付结果</button>
    <button wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="secondary" loading="{{busy}}" bindtap="payExisting">继续支付</button>
    <button class="secondary" bindtap="orders">查看我的订单</button>
  </block>
  <block wx:elif="{{product}}">
    <view class="eyebrow">ONE LAST CHECK</view><view class="title">确认这次出发的准备</view>
    <view class="order-product"><image src="{{product.imageUrl}}" mode="aspectFill" /><view class="order-product-info"><view class="product-name">{{product.name}}</view><view class="muted">数量 × {{quantity}}</view><view class="price">{{totalText}}</view></view></view>
    <view class="section-head"><view class="section-title">收货信息</view></view>
    <view class="field"><text class="label">收货人</text><input value="{{recipientName}}" maxlength="40" placeholder="请填写收货人姓名" data-field="recipientName" bindinput="input" disabled="{{busy}}" /></view>
    <view class="field"><text class="label">手机号</text><input value="{{phone}}" type="number" maxlength="11" placeholder="用于订单与配送联系" data-field="phone" bindinput="input" disabled="{{busy}}" /></view>
    <view class="field"><text class="label">收货地址</text><textarea value="{{address}}" maxlength="300" placeholder="省市区、详细地址" data-field="address" bindinput="input" disabled="{{busy}}" /></view>
    <checkbox-group bindchange="consentChange"><label class="consent"><checkbox value="yes" checked="{{consent}}" color="#193F34" disabled="{{busy}}" /><text>我已阅读并同意当前隐私政策、用户协议，同意为订单履约处理收货与支付信息。</text></label></checkbox-group>
    <view class="privacy" bindtap="privacy">阅读隐私政策（版本 {{legal.privacy.version}}）↗</view>
    <view class="privacy" bindtap="terms">阅读用户协议（版本 {{legal.terms.version}}）↗</view>
    <view class="notice">提交后由服务端核对价格与库存并创建订单。支付取消不会生成付款成功记录，订单可稍后继续支付。</view>
    <view wx:if="{{error}}" class="error form-error">{{error}}</view>
    <button class="primary submit" loading="{{busy}}" disabled="{{busy || !legal}}" bindtap="submit">{{busy ? '正在处理订单…' : '提交订单并支付 ' + totalText}}</button>
  </block>
  <view wx:if="{{error && !product && !order}}" class="state error">{{error}}<button class="secondary" bindtap="retry">重试</button></view>
</view>
