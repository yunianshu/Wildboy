@import "../../styles/slate-theme.wxss";
.page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.section-title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 20rpx 0;
}
.muted {
  color: var(--rf-muted);
  font-size: 24rpx;
  margin: 12rpx 0;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0;
}
.form .actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 calc((100% - 16rpx) / 2);
  width: calc((100% - 16rpx) / 2);
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 0 16rpx;
  font-size: 28rpx;
  line-height: 1.4;
  white-space: nowrap;
}
.card {
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 20rpx 0;
}
.card image {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.main {
  flex: 1;
  min-width: 0;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.form label {
  display: block;
  margin: 24rpx 0;
}
.form input,
.form textarea,
.picker {
  box-sizing: border-box;
  background: #FFFFFF;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
  width: 100%;
}
.form input {
  height: 84rpx;
}
.form textarea {
  height: 260rpx;
}
.presets {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.presets image {
  width: 100rpx;
  height: 100rpx;
}
.form button {
  margin-top: 24rpx;
}
.error {
  color: var(--rf-danger);
  white-space: pre-wrap;
  word-break: break-all;
}

@import "../../styles/slate-components.wxss";

.product-editor .form label { margin: 16px 0; }
.product-editor .field-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 12px; }
.product-editor .field-grid label { min-width: 0; margin-bottom: 0; }
.product-editor .field { margin: 16px 0; }
.product-editor .picker { min-height: 48px; display: flex; align-items: center; padding: 0 12px; }
.product-editor .cover-row { display: flex; gap: 12px; align-items: center; margin: 20px 0 12px; }
.product-editor .cover-preview { flex: 0 0 88px; width: 88px; height: 88px; border-radius: 12px; background: var(--rf-soft); }
.product-editor .cover-controls { flex: 1; min-width: 0; }
.product-editor .cover-controls button { margin: 0; width: 100%; }
.product-editor .segments { display: flex; gap: 12px; }
.product-editor .segments button { flex: 1; min-width: 0; margin: 0; min-height: 44px; padding: 8px 12px; }
.product-editor .form > button { width: 100%; }
.product-editor .confirmation button { width: 100%; }
