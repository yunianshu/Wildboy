<view class="page orders-page page-motion {{pageMotionClass}}">
  <view class="title">我的订单</view>
  <ui-state wx:if="{{!loggedIn}}" kind="empty">登录后查看自己的装备订单<button class="primary ui-button ui-button-block" bindtap="signIn">微信登录</button></ui-state>
  <block wx:else>
    <scroll-view scroll-x class="order-filters"><view class="filter-row"><button wx:for="{{filters}}" wx:key="code" class="filter {{selected === item.code ? 'active' : ''}}" data-code="{{item.code}}" bindtap="select" disabled="{{busyId}}">{{item.name}}</button></view></scroll-view>
    <ui-state wx:if="{{loading}}" kind="loading">正在读取订单…</ui-state>
    <ui-state wx:elif="{{error && !items.length}}" kind="error">{{error}}<button class="secondary ui-button ui-button-block" bindtap="retry">重试</button></ui-state>
    <ui-state wx:elif="{{!items.length}}" kind="empty">当前分类暂无订单</ui-state>
    <view class="order-card" wx:for="{{items}}" wx:key="id">
      <view class="order-head"><text class="badge {{item.status === 'CANCELLED' ? 'cancelled' : ''}}">{{item.statusText}}</text><text class="muted small">{{item.dateText}}</text></view>
      <view class="order-line" wx:for="{{item.items}}" wx:for-item="product" wx:key="id"><view class="product-name">{{product.productName}}<text wx:if="{{product.tierName}}" class="muted small"> · {{product.tierName}}会员价</text></view><view class="muted small">x {{product.quantity}}</view></view>
      <view wx:if="{{item.originalTotalCents > item.totalCents}}" class="muted small">优惠前 {{item.originalTotalText}}</view>
      <view class="order-total"><text>合计</text><strong>{{item.totalText}}</strong></view>
      <view wx:if="{{item.status === 'PENDING_PAYMENT' && item.deadlineText}}" class="muted small">付款截止 {{item.deadlineText}}</view>
      <view wx:if="{{item.reconciliationRequired}}" class="notice">支付状态待核对，库存暂时保留，请联系管理员。</view>
      <view class="order-number">订单号 {{item.orderNo}}</view>
      <view class="order-actions"><button wx:if="{{item.status === 'PAID' || item.status === 'REFUNDED'}}" class="secondary small-button" data-id="{{item.id}}" bindtap="openRefund" disabled="{{busyId || loading || loadingMore}}">退款 / 售后</button><button wx:if="{{item.status === 'PENDING_PAYMENT'}}" class="secondary small-button" data-id="{{item.id}}" bindtap="verify" disabled="{{busyId || loading || loadingMore}}">刷新支付结果</button><button wx:if="{{item.status === 'PENDING_PAYMENT'}}" class="primary small-button" data-id="{{item.id}}" bindtap="pay" loading="{{busyId === item.id}}" disabled="{{busyId || loading || loadingMore}}">继续支付</button><button wx:if="{{item.status === 'PENDING_PAYMENT' || item.status === 'CONFIRMED_FREE'}}" class="secondary small-button" data-id="{{item.id}}" bindtap="cancel" disabled="{{busyId || loading || loadingMore}}">取消订单</button></view>
    </view>
    <ui-state wx:if="{{error}}" kind="error" compact="{{!!items.length}}">{{error}}</ui-state>
    <button wx:if="{{hasMore}}" class="secondary" bindtap="more" loading="{{loadingMore}}" disabled="{{loading || loadingMore || busyId}}">{{loadingMore ? '正在加载…' : '加载更多订单'}}</button>
    <view wx:elif="{{items.length}}" class="muted end">已显示全部订单</view>
    <view class="notice">已发货订单售后请联系客服；订单地址不可修改。</view>
  </block>
</view>

<ui-dialog wx:if="{{refundOrderId}}" title="退款 / 售后" busy="{{!!busyId}}" bindclose="closeRefund">
  <scroll-view scroll-y class="ui-refund-body">
    <block wx:if="{{refundRecord}}"><view class="badge">{{refundStatusText}}{{refundAmountText ? " · " + refundAmountText : ""}}</view><view class="notice">{{refundRecord.reason}}</view><view>{{refundRecord.decisionNote || refundRecord.lastError}}</view></block>
    <block wx:else><view class="notice">已付款、未发货订单可申请整单退款。</view><view class="field"><text class="label">退款原因</text><textarea placeholder="请简要说明退款原因" maxlength="200" value="{{refundReason}}" bindinput="refundInput" disabled="{{busyId}}" /></view></block>
    <view wx:if="{{refundError}}" class="error" aria-role="alert">{{refundError}}</view>
  </scroll-view>
  <view slot="footer" class="dialog-actions"><button class="secondary" bindtap="closeRefund" disabled="{{busyId}}">关闭</button><button wx:if="{{!refundRecord}}" class="primary" bindtap="requestRefund" disabled="{{busyId}}" loading="{{busyId}}">提交申请</button></view>
</ui-dialog>
