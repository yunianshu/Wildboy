@import "../../styles/slate-theme.wxss";
.block-card {
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 24rpx 0;
}
.block-heading { margin-bottom: 16rpx; font-weight: 600; }
.text-preview {
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
  max-height: 180rpx;
  overflow: hidden;
  line-height: 1.6;
}
.tools, .edit-actions { display: flex; gap: 12rpx; margin: 20rpx 0 0; }
.tools button, .edit-actions button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  padding: 12rpx 8rpx;
  text-align: center;
  line-height: 1.4;
}
.tools button { min-height: 72rpx; font-size: 24rpx; }
.add-tools { margin-bottom: 24rpx; }
.page button.reload { width: 100%; margin-bottom: 20rpx; }
textarea {
  box-sizing: border-box;
  width: 100%;
  height: 320rpx;
  padding: 20rpx;
  border: 1rpx solid var(--rf-soft);
  border-radius: 10rpx;
  background: #FFFFFF;
  color: var(--rf-primary-text);
  font-size: 28rpx;
  line-height: 1.7;
  text-align: left;
}
image { width: 100%; max-height: 400rpx; }
.field image { margin: 20rpx 0; }
.field input { margin-top: 20rpx; }
.table-scroll { width: 100%; margin: 16rpx 0; }
.table-preview { display: table; min-width: 100%; border-collapse: collapse; }
.table-row { display: table-row; }
.table-cell {
  display: table-cell;
  min-width: 140rpx;
  max-width: 360rpx;
  padding: 14rpx;
  border: 1rpx solid var(--rf-soft);
  font-size: 25rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  text-align: left;
}

@import "../../styles/slate-components.wxss";
