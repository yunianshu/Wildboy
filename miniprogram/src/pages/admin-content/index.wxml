<view class="page"><view class="title">图文详情</view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{!authorized}}" class="secondary" bindtap="load">重新加载</button><block wx:if="{{authorized}}">
<block wx:if="{{editing>=0}}"><view class="field"><text class="label">{{draftType==='table'?'表格：每行一条，列用 | 分隔':draftType==='text'?'文字':'图片'}}</text><textarea wx:if="{{draftType!=='image'}}" value="{{draftText}}" data-field="draftText" bindinput="input" maxlength="10000"/><block wx:else><button class="secondary" bindtap="upload" disabled="{{busy}}">上传图片</button><image wx:if="{{draftUrl}}" src="{{draftPreview}}" mode="widthFix"/><input value="{{draftCaption}}" data-field="draftCaption" bindinput="input" maxlength="300" placeholder="图片说明（选填）"/></block></view><button class="primary" bindtap="confirmEdit" disabled="{{busy}}">确认内容</button><button class="secondary" bindtap="cancelEdit" disabled="{{busy}}">取消</button></block>
<block wx:else><view wx:for="{{blocks}}" wx:key="index" class="block-card"><view>{{index+1}} · {{item.type==='text'?'文字':item.type==='image'?'图片':'表格'}}</view><text wx:if="{{item.type==='text'}}">{{item.text}}</text><image wx:elif="{{item.type==='image'}}" src="{{previews[index]}}" mode="widthFix"/><view class="tools"><button data-index="{{index}}" bindtap="edit">编辑</button><button data-index="{{index}}" data-delta="-1" bindtap="move">上移</button><button data-index="{{index}}" data-delta="1" bindtap="move">下移</button><button data-index="{{index}}" bindtap="remove">删除</button></view></view><view class="tools"><button data-type="text" bindtap="add">＋ 文字</button><button data-type="image" bindtap="add">＋ 图片</button><button data-type="table" bindtap="add">＋ 表格</button></view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存图文</button></block></block></view>
