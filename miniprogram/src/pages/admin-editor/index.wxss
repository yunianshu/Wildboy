.cover {
  width: 100%;
  height: 300rpx;
  border-radius: 14rpx;
  margin: 32rpx 0 16rpx;
}
.presets {
  white-space: nowrap;
  margin: 18rpx 0;
}
.preset {
  display: inline-block;
  width: 128rpx;
  height: 94rpx;
  margin-right: 14rpx;
  border: 4rpx solid transparent;
  border-radius: 8rpx;
}
.selected {
  border-color: #193f34;
}
.picker {
  background: #fffdf7;
  border: 1rpx solid #dce1d5;
  border-radius: 10rpx;
  padding: 28rpx 24rpx;
  min-height: 94rpx;
}
.picker text {
  float: right;
}
.date-row {
  display: flex;
  gap: 16rpx;
}
.date-row picker:first-child {
  flex: 1.4;
}
.date-row picker:last-child {
  flex: 1;
}
textarea {
  box-sizing: border-box;
  width: 100%;
  background: #fffdf7;
  border: 1rpx solid #dce1d5;
  border-radius: 10rpx;
  padding: 24rpx;
  height: 180rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
.description {
  height: 360rpx;
}
.actions {
  display: flex;
  gap: 18rpx;
}
.actions button {
  flex: 1;
  margin: 0;
}
.notice button {
  margin-top: 20rpx;
}
.back-space {
  padding-bottom: 220rpx;
}
