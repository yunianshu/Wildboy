.section-head {
  gap: 16rpx;
  margin: 28rpx 0 24rpx;
}
.section-head button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  padding-left: 12rpx;
  padding-right: 12rpx;
}
.tabs {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0;
}
.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  min-height: 76rpx;
  padding: 12rpx 8rpx;
  border-radius: 10rpx;
  background: #e8ecdf;
  font-size: 25rpx;
  line-height: 1.4;
  text-align: center;
}
.tab.active {
  background: #193f34;
  color: #fffdf4;
  font-weight: 600;
}
.cover {
  width: 100%;
  height: 300rpx;
  border-radius: 14rpx;
  margin: 32rpx 0 16rpx;
}
.presets {
  white-space: nowrap;
  margin: 18rpx 0;
}
.preset {
  display: inline-block;
  width: 128rpx;
  height: 94rpx;
  margin-right: 14rpx;
  border: 4rpx solid transparent;
  border-radius: 8rpx;
}
.selected {
  border-color: #193f34;
}
.picker {
  background: #fffdf7;
  border: 1rpx solid #dce1d5;
  border-radius: 10rpx;
  padding: 28rpx 24rpx;
  min-height: 94rpx;
}
.picker text {
  float: right;
}
.date-row {
  display: flex;
  gap: 16rpx;
}
.date-row picker:first-child {
  flex: 1.4;
}
.date-row picker:last-child {
  flex: 1;
}
textarea {
  box-sizing: border-box;
  width: 100%;
  background: #fffdf7;
  border: 1rpx solid #dce1d5;
  border-radius: 10rpx;
  padding: 24rpx;
  height: 180rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
.description {
  height: 360rpx;
}
.actions {
  display: flex;
  gap: 18rpx;
}
.actions button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  padding-left: 12rpx;
  padding-right: 12rpx;
}
.notice button {
  margin-top: 20rpx;
}
.back-space {
  padding-bottom: 220rpx;
}
.confirm-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(15, 35, 27, .48);
}
.confirm-card {
  width: 100%;
  max-width: 620rpx;
  padding: 34rpx;
  border-radius: 18rpx;
  background: #fffdf7;
}
.confirm-card .muted {
  display: block;
  margin: 20rpx 0 28rpx;
}
.confirm-actions {
  display: flex;
  gap: 18rpx;
}
.confirm-actions button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
}
