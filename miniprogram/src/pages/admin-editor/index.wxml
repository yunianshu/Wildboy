<view class="page back-space page-motion {{pageMotionClass}}">
  <view class="title">{{id ? '编辑活动' : '创建活动'}}</view>
  <view class="muted">北京时间 · 免费报名</view>
  <view wx:if="{{loading}}" class="state">正在读取活动…</view>
  <view wx:if="{{error}}" class="notice error">
    {{error}}
    <button wx:if="{{conflict}}" class="secondary" bindtap="reload">
      重新读取
    </button>
    <button wx:if="{{uncertain}}" class="secondary" bindtap="list">
      返回管理列表核对
    </button>
    <button
      wx:if="{{!loading&&!conflict&&!uncertain}}"
      class="secondary"
      bindtap="retry"
    >
      重试
    </button>
    <button wx:if="{{!authorized}}" class="secondary" bindtap="login">
      验证管理员身份
    </button>
  </view>
  <block wx:if="{{authorized&&!loading}}">
    <view class="section-head">
      <button class="secondary" bindtap="uploadCover" disabled="{{busy}}">上传封面</button><button wx:if="{{id}}" class="secondary" bindtap="editContent" disabled="{{busy}}">编辑图文详情</button>
    </view>
    <view class="tabs">
      <view
        wx:for="{{sections}}"
        wx:key="*this"
        class="tab {{section===index?'active':''}}"
        data-section="{{index}}"
        bindtap="sectionChange"
      >
        {{item}}
      </view>
    </view>
    <block wx:if="{{section===0}}">
      <image class="cover" src="{{cover}}" mode="aspectFill" />
      <view class="muted small">示意封面 · 可使用自有 HTTPS 图片</view>
      <scroll-view class="presets" scroll-x>
        <image
          wx:for="{{presets}}"
          wx:key="*this"
          class="preset {{form.coverUrl===item?'selected':''}}"
          src="{{item}}"
          mode="aspectFill"
          data-path="{{item}}"
          bindtap="coverPreset"
        />
      </scroll-view>
      <view class="field"><text>核验身份证（仅必要时开启，并在活动说明中写明用途）</text><switch color="#9E2845" checked="{{form.identityRequired}}" bindchange="identityChange" disabled="{{busy}}" /></view>
      <view class="field">
        <text class="label">活动价格（元 / 人，0 为免费）</text>
        <input type="digit" value="{{price}}" bindinput="priceInput" disabled="{{busy || status !== 'DRAFT' || registeredCount > 0}}" />
        <view class="muted">已保存 ¥{{priceCents / 100}}。先保存活动草稿，再单独保存价格，最后发布。</view>
        <button wx:if="{{status === 'DRAFT'}}" class="secondary" bindtap="savePrice" disabled="{{!id || busy || conflict || uncertain || registeredCount > 0}}">保存价格</button>
      </view>
      <view class="field">
        <text class="label">封面地址</text>
        <input
          value="{{form.coverUrl}}"
          data-field="coverUrl"
          bindinput="input"
          maxlength="2048"
          disabled="{{busy}}"
        />
      </view>
      <view class="field">
        <text class="label">活动名称</text>
        <input
          value="{{form.title}}"
          data-field="title"
          bindinput="input"
          maxlength="120"
          disabled="{{busy}}"
        />
      </view>
      <view class="field">
        <text class="label">活动分类</text>
        <picker
          range="{{categories}}"
          range-key="name"
          value="{{categoryIndex}}"
          bindchange="category"
          disabled="{{busy}}"
        >
          <view class="picker">
            {{categories[categoryIndex].name}}
            <text>›</text>
          </view>
        </picker>
      </view>
    </block>
    <block wx:if="{{section===1}}">
      <view class="field">
        <text class="label">开始时间</text>
        <view class="date-row">
          <picker
            mode="date"
            value="{{form.startDate}}"
            data-field="startDate"
            bindchange="chooseDate"
            disabled="{{busy}}"
          >
            <view class="picker">{{form.startDate||'选择日期'}}</view>
          </picker>
          <picker
            mode="time"
            value="{{form.startTime}}"
            data-field="startTime"
            bindchange="chooseDate"
            disabled="{{busy}}"
          >
            <view class="picker">{{form.startTime}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <text class="label">结束时间</text>
        <view class="date-row">
          <picker
            mode="date"
            value="{{form.endDate}}"
            data-field="endDate"
            bindchange="chooseDate"
            disabled="{{busy}}"
          >
            <view class="picker">{{form.endDate||'选择日期'}}</view>
          </picker>
          <picker
            mode="time"
            value="{{form.endTime}}"
            data-field="endTime"
            bindchange="chooseDate"
            disabled="{{busy}}"
          >
            <view class="picker">{{form.endTime}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <text class="label">报名截止</text>
        <view class="date-row">
          <picker
            mode="date"
            value="{{form.deadlineDate}}"
            data-field="deadlineDate"
            bindchange="chooseDate"
            disabled="{{busy}}"
          >
            <view class="picker">{{form.deadlineDate||'选择日期'}}</view>
          </picker>
          <picker
            mode="time"
            value="{{form.deadlineTime}}"
            data-field="deadlineTime"
            bindchange="chooseDate"
            disabled="{{busy}}"
          >
            <view class="picker">{{form.deadlineTime}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <text class="label">活动地点</text>
        <input
          value="{{form.location}}"
          data-field="location"
          bindinput="input"
          maxlength="200"
          disabled="{{busy}}"
        />
      </view>
      <view class="field">
        <text class="label">集合地点</text>
        <input
          value="{{form.meetingPoint}}"
          data-field="meetingPoint"
          bindinput="input"
          maxlength="200"
          disabled="{{busy}}"
        />
      </view>
      <view class="field">
        <text class="label">活动名额（已报名 {{registeredCount}} 人）</text>
        <input
          type="number"
          value="{{form.capacity}}"
          data-field="capacity"
          bindinput="input"
          maxlength="5"
          disabled="{{busy}}"
        />
      </view>
    </block>
    <block wx:if="{{section===2}}">
      <view class="field">
        <text class="label">活动简介</text>
        <textarea
          value="{{form.summary}}"
          data-field="summary"
          bindinput="input"
          maxlength="300"
          disabled="{{busy}}"
        />
      </view>
      <view class="field">
        <text class="label">活动详情与注意事项</text>
        <textarea
          class="description"
          value="{{form.description}}"
          data-field="description"
          bindinput="input"
          maxlength="20000"
          disabled="{{busy}}"
          placeholder="路线、装备、难度、注意事项等"
        />
      </view>
      <view class="field">
        <text class="label">详情图片（选填，最多 12 张，每行一个地址）</text>
        <textarea
          value="{{form.galleryText}}"
          data-field="galleryText"
          bindinput="input"
          maxlength="25000"
          disabled="{{busy}}"
          placeholder="https://…"
        />
      </view>
    </block>
    <view class="notice">
      修改不会自动通知报名用户，请另行联系。预设配图仅为示意，请核对实际活动。
    </view>
    <view class="sticky-action actions">
      <button
        wx:if="{{section>0}}"
        class="secondary"
        bindtap="previousSection"
        disabled="{{busy}}"
      >
        上一部分
      </button>
      <button
        wx:if="{{section<2}}"
        class="secondary"
        bindtap="nextSection"
        disabled="{{busy}}"
      >
        下一部分
      </button>
      <button
        class="primary"
        data-action="save"
        bindtap="save"
        loading="{{busy}}"
        disabled="{{busy||conflict||uncertain}}"
      >
        {{status==='PUBLISHED'?'保存修改':'保存草稿'}}
      </button>
      <button
        wx:if="{{status==='DRAFT'&&section===2}}"
        class="primary"
        data-action="publish"
        bindtap="save"
        disabled="{{busy||conflict||uncertain}}"
      >
        确认并发布
      </button>
    </view>
  </block>
  <ui-dialog wx:if="{{confirming}}" title="保存并发布活动？" bindclose="cancelPublish" busy="{{busy}}" mask-closable="{{false}}"><scroll-view scroll-y class="ui-confirm-body"><view class="muted">发布后开放浏览和报名。请核对日期、集合点和名额。</view></scroll-view><view slot="footer" class="dialog-actions">
        <button disabled="{{busy}}" class="secondary" bindtap="cancelPublish">返回检查</button>
        <button disabled="{{busy}}" class="primary" bindtap="confirmPublish">确认发布</button>
      </view>
</ui-dialog>
</view>
