<view class="page">
  <view class="eyebrow">WILDBOY / PARTICIPANTS</view>
  <view class="title">报名名单</view>
  <view wx:if="{{error}}" class="state error">
    {{error}}
    <button class="secondary" bindtap="retry">重试</button>
    <button wx:if="{{!authorized}}" class="primary" bindtap="login">
      管理员身份验证
    </button>
  </view>
  <view wx:if="{{loading}}" class="state">正在加载名单…</view>
  <block wx:if="{{authorized&&activity}}">
    <view class="activity-title">{{activity.title}}</view>
    <view class="muted">{{dateText}} · {{activity.location}}</view>
    <view class="summary">
      <view>
        <text>已报名</text>
        <view>{{activity.registeredCount}} 人</view>
      </view>
      <view>
        <text>剩余名额</text>
        <view>{{remaining}} / {{activity.capacity}}</view>
      </view>
    </view>
    <view class="section-head">
      <view class="section-title">报名成员</view>
      <text class="muted small">仅管理员可查看</text>
    </view>
    <view wx:for="{{items}}" wx:key="id" class="member">
      <view class="avatar">{{item.participantName[0]}}</view>
      <view class="member-info">
        <view class="name">{{item.participantName}}</view>
        <button class="phone" data-id="{{item.id}}" bindtap="reveal">
          {{item.maskedPhone}} · 查看
        </button>
        <view class="muted small">{{item.dateText}} 报名</view>
      </view>
      <text class="badge">{{item.statusText}}</text>
    </view>
    <view wx:if="{{!items.length&&!loading&&!error}}" class="state">
      还没有报名记录
    </view>
    <view class="notice">
      成员信息仅用于本次活动联系，请勿外传。点击脱敏号码可查看完整号码。
    </view>
    <button
      wx:if="{{hasMore}}"
      class="secondary more"
      bindtap="retry"
      loading="{{loadingMore}}"
      disabled="{{loadingMore}}"
    >
      加载更多成员
    </button>
    <view wx:else class="loading-line">
      已显示全部 {{total}} 条记录（含取消记录）
    </view>
  </block>
</view>
