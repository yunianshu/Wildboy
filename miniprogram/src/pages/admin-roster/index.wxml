<view class="page">
  <view class="title">报名名单</view>
  <view wx:if="{{error}}" class="state error">
    {{error}}
    <button class="secondary" bindtap="retry">重试</button>
    <button wx:if="{{!authorized}}" class="primary" bindtap="login">
      管理员身份验证
    </button>
  </view>
  <view wx:if="{{loading}}" class="state">正在加载名单…</view>
  <block wx:if="{{authorized&&activity}}">
    <view class="activity-title">{{activity.title}}</view>
    <view class="muted">{{dateText}} · {{activity.location}}</view>
    <view class="summary">
      <view>
        <text>已报名</text>
        <view>{{activity.registeredCount}} 人</view>
      </view>
      <view>
        <text>剩余名额</text>
        <view>{{remaining}} / {{activity.capacity}}</view>
      </view>
    </view>
    <view class="section-head">
      <view class="section-title">报名成员</view>
    </view>
    <view wx:for="{{items}}" wx:key="id" class="member">
      <view class="participant-head">
        <text class="badge">{{item.statusText}}</text>
        <text class="muted small">{{item.dateText}} · {{item.participants.length}} 人</text>
      </view>
      <view
        class="participant-row"
        wx:for="{{item.participants}}"
        wx:for-item="participant"
        wx:key="id"
      >
        <view class="avatar">{{participant.participantName[0]}}</view>
        <view class="member-info">
          <view class="name">{{participant.participantName}}</view>
          <view class="muted small">{{participant.maskedPhone}}</view>
          <view class="muted small">{{participant.maskedId}}</view>
          <button class="phone" data-id="{{participant.id}}" bindtap="reveal">
            查看完整信息
          </button>
        </view>
      </view>
    </view>
    <view wx:if="{{!items.length&&!loading&&!error}}" class="state">
      暂无报名记录
    </view>
    <view class="notice">
      姓名、身份证号和手机号仅用于本次活动核验与联系，请勿外传。
    </view>
    <button
      wx:if="{{hasMore}}"
      class="secondary more"
      bindtap="retry"
      loading="{{loadingMore}}"
      disabled="{{loadingMore}}"
    >
      加载更多成员
    </button>
    <view wx:else class="loading-line">
      已显示全部 {{total}} 条记录（含取消记录）
    </view>
  </block>
</view>
