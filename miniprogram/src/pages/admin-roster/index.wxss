@import "../../styles/slate-theme.wxss";
.tabs {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0 8rpx;
}
.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: var(--rf-soft);
  color: var(--rf-primary-text);
  font-size: 28rpx;
  line-height: 1.4;
  white-space: nowrap;
}
.tab.active {
  background: var(--rf-primary);
  color: var(--rf-on-primary);
  font-weight: 600;
}
.activity-title {
  font-size: 35rpx;
  font-weight: 650;
  line-height: 1.6;
  margin-top: 32rpx;
}
.summary {
  display: flex;
  gap: 40rpx;
  background: var(--rf-primary);
  color: var(--rf-on-primary);
  padding: 30rpx;
  border-radius: 16rpx;
  margin-top: 30rpx;
}
.summary > view {
  flex: 1;
}
.summary text {
  font-size: 23rpx;
  color: var(--rf-soft);
}
.summary > view > view {
  font-size: 40rpx;
  font-weight: 650;
  margin-top: 12rpx;
}
.member {
  background: #FFFFFF;
  padding: 26rpx 22rpx;
  border-radius: 18rpx;
  margin-bottom: 22rpx;
}
.participant-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.participant-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--rf-soft);
}
.avatar {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  background: var(--rf-soft);
  border-radius: 50%;
  flex-shrink: 0;
  font-weight: 650;
}
.member-info {
  flex: 1;
  min-width: 0;
}
.name {
  font-size: 30rpx;
  font-weight: 600;
  word-break: break-all;
}
.phone {
  background: transparent;
  text-align: left;
  padding: 12rpx 0;
  margin: 0;
  line-height: 1.5;
  font-size: 23rpx;
  color: var(--rf-muted);
}
.badge {
  white-space: nowrap;
}
.notice {
  margin-top: 30rpx;
}
.more {
  margin-top: 32rpx;
}

.export {
  margin: 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  color: var(--rf-ink);
  background: var(--rf-bg);
  border-radius: 28rpx;
}

@import "../../styles/slate-components.wxss";
