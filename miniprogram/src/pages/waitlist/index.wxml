<view class="page"><view class="title">我的候补</view><view wx:if="{{!loggedIn}}" class="state">登录后查看候补<button class="primary" bindtap="signIn">微信登录</button></view><block wx:else>
<button class="secondary" bindtap="subscribe">订阅下次微信提醒</button><button class="text-button" bindtap="messages">活动消息</button>
<view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry">刷新</button></view>
<view wx:if="{{confirmId}}" class="wait-card"><view>确认整组报名</view><checkbox-group bindchange="consentChange"><checkbox value="yes" checked="{{consent}}" disabled="{{busy}}"/>我已阅读并同意<text class="legal-link" catchtap="privacy">《隐私政策》</text><text class="legal-link" catchtap="terms">《用户协议》</text></checkbox-group><button class="primary" bindtap="confirm" disabled="{{busy}}">确认报名</button><button bindtap="close" disabled="{{busy}}">取消</button></view>
<view wx:for="{{items}}" wx:key="id" class="wait-card"><view>{{item.activityTitle}}</view><view>{{item.partySize}} 人 · {{item.statusText}}</view><view wx:if="{{item.status === 'OFFERED'}}">确认截止 {{item.deadline}}<button class="primary" data-id="{{item.id}}" bindtap="choose" disabled="{{busy}}">确认名额</button></view><button wx:if="{{item.status === 'WAITING' || item.status === 'OFFERED'}}" class="text-button" data-id="{{item.id}}" bindtap="cancel" disabled="{{busy}}">取消候补</button></view>
<view wx:if="{{!items.length && !loading}}" class="state">暂无候补</view><button wx:if="{{hasMore}}" bindtap="more" disabled="{{loading}}">加载更多</button></block></view>
