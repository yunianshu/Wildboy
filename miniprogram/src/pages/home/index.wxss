.home { padding-bottom: calc(50px + env(safe-area-inset-bottom)); }
.hero {
  height: 440rpx;
  position: relative;
  background: #20372C;
}
.hero-image {
  width: 100%;
  height: 100%;
  position: absolute;
}
.hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(32, 55, 44, 0.24),
    transparent 32%,
    rgba(20, 35, 28, 0.72)
  );
}
.brand {
  position: absolute;
  left: var(--page-gutter, 16px);
  color: #fff;
  display: flex;
  flex-direction: column;
  z-index: 4;
}
.brand-name {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}
.brand-caption {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  margin-top: var(--space-1, 4px);
  opacity: 0.85;
}
.hero-copy {
  position: absolute;
  bottom: 40rpx;
  left: var(--page-gutter, 16px);
  right: var(--page-gutter, 16px);
  color: #fff;
}
.hero-kicker {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  opacity: 0.8;
}
.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -3rpx;
  line-height: 1.2;
  white-space: pre-line;
  max-width: 620rpx;
  margin: var(--space-2, 8px) 0;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.9;
  display: flex;
  justify-content: space-between;
}
.hero-sub text {
  font-size: 40rpx;
}
.home-body {
  padding: 0 var(--page-gutter, 16px);
}
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-3, 12px);
  margin-top: var(--space-5, 24px);
}
.category {
  height: 148rpx;
  position: relative;
  overflow: hidden;
  border-radius: var(--card-radius, 12px);
}
.category image {
  width: 100%;
  height: 100%;
}
.category-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(transparent, rgba(20, 35, 28, 0.65));
}
.category-copy {
  position: absolute;
  bottom: 16rpx;
  left: 4rpx;
  right: 4rpx;
  text-align: center;
  color: #fff;
}
.category-title {
  font-size: 24rpx;
  font-weight: 650;
  white-space: nowrap;
}
.shop {
  height: 250rpx;
  margin: var(--space-5, 24px) calc(-1 * var(--page-gutter, 16px)) 0;
  overflow: hidden;
  position: relative;
  background: #EAF4E7;
}
.shop-banner-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.shop-copy {
  position: absolute;
  top: var(--space-2, 8px);
  left: var(--page-gutter, 16px);
  color: var(--color-primary, #247A52);
}
.shop-tag {
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--color-muted, #5D7064);
}
.shop-title {
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.4;
  margin: var(--space-1, 4px) 0 var(--space-2, 8px);
  white-space: nowrap;
}
.shop-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--button-height, 48px);
  gap: var(--space-3, 12px);
  padding: 0 var(--space-4, 16px);
  border-radius: var(--button-radius, 12px);
  background: var(--color-primary, #247A52);
  color: var(--color-on-primary, #FFFFFF);
  font-size: var(--button-font-size, 14px);
  font-weight: 600;
  line-height: 20px;
}
.equipment-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3, 12px);
  margin-top: var(--space-5, 24px);
}
.equipment-item {
  min-width: 0;
}
.equipment-image {
  width: 100%;
  height: 286rpx;
  border-radius: var(--card-radius, 12px);
  background: #EAF4E7;
}
.equipment-name {
  margin-top: var(--space-2, 8px);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.equipment-price {
  margin-top: var(--space-1, 4px);
  font-size: 29rpx;
  font-weight: 650;
  color: #247A52;
}
.equipment-state {
  min-height: 180rpx;
}
.home-footer {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: center;
  gap: 20rpx 16rpx;
  margin-top: var(--space-5, 24px);
  padding: 24rpx 12rpx 28rpx;
}
.home-footer-single {
  grid-template-columns: minmax(0, 1fr);
}
.home-footer-cell {
  min-width: 0;
  text-align: center;
}
.platform-brand {
  display: flex;
  justify-content: center;
  min-width: 0;
}
.platform-brand-image {
  display: block;
  width: 216px;
  max-width: 100%;
  height: auto;
}

.home-body .section-head { margin-top: var(--space-5, 24px); }
.home-body .activity-image { height: 212rpx; }
.home-body .card-meta { letter-spacing: 0; }
.home-body .card-detail {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.home-body .card-footer { flex-wrap: wrap; gap: var(--space-3, 12px); }
.scenery-swiper { height: 330rpx; border-radius: var(--card-radius, 12px); overflow: hidden; }
.scenery-slide { position: relative; height: 100%; background: #20372C; }
.scenery-image { width: 100%; height: 100%; }
.scenery-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(transparent 20%, rgba(20, 35, 28, .75));
}
.scenery-badge {
  position: absolute;
  top: 20rpx;
  left: 24rpx;
  z-index: 2;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(16, 32, 24, 0.72);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}
.scenery-badge-video {
  background: rgba(18, 92, 62, 0.9);
}
.scenery-play {
  position: absolute;
  top: 44%;
  left: 50%;
  z-index: 2;
  transform: translate(-50%, -50%);
  width: 84rpx;
  height: 84rpx;
  border-radius: 999rpx;
  background: rgba(16, 32, 24, 0.62);
  border: 3rpx solid rgba(255, 255, 255, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
}
.scenery-play-triangle {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 26rpx solid #fff;
}
.scenery-copy { position: absolute; left: var(--page-gutter, 16px); right: var(--page-gutter, 16px); bottom: 52rpx; color: #fff; }
.scenery-title { font-size: 36rpx; font-weight: 650; }
.scenery-sub { font-size: 21rpx; margin-top: var(--space-1, 4px); line-height: 1.5; }

.video-mask {
  position: fixed;
  inset: 0;
  z-index: 1010;
  background: rgba(10, 18, 14, 0.82);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 24rpx;
}
.video-dialog {
  width: 100%;
  max-width: 680rpx;
  border-radius: 16px;
  background: #14221b;
  color: #fff;
  overflow: hidden;
  padding: 24rpx;
  box-sizing: border-box;
}
.video-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.video-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gallery-video-player {
  width: 100%;
  height: 420rpx;
  border-radius: 10px;
  background: #000;
}
.video-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.5;
}
.video-footer {
  margin-top: 20rpx;
}
.video-action-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #1d6b4b;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.equipment-original-price { font-size:12px; color:#5D7064; text-decoration:line-through; line-height:1.5; margin-top:4px; }

.equipment-item { display:flex; flex-direction:column; }
.equipment-image { flex-shrink:0; }
.equipment-price-stack { margin-top:auto; }

.category-title { overflow: hidden; text-overflow: ellipsis; }
.scenery-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.scenery-sub { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.shop-cta .ui-icon { width: 24px; height: 24px; }
.home-body .section-head { margin-bottom: var(--space-3, 12px); }

.shortcut-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: var(--rf-overlay, rgba(32, 55, 44, 0.4));
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 32rpx;
}
.shortcut-dialog {
  width: 100%;
  max-width: 600rpx;
  max-height: calc(100vh - 48px);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: #fff;
  border-radius: 24rpx;
  padding: 16px;
}
.shortcut-heading {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  gap: 8px;
}
.shortcut-title {
  flex: 1;
  min-width: 0;
  font-size: 18px;
  font-weight: 650;
  line-height: 1.4;
  overflow-wrap: anywhere;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
button.shortcut-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  min-height: 44px;
  margin: 0;
  padding: 10px;
  border: 0;
  background: transparent;
}
.shortcut-close::after { border: 0; }
.shortcut-close image { width: 24px; height: 24px; }
.shortcut-body {
  min-height: 0;
  flex-shrink: 1;
}
.shortcut-content { display: flex; flex-direction: column; gap: 12px; }
.shortcut-multi-qr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.shortcut-qr-card { padding: 10px; border-radius: 16rpx; background: #F6F8F3; display: flex; flex-direction: column; align-items: center; gap: 6px; }
.shortcut-qr-label { font-size: 13px; font-weight: 600; color: #20372C; text-align: center; }
.shortcut-image { width: 100%; display: block; flex-shrink: 0; }
.shortcut-text, .shortcut-message {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.7;
}
.shortcut-message { color: var(--color-muted, #5D7064); font-size: 14px; }

.follow-card {
  text-align: center;
  overflow-wrap: anywhere;
}
.follow-title {
  font-size: 24rpx;
  font-weight: 650;
  color: var(--color-ink, #20372c);
}
.follow-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--color-muted, #5d7064);
}
.follow-qr-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.follow-qr-image {
  box-sizing: border-box;
  display: block;
  width: 184rpx;
  max-width: 100%;
  height: 184rpx;
  padding: 4rpx;
  background: #fff;
}
.follow-qr-label {
  font-size: 23rpx;
  line-height: 1.4;
  color: var(--color-ink, #20372c);
}
