.home { padding-bottom: calc(50px + env(safe-area-inset-bottom)); }
.hero {
  height: 440rpx;
  position: relative;
  background: #20372C;
}
.hero-image {
  width: 100%;
  height: 100%;
  position: absolute;
}
.hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(32, 55, 44, 0.24),
    transparent 32%,
    rgba(20, 35, 28, 0.72)
  );
}
.brand {
  position: absolute;
  left: var(--page-gutter, 16px);
  color: #fff;
  display: flex;
  flex-direction: column;
  z-index: 4;
}
.brand-name {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}
.brand-caption {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  margin-top: var(--space-1, 4px);
  opacity: 0.85;
}
.hero-copy {
  position: absolute;
  bottom: 40rpx;
  left: var(--page-gutter, 16px);
  right: var(--page-gutter, 16px);
  color: #fff;
}
.hero-kicker {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  opacity: 0.8;
}
.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -3rpx;
  line-height: 1.2;
  white-space: pre-line;
  max-width: 620rpx;
  margin: var(--space-2, 8px) 0;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.9;
  display: flex;
  justify-content: space-between;
}
.hero-sub text {
  font-size: 40rpx;
}
.home-body {
  padding: 0 var(--page-gutter, 16px);
}
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-3, 12px);
  margin-top: var(--space-5, 24px);
}
.category {
  height: 148rpx;
  position: relative;
  overflow: hidden;
  border-radius: var(--card-radius, 12px);
}
.category image {
  width: 100%;
  height: 100%;
}
.category-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(transparent, rgba(20, 35, 28, 0.65));
}
.category-copy {
  position: absolute;
  bottom: 16rpx;
  left: 4rpx;
  right: 4rpx;
  text-align: center;
  color: #fff;
}
.category-title {
  font-size: 24rpx;
  font-weight: 650;
  white-space: nowrap;
}
.shop {
  height: 250rpx;
  margin: var(--space-5, 24px) calc(-1 * var(--page-gutter, 16px)) 0;
  overflow: hidden;
  position: relative;
  background: #EAF4E7;
}
.shop-banner-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.shop-copy {
  position: absolute;
  top: var(--space-2, 8px);
  left: var(--page-gutter, 16px);
  color: var(--color-primary, #247A52);
}
.shop-tag {
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--color-muted, #5D7064);
}
.shop-title {
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.4;
  margin: var(--space-1, 4px) 0 var(--space-2, 8px);
  white-space: nowrap;
}
.shop-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--button-height, 48px);
  gap: var(--space-3, 12px);
  padding: 0 var(--space-4, 16px);
  border-radius: var(--button-radius, 12px);
  background: var(--color-primary, #247A52);
  color: var(--color-on-primary, #FFFFFF);
  font-size: var(--button-font-size, 14px);
  font-weight: 600;
  line-height: 20px;
}
.equipment-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3, 12px);
  margin-top: var(--space-5, 24px);
}
.equipment-item {
  min-width: 0;
}
.equipment-image {
  width: 100%;
  height: 286rpx;
  border-radius: var(--card-radius, 12px);
  background: #EAF4E7;
}
.equipment-name {
  margin-top: var(--space-2, 8px);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.equipment-price {
  margin-top: var(--space-1, 4px);
  font-size: 29rpx;
  font-weight: 650;
  color: #247A52;
}
.equipment-state {
  min-height: 180rpx;
}
.platform-brand {
  display: flex;
  justify-content: center;
  margin-top: var(--space-4, 16px);
  padding: var(--space-2, 8px) 0 var(--space-3, 12px);
}
.platform-brand-image {
  display: block;
  width: 216px;
  max-width: 100%;
  height: auto;
}

.home-body .section-head { margin-top: var(--space-5, 24px); }
.home-body .activity-image { height: 212rpx; }
.home-body .card-meta { letter-spacing: 0; }
.home-body .card-detail {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.home-body .card-footer { flex-wrap: wrap; gap: var(--space-3, 12px); }
.scenery-swiper { height: 330rpx; border-radius: var(--card-radius, 12px); overflow: hidden; }
.scenery-slide { position: relative; height: 100%; background: #20372C; }
.scenery-image { width: 100%; height: 100%; }
.scenery-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(transparent 20%, rgba(20, 35, 28, .75));
}
.scenery-copy { position: absolute; left: var(--page-gutter, 16px); right: var(--page-gutter, 16px); bottom: 52rpx; color: #fff; }
.scenery-title { font-size: 36rpx; font-weight: 650; }
.scenery-sub { font-size: 21rpx; margin-top: var(--space-1, 4px); line-height: 1.5; }

.equipment-original-price { font-size:12px; color:#5D7064; text-decoration:line-through; line-height:1.5; margin-top:4px; }

.equipment-item { display:flex; flex-direction:column; }
.equipment-image { flex-shrink:0; }
.equipment-price-stack { margin-top:auto; }

.category-title { overflow: hidden; text-overflow: ellipsis; }
.scenery-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.scenery-sub { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.shop-cta .ui-icon { width: 24px; height: 24px; }
.home-body .section-head { margin-bottom: var(--space-3, 12px); }

.shortcut-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.shortcut-dialog {
  width: 100%;
  max-width: 600rpx;
  max-height: 80vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: #fff;
  border-radius: 24rpx;
  padding: 16px;
}
.shortcut-heading {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  gap: 8px;
}
.shortcut-title {
  flex: 1;
  min-width: 0;
  font-size: 18px;
  font-weight: 650;
  line-height: 1.4;
  overflow-wrap: anywhere;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
button.shortcut-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  min-height: 44px;
  margin: 0;
  padding: 10px;
  border: 0;
  background: transparent;
}
.shortcut-close::after { border: 0; }
.shortcut-close image { width: 24px; height: 24px; }
.shortcut-body {
  min-height: 0;
  max-height: calc(80vh - 88px);
  flex-shrink: 1;
}
.shortcut-content { display: flex; flex-direction: column; gap: 12px; }
.shortcut-image { width: 100%; display: block; flex-shrink: 0; }
.shortcut-text, .shortcut-message {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.7;
}
.shortcut-message { color: var(--color-muted, #5D7064); font-size: 14px; }
