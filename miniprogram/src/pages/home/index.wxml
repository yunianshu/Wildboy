<view class="home page-motion {{pageMotionClass}}">
  <view class="hero">
    <image class="hero-image" src="/assets/hero-hiking.jpg" mode="aspectFill" />
    <view class="hero-shade" />
    <view class="hero-copy">
      <text class="hero-kicker">WILDBOY / OUTDOOR CLUB</text>
      <view class="hero-title">去山野，找回自己。</view>
      <view class="hero-sub">把日常留在身后 · 一起走出去</view>
    </view>
    <view class="brand" style="top:{{topInset}}px">
      <text class="brand-name">野小子</text>
      <text class="brand-caption">野一点，自由一点</text>
    </view>
  </view>
  <view class="home-body">
    <view wx:if="{{devMode}}" class="notice">
      开发演示账号 · 非真实用户
    </view>
    <ui-state wx:if="{{shortcutLoading}}" kind="loading" compact="{{true}}">正在加载首页入口…</ui-state>
    <ui-state wx:if="{{shortcutError}}" kind="error" compact="{{true}}">入口加载失败：{{shortcutError}}<button class="secondary" bindtap="retryShortcuts">重试</button></ui-state>
    <view class="category-grid" aria-busy="{{shortcutLoading}}">
      <view
        class="category"
        wx:for="{{categories}}"
        wx:key="slot"
        data-slot="{{item.slot}}"
        aria-label="{{item.name}}"
        aria-role="button"
        bindtap="openCategory"
      >
        <image src="{{item.image}}" mode="aspectFill" />
        <view class="category-shade" />
        <view class="category-copy">
          <view class="category-title">
            {{item.name}}
          </view>
        </view>
      </view>
    </view>
    <view class="section-head">
      <view>
        <view class="eyebrow">FIND YOUR NEXT ADVENTURE</view>
        <view class="section-title">正在发生的山野</view>
      </view>
      <text class="section-link" bindtap="allActivities">全部</text>
    </view>
    <ui-state wx:if="{{error}}" kind="error">
      <view>{{error}}</view>
      <button class="secondary" bindtap="retry">重新加载</button>
    </ui-state>
    <ui-state wx:elif="{{loading}}" kind="loading">正在加载活动…</ui-state>
    <block wx:else>
      <ui-state wx:if="{{!items.length}}" kind="empty">
        暂无活动
      </ui-state>
      <view class="grid">
        <view
          class="activity-card"
          wx:for="{{items}}"
          wx:key="slotKey"
          data-id="{{item.id}}"
          bindtap="openActivity"
        >
          <image
            class="activity-image"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            lazy-load
          />
          <view class="card-meta">
            {{item.categoryName}} · {{item.dateText}}
          </view>
          <view class="card-title">{{item.title}}</view>
          <view class="card-detail">{{item.location}}</view>
          <view class="card-footer">
            <text class="free">{{item.priceLabel}}</text>
            <text class="muted">{{item.available}} 个余位</text>
          </view>
        </view>
      </view>
    </block>
    <view class="section-head gallery-head">
      <view>
        <view class="eyebrow">MOMENTS OUTSIDE</view>
        <view class="section-title">山野之间</view>
      </view>
    </view>
    <ui-state wx:if="{{articleError}}" kind="error" compact="{{true}}">{{articleError}}<button class="secondary" bindtap="retryArticles">重试</button></ui-state>
    <swiper class="scenery-swiper" autoplay="{{true}}" circular interval="5000" duration="700" indicator-dots indicator-color="rgba(255,255,255,.4)" indicator-active-color="#fff">
      <swiper-item wx:for="{{articles.length ? articles : banners}}" wx:key="id">
        <view class="scenery-slide" data-id="{{articles.length ? item.id : item.activityId}}" data-article="{{articles.length > 0}}" bindtap="openGalleryItem">
          <image class="scenery-image" src="{{articles.length ? item.coverUrl : item.imageUrl}}" mode="aspectFill" lazy-load />
          <view class="scenery-shade" />
          <view class="scenery-copy">
            <view class="scenery-title">{{item.title}}</view>
            <view class="scenery-sub">{{articles.length ? item.summary : item.subtitle}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="platform-brand">
      <image class="platform-brand-image" src="/assets/platform-brand-original-transparent.png" mode="widthFix" lazy-load aria-label="野小子户外平台标识" />
    </view>
  </view>
</view>

<view wx:if="{{popup}}" class="shortcut-mask" catchtap="closePopup" catchtouchmove="keepPopup">
  <view class="shortcut-dialog motion-dialog-enter" catchtap="keepPopup" aria-role="dialog" aria-label="{{popup.title}}">
    <view class="shortcut-title">{{popup.title}}</view>
    <scroll-view scroll-y class="shortcut-body">
      <image wx:if="{{popup.image && !popupImageError}}" class="shortcut-image" src="{{popup.image}}" mode="widthFix" show-menu-by-longpress data-generation="{{popupGeneration}}" binderror="popupImageFailed" />
      <ui-state wx:if="{{popupImageError}}" kind="error">图片加载失败，请关闭后重试</ui-state>
      <view wx:if="{{popup.text}}" class="shortcut-text">{{popup.text}}</view>
      <ui-state wx:if="{{!popup.image && !popup.text}}" kind="empty">暂未配置内容，请联系主理人在后台上传二维码或设置弹窗内容。</ui-state>
    </scroll-view>
    <button class="secondary" bindtap="closePopup">关闭</button>
  </view>
</view>
