<view class="page notifications-page page-motion {{pageMotionClass}}">
  <view class="title">活动消息</view>
  <view class="muted page-intro">活动变更与报名结果会在这里显示。</view>
  <ui-state wx:if="{{!loggedIn}}" kind="empty">登录后查看消息<button class="primary ui-button ui-button-block" bindtap="signIn">微信登录</button></ui-state>
  <block wx:else>
    <button class="secondary subscribe" bindtap="subscribe" disabled="{{busy || loading}}" loading="{{busy}}">订阅下次微信提醒</button>
    <ui-state wx:if="{{loading}}" kind="loading" compact="{{!!items.length}}">正在读取活动消息…</ui-state>
    <view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="retry">重试</button></view>
    <view wx:for="{{items}}" wx:key="id" class="notice-card" data-id="{{item.activityId}}" bindtap="open" hover-class="notice-card-pressed" aria-role="button" aria-label="查看活动：{{item.title}}">
      <view class="notice-title">{{item.title}}</view>
      <view class="notice-detail">{{item.detail}}</view>
      <view class="notice-meta"><text>{{item.statusText}}</text><text wx:if="{{item.timeText}}"> · {{item.timeText}}</text></view>
    </view>
    <ui-state wx:if="{{!items.length && !loading && !error}}" kind="empty">暂无消息</ui-state>
    <button wx:if="{{hasMore}}" class="secondary" bindtap="more" disabled="{{loading}}">加载更多</button>
  </block>
</view>
