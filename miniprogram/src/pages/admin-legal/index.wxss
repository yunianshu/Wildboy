@import "../../styles/slate-theme.wxss";
.legal-page {
  padding: 40rpx 36rpx 70rpx;
  background: var(--rf-bg);
  min-height: 100vh;
  color: var(--rf-ink);
}
.title {
  font-size: 52rpx;
  font-weight: 700;
  margin-top: 16rpx;
}
.intro {
  font-size: 25rpx;
  color: var(--rf-muted);
  line-height: 1.8;
  margin: 20rpx 0;
}
.tabs,
.actions {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 0;
}
.tabs button,
.actions button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  font-size: 27rpx;
}
.tabs button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 12rpx 16rpx;
  line-height: 1.4;
  background: var(--rf-soft);
  color: var(--rf-ink);
}
.tabs .active,
.primary {
  background: var(--rf-ink);
  color: #FFFFFF;
}
.secondary {
  background: var(--rf-soft);
  color: var(--rf-ink);
}
.version {
  font-size: 26rpx;
  font-weight: 600;
  margin: 32rpx 0;
}
.note,
.notice {
  padding: 24rpx;
  background: var(--rf-soft);
  line-height: 1.8;
  font-size: 25rpx;
  border-radius: 16rpx;
}
.label {
  font-size: 28rpx;
  font-weight: 600;
  margin: 30rpx 0 16rpx;
}
.input,
.content {
  background: #FFFFFF;
  border: 1rpx solid var(--rf-line);
  border-radius: 14rpx;
  padding: 22rpx;
  box-sizing: border-box;
  width: 100%;
  font-size: 28rpx;
}
.input {
  height: 88rpx;
}
.content {
  height: 650rpx;
  line-height: 1.8;
}
.count {
  font-size: 23rpx;
  color: var(--rf-muted);
  margin: 16rpx 0;
}
.error {
  background: var(--rf-danger-bg);
  color: var(--rf-danger);
  padding: 24rpx;
  line-height: 1.8;
  font-size: 26rpx;
  border-radius: 14rpx;
}
.state {
  padding: 28rpx 0;
  color: var(--rf-muted);
  font-size: 26rpx;
  line-height: 1.8;
}
.section-title {
  font-weight: 700;
  font-size: 32rpx;
  margin: 30rpx 0 20rpx;
}
.preview {
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  word-break: break-all;
}
.plain {
  font-size: 27rpx;
  white-space: pre-wrap;
  line-height: 1.9;
}
.legal-page button.history {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 76rpx;
  word-break: break-all;
  text-align: left;
  background: var(--rf-soft);
  color: var(--rf-ink);
  font-size: 25rpx;
  margin: 16rpx 0;
  white-space: normal;
  line-height: 1.7;
  padding: 20rpx;
}
button[disabled] {
  opacity: 0.45;
}

@import "../../styles/slate-components.wxss";
