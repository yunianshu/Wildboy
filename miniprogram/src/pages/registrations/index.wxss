@import "../../styles/slate-theme.wxss";
@import "../../styles/section-tabs.wxss";
@import "../../styles/user-flow.wxss";
.record {
  background: #FFFFFF;
  padding: 30rpx;
  border-radius: 18rpx;
  margin: 24rpx 0;
}
.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.record-title {
  font-weight: 600;
  font-size: 16px;
  line-height: 1.5;
  margin: 12px 0 8px;
  overflow-wrap: anywhere;
}
.record button {
  margin-top: 28rpx;
}
.cancelled {
  background: var(--rf-soft);
  color: var(--rf-muted);
}
.notice {
  margin-top: 24rpx;
}

@import "../../styles/slate-components.wxss";

.registrations-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.registrations-heading .text-button { flex-shrink: 0; padding-right: 0; }
.registrations-page .record > button { width: 100%; }

.registration-tabs { margin-top: 16px; }
