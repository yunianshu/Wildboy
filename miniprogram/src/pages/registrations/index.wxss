@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.filters {
  display: flex;
  gap: 14rpx;
  margin: 34rpx 0;
}
.filter {
  flex: 1;
  text-align: center;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  background: var(--rf-soft);
  color: var(--rf-muted);
}
.filter.active {
  background: var(--rf-primary);
  color: var(--rf-on-primary);
}
.record {
  background: #FFFFFF;
  padding: 30rpx;
  border-radius: 18rpx;
  margin: 24rpx 0;
}
.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.record-title {
  font-weight: 650;
  font-size: 34rpx;
  line-height: 1.5;
  margin: 24rpx 0 14rpx;
}
.record button {
  margin-top: 28rpx;
}
.cancelled {
  background: var(--rf-soft);
  color: var(--rf-muted);
}
.notice {
  margin-top: 24rpx;
}

@import "../../styles/slate-components.wxss";
