@import "../../styles/slate-theme.wxss";
/* 活动订单与退款管理 · 对照 Pen 画板「小程序管理 / 活动订单与退款」(sreFA) */
.admin-activity-orders-page .title { margin-bottom: 8rpx; }
.toolbar { display: flex; gap: 16rpx; margin-top: 20rpx; }
.toolbar button { margin-top: 0; }

.order-card, .refund-card { padding: 26rpx; margin-top: 26rpx; border-radius: 16rpx; background: #FFFFFF; word-break: break-all; }
.order-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 12rpx; }
.order-title { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.order-meta { margin-bottom: 6rpx; }
.order-number { margin-top: 4rpx; color: var(--rf-muted); font-size: 21rpx; word-break: break-all; }

.admin-activity-orders-page .badge.wait { background: var(--rf-warning-bg); color: var(--rf-warning); }
.admin-activity-orders-page .badge.ok { background: var(--rf-bg); color: var(--rf-primary-text); }
.admin-activity-orders-page .badge.neutral { background: var(--rf-bg); color: var(--rf-muted); }

.order-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.sub-actions { flex-wrap: wrap; }
.small-button { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; min-height: 72rpx; padding: 10rpx 12rpx; line-height: 1.4; font-size: 25rpx; text-align: center; }
.danger { background: var(--rf-bg); color: var(--rf-danger); min-height: 72rpx; font-weight: 600; }

.participants { margin-top: 18rpx; padding: 18rpx; border-radius: 12rpx; background: var(--rf-bg); }
.participant-row { padding: 6rpx 0; display: flex; flex-direction: column; gap: 2rpx; }
.participant-name { font-weight: 600; }
.participants .reveal { margin-top: 12rpx; }

.panel-title { font-size: 29rpx; font-weight: 600; margin-bottom: 10rpx; word-break: break-all; }
.refund-status { font-size: 29rpx; font-weight: 600; margin-bottom: 6rpx; }
.refund-request, .refund-card > block { margin-top: 6rpx; }
.refund-textarea { width: 100%; box-sizing: border-box; min-height: 128rpx; margin: 14rpx 0; padding: 14rpx; background: #FFFFFF; border: 1rpx solid var(--rf-soft); border-radius: 10rpx; font-size: 26rpx; }
.refund-card button { margin-top: 12rpx; }
.refund-card .order-actions button { margin-top: 0; }
.refund-card .muted { margin: 6rpx 0; }
.admin-activity-orders-page .more { margin-top: 26rpx; }

.confirm-mask { position: fixed; inset: 0; background: var(--rf-overlay); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 32rpx; }
.confirm-card { background: #FFFFFF; border-radius: 20rpx; padding: 32rpx; width: 100%; max-width: 620rpx; word-break: break-all; }
.confirm-body { margin: 14rpx 0 6rpx; }

@import "../../styles/slate-components.wxss";
