.addresses-page .title {
  margin-bottom: 32rpx;
}
.address-card {
  background: #fff;
  padding: 28rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}
.address-name {
  font-size: 30rpx;
  font-weight: 600;
}
.address-name text {
  margin-left: 16rpx;
}
.address-name .default-tag {
  color: #486b45;
  font-size: 22rpx;
}
.address-detail {
  font-size: 27rpx;
  line-height: 1.6;
  margin: 18rpx 0;
  word-break: break-all;
}
.address-actions,
.default-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.address-actions button {
  margin: 0;
  padding: 0 18rpx;
  font-size: 25rpx;
}
.address-actions .select-address {
  margin-left: auto;
  background: #193f34;
  color: white;
}
.default-row {
  justify-content: space-between;
  margin: 24rpx 0;
}
.addresses-page .primary,
.addresses-page .secondary {
  margin-top: 24rpx;
}
