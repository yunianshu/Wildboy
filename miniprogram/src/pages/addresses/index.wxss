@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.addresses-page .title {
  margin-bottom: 32rpx;
}
.address-field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.address-field-header .label {
  margin: 0;
}
.address-field-header .locate-address {
  display: flex;
  align-items: center;
  min-height: 44px;
  margin: 0;
  padding: 0 8px;
  line-height: 1.4;
  font-size: 14px;
  background: transparent;
  color: var(--rf-primary-text);
}
.location-error {
  margin-top: 8px;
}
.addresses-page textarea {
  box-sizing: border-box;
  width: 100%;
  height: 168rpx;
  padding: 20rpx;
  border: 1rpx solid var(--rf-soft);
  border-radius: 10rpx;
  background: #FFFFFF;
  color: var(--rf-primary-text);
  font-size: 30rpx;
  line-height: 1.5;
  text-align: left;
}
.address-card {
  background: #FFFFFF;
  padding: 28rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}
.address-name {
  font-size: 30rpx;
  font-weight: 600;
}
.address-name text {
  margin-left: 16rpx;
}
.address-name .default-tag {
  color: var(--rf-muted);
  font-size: 22rpx;
}
.address-detail {
  font-size: 27rpx;
  line-height: 1.6;
  margin: 18rpx 0;
  word-break: break-all;
}
.address-actions,
.default-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.address-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  line-height: 1.4;
  text-align: center;
  margin: 0;
  padding: 10rpx 18rpx;
  font-size: 25rpx;
}
.address-actions .select-address {
  margin-left: auto;
  background: var(--rf-primary);
  color: white;
}
.default-row {
  justify-content: space-between;
  margin: 24rpx 0;
}
.addresses-page .primary,
.addresses-page .secondary {
  margin-top: 16rpx;
}

@import "../../styles/slate-components.wxss";
