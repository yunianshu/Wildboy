@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.addresses-page .title {
  margin-bottom: 32rpx;
}
.address-field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.address-field-header .label {
  margin: 0;
}
.address-field-header .locate-address {
  display: flex;
  align-items: center;
  min-height: 44px;
  margin: 0;
  padding: 0 8px;
  line-height: 1.4;
  font-size: 14px;
  background: transparent;
  color: var(--rf-primary-text);
}
.location-error {
  margin-top: 8px;
}
.addresses-page textarea {
  box-sizing: border-box;
  width: 100%;
  height: 168rpx;
  padding: 20rpx;
  border: 1px solid var(--rf-field-line);
  border-radius: 8px;
  background: var(--rf-surface);
  color: var(--rf-ink);
  font-size: 14px;
  line-height: 1.5;
  text-align: left;
}
.address-card.address-selected { background: var(--rf-soft); border-color: var(--rf-primary); }
.address-card {
  background: var(--rf-surface);
  padding: 16px;
  border-radius: 12px;
  margin-bottom: 12px;
}
.address-name {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px 8px;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.address-name text { margin: 0; }
.address-name .default-tag {
  padding: 2px 6px;
  border-radius: 4px;
  background: var(--rf-soft);
  color: var(--rf-muted);
  font-size: 11px;
  font-weight: 400;
}
.address-detail {
  margin: 8px 0 12px;
  color: var(--rf-muted);
  font-size: 13px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.address-actions,
.default-row {
  display: flex;
  align-items: center;
  gap: 12px;
}
.address-actions { justify-content: space-between; }
.address-secondary-actions { display: flex; flex: 1; gap: 4px; min-width: 0; }
.addresses-page .address-actions .text-button {
  flex: 0 1 auto;
  min-width: 52px;
  min-height: 44px;
  margin: 0;
  padding: 8px;
  font-size: 13px;
}
.addresses-page .address-actions .danger-text { color: var(--rf-danger); }
.address-actions .select-address {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  max-width: 56%;
  min-height: 44px;
  margin: 0 0 0 auto;
  padding: 8px 12px;
  border-radius: 8px;
  background: var(--rf-primary);
  color: var(--rf-on-primary);
  font-size: 13px;
  line-height: 1.4;
  text-align: center;
  white-space: normal;
}
.default-row {
  justify-content: space-between;
  margin: 24rpx 0;
}
.addresses-page .primary,
.addresses-page .secondary {
  margin-top: 16rpx;
}

@import "../../styles/slate-components.wxss";
