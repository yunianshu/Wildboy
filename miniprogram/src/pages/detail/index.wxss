@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.article-page { padding-bottom: calc(110px + env(safe-area-inset-bottom)); background: var(--rf-bg); }
/* Native navigation stays above this cover; do not position into its capsule area. */
.article-cover-wrap { position: relative; }
.article-cover { width: 100%; height: 46vw; max-height: 240px; background: var(--rf-soft); }
.article-head { padding: 18px 16px 0; background: var(--rf-surface); }
.article-title { color: var(--rf-ink); font-size: 24px; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.article-meta { margin-top: 8px; color: var(--rf-muted); font-size: 12px; line-height: 1.6; }
/* The native share button imposes its own width. Keep this icon control square. */
button.share { position: absolute; top: 12px; right: 16px; z-index: 2; display: flex; align-items: center; justify-content: center; width: 44px !important; min-width: 44px !important; max-width: 44px; height: 44px; min-height: 44px; padding: 0; margin: 0; line-height: 1; border: 1px solid var(--rf-line); border-radius: 50%; background: var(--rf-surface); box-shadow: 0 2px 8px rgba(32, 55, 44, .12); }
.share::after { border: 0; }
.share-pressed { background: var(--rf-soft); }
.share-icon { width: 22px; height: 22px; }
.article-intro { padding: 10px 16px 18px; background: var(--rf-surface); color: var(--rf-ink); font-size: 15px; line-height: 1.75; overflow-wrap: anywhere; }
.article-gallery { width: 100%; white-space: nowrap; }
.gallery-strip { display: inline-flex; gap: 8px; padding: 2px 16px 16px; vertical-align: top; }
.gallery-strip image { width: 132px; height: 88px; border-radius: 8px; background: var(--rf-soft); }
.article-section { margin: 12px 16px 0; border-radius: 12px; background: var(--rf-surface); overflow: hidden; }
.section-bar { padding: 16px 16px 8px; font-size: 18px; font-weight: 600; color: var(--rf-ink); }
.section-body { padding: 4px 16px 16px; font-size: 14px; line-height: 1.75; color: var(--rf-ink); }
.fact-row { display: grid; grid-template-columns: 4.5em minmax(0, 1fr); gap: 8px; align-items: baseline; padding: 7px 0; overflow-wrap: anywhere; }
.fact-row + .fact-row { border-top: 1px solid var(--rf-line); }
.fact-label { color: var(--rf-muted); }
.fact-price { color: var(--rf-primary-text); font-weight: 600; }
.fee-note { display: block; color: var(--rf-muted); font-size: 12px; }
.signup-copy { display: block; }
.registration-count { margin-bottom: 8px; font-weight: 600; color: var(--rf-primary-text); }
.participant-line { padding: 4px 0; }
.article-page > .notice { margin: 12px 16px 0; padding: 12px; }
.article-page .sticky-action button { width: 100%; }

.section-bar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px 8px;
  flex-wrap: wrap;
  padding-top: 12px;
}
.nav-entry-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-height: 44px;
  padding: 0 4px;
  border-radius: 6px;
  color: var(--rf-primary-text);
  font-size: 12px;
  font-weight: 600;
}
.nav-pin-icon {
  width: 14px;
  height: 14px;
}
.nav-fact-row {
  min-height: 44px;
  align-items: center;
  cursor: pointer;
}
.nav-fact-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-width: 0;
}
.address-text {
  min-width: 0;
  white-space: pre-line;
  overflow-wrap: anywhere;
}
.nav-action-tag {
  flex-shrink: 0;
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--rf-soft);
  color: var(--rf-primary-text);
  font-size: 12px;
  font-weight: 600;
  line-height: 1.5;
}
.boarding-fact-block { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 0; }
button.boarding-stops-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  min-height: 44px;
  margin: 0;
  padding: 6px 2px 6px 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--rf-primary-text);
  font: inherit;
  font-weight: 600;
  text-align: left;
}
button.boarding-stops-toggle::after { border: 0; }
button.boarding-stops-toggle.action-pressed { background: var(--rf-soft); }
.boarding-stop-chevron {
  flex: 0 0 7px;
  height: 7px;
  margin-right: 4px;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  transform: rotate(45deg);
}
.boarding-stop-chevron-up { transform: rotate(225deg); }
.boarding-stop-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 100%;
  padding-bottom: 7px;
}
.boarding-stop-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 8px;
  min-height: 44px;
  border-radius: 8px;
  background: var(--rf-bg);
}
.boarding-stop-name {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  color: var(--rf-ink);
  font-size: 14px;
}
.action-pressed { background: var(--rf-soft); }

/* Confirmed Attendees Avatars & Nicknames */
.attendee-toggle {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  font-size: 13px;
  font-weight: 500;
  color: var(--rf-primary-text);
}
.attendee-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px 10px;
}
.attendee-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  min-width: 0;
}
.attendee-avatar-wrap {
  position: relative;
  width: 48px;
  height: 48px;
}
.attendee-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--rf-soft);
}
.attendee-avatar-fallback {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--rf-soft);
  color: var(--rf-primary-text);
  font-size: 16px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.attendee-party-badge {
  position: absolute;
  right: -4px;
  bottom: -2px;
  padding: 0 5px;
  border-radius: 999px;
  background: var(--rf-primary-text);
  color: #FFFFFF;
  font-size: 11px;
  font-weight: 600;
  line-height: 16px;
}
.attendee-nick {
  max-width: 100%;
  font-size: 12px;
  color: var(--rf-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Multi-Address Navigation Bottom Sheet */
.nav-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(20, 35, 28, 0.5);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.nav-sheet {
  background: var(--rf-surface);
  border-radius: 16px 16px 0 0;
  padding: 16px 16px calc(20px + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.nav-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-sheet-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--rf-ink);
}
.nav-sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  font-size: 14px;
  color: var(--rf-muted);
}
.nav-sheet-list {
  max-height: 52vh;
}
.nav-sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px;
  margin-bottom: 8px;
  border-radius: 10px;
  background: var(--rf-bg);
}
.nav-sheet-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.nav-sheet-item-top {
  display: flex;
  align-items: center;
  gap: 6px;
}
.nav-kind-pill {
  flex-shrink: 0;
  padding: 1px 6px;
  border-radius: 4px;
  background: var(--rf-soft);
  color: var(--rf-primary-text);
  font-size: 12px;
  font-weight: 600;
}
.nav-sheet-name {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 14px;
  font-weight: 600;
  color: var(--rf-ink);
}
.nav-sheet-addr {
  overflow-wrap: anywhere;
  font-size: 12px;
  color: var(--rf-muted);
}

@import "../../styles/slate-components.wxss";
