.article-page {
  background: #f6f4ed;
}
.article-head {
  padding: 40rpx 30rpx 28rpx;
  background: #fffdf7;
}
.article-title {
  color: #1e332b;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.42;
  letter-spacing: -1rpx;
}
.article-meta {
  margin-top: 18rpx;
  color: #8a8f84;
  font-size: 23rpx;
  line-height: 1.6;
}
.share {
  margin: 18rpx 0 0;
  padding: 0;
  background: none;
  color: #4b776c;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: left;
}
.article-cover {
  width: 100%;
  height: 520rpx;
  background: #e2e7dc;
}
.article-intro {
  padding: 32rpx 30rpx;
  background: #eaf6f4;
  color: #52645d;
  font-size: 28rpx;
  line-height: 2;
}
.article-gallery image {
  width: 100%;
  height: 520rpx;
  margin-top: 20rpx;
  background: #e2e7dc;
}
.article-section {
  margin: 36rpx 20rpx 0;
  background: #fffdf7;
  box-shadow: 0 5rpx 18rpx rgba(34, 57, 47, .1);
}
.section-bar {
  padding: 22rpx 24rpx;
  background: #45b7c9;
  color: #fff;
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}
.section-body {
  padding: 26rpx 24rpx;
  color: #48564e;
  font-size: 27rpx;
  line-height: 1.9;
}
.section-footer {
  padding: 19rpx 24rpx;
  background: #45b7c9;
  color: #f3ffff;
  font-size: 23rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
.facts view {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 10rpx 0;
}
.facts view text:first-child {
  flex-shrink: 0;
  color: #5c6a62;
}
.facts view text:last-child {
  text-align: right;
  word-break: break-word;
}
.signup-copy {
  display: block;
  font-size: 27rpx;
  line-height: 2;
}
.registration-count {
  margin-bottom: 14rpx;
  color: #267565;
  font-weight: 650;
}
.participant-line {
  padding: 8rpx 0;
}
.article-page > .notice {
  margin: 28rpx 20rpx 0;
}
.article-page .sticky-action {
  margin-top: 40rpx;
}
.article-page .sticky-action button {
  width: 100%;
}
