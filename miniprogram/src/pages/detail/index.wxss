@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.article-page { padding-bottom: calc(110px + env(safe-area-inset-bottom)); background: var(--rf-bg); }
.article-cover { width: 100%; height: 240px; background: var(--rf-soft); }
.article-head { padding: 20px 16px 16px; background: var(--rf-surface); }
.article-title { color: var(--rf-ink); font-size: 24px; font-weight: 700; line-height: 1.45; }
.article-meta { margin-top: 8px; color: var(--rf-muted); font-size: 12px; line-height: 1.6; }
.share { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 0; margin: 8px 0 0; line-height: 1.5; text-align: left; background: transparent; color: var(--rf-primary-text); font-size: 13px; }
.share-icon { width: 18px; height: 18px; }
.article-intro { padding: 16px; background: var(--rf-surface); color: var(--rf-muted); font-size: 14px; line-height: 1.8; }
.article-gallery { padding: 0 16px; }
.article-gallery image { width: 100%; height: 220px; margin-top: 12px; border-radius: 12px; background: var(--rf-soft); }
.article-section { margin: 16px 16px 0; border: 1px solid var(--rf-line); border-radius: 12px; background: var(--rf-surface); overflow: hidden; }
.section-bar { padding: 16px 16px 12px; font-size: 18px; font-weight: 600; color: var(--rf-ink); border-bottom: 1px solid var(--rf-line); }
.section-body { padding: 16px; font-size: 14px; line-height: 1.8; color: var(--rf-ink); }
.facts view { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 6px 0; }
.facts view text:first-child { flex-shrink: 0; color: var(--rf-muted); }
.facts view text:last-child { text-align: right; overflow-wrap: break-word; }
.signup-copy { display: block; }
.registration-count { margin-bottom: 8px; font-weight: 600; color: var(--rf-primary-text); }
.participant-line { padding: 4px 0; }
.article-page > .notice { margin: 16px 16px 0; padding: 12px; }
.article-page .sticky-action button { width: 100%; }

@import "../../styles/slate-components.wxss";
