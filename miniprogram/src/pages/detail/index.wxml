<view class="back-space article-page">
  <view wx:if="{{loading}}" class="state">正在读取活动…</view>
  <view wx:elif="{{error}}" class="state error">{{error}}<button class="secondary" bindtap="retry">重试</button></view>
  <block wx:elif="{{activity}}">
    <view class="article-head">
      <view class="article-title">{{activity.title}}</view>
      <view class="article-meta">Wildboy 户外俱乐部 · {{activity.dateText}} 出发</view>
      <view class="article-meta">{{activity.categoryName}} · {{activity.location}}</view>
      <button open-type="share" class="share">分享活动 ↗</button>
    </view>
    <image class="article-cover" src="{{activity.coverUrl}}" mode="aspectFill" />
    <view class="article-intro">{{activity.summary}}</view>
    <view class="article-gallery" wx:if="{{activity.galleryUrls.length}}">
      <image wx:for="{{activity.galleryUrls}}" wx:key="*this" src="{{item}}" mode="aspectFill" lazy-load />
    </view>
    <view class="notice" wx:if="{{activity.status === 'CANCELLED'}}">该活动已被主理人取消，请勿按原计划前往。</view>
    <view class="article-section">
      <view class="section-bar">活动安排</view>
      <view class="section-body facts">
        <view><text>【出发时间】</text><text>{{activity.dateText}}</text></view>
        <view><text>【结束时间】</text><text>{{endDate}}</text></view>
        <view><text>【活动地点】</text><text>{{activity.location}}</text></view>
        <view><text>【集合地点】</text><text>{{activity.meetingPoint}}</text></view>
        <view><text>【报名截止】</text><text>{{deadline}}</text></view>
        <view><text>【同行名额】</text><text>{{activity.registeredCount}} / {{activity.capacity}} 人</text></view>
      </view>
    </view>
    <view class="article-section">
      <view class="section-bar">线路与流程</view>
      <view class="section-body"><text class="body-copy">{{activity.description}}</text></view>
    </view>
    <view class="article-section" wx:if="{{registration && registration.status === 'CONFIRMED'}}">
      <view class="section-bar">我的报名</view>
      <view class="section-body">
        <view class="registration-count">已报名 {{registration.participants.length}} 人</view>
        <view class="participant-line" wx:for="{{registration.participants}}" wx:key="id">参与人 {{index + 1}} · {{item.participantName}}</view>
      </view>
    </view>
    <view class="notice error" wx:if="{{registrationError}}">报名状态暂未同步：{{registrationError}}<text bindtap="retry">· 点击重试</text></view>
    <view class="article-section">
      <view class="section-bar">注意事项</view>
      <view class="section-body signup-copy">天气、路况可能变化，请量力报名、备齐装备、出发前核对安排，并听从领队、不留痕迹。取消规则以报名截止和活动开始时间为准。</view>
    </view>
    <view class="sticky-action">
      <button wx:if="{{registration && registration.status === 'CONFIRMED'}}" class="secondary" loading="{{cancelling}}" disabled="{{cancelling || !activity.canCancel}}" bindtap="cancel">{{activity.status === 'CANCELLED' ? '活动已取消' : (!activity.canCancel ? '已报名 · 已过取消截止时间' : '已报名 · 取消报名')}}</button>
      <button wx:else class="primary" disabled="{{!activity.enabled || !!registrationError}}" bindtap="register">{{activity.label}}</button>
    </view>
  </block>
</view>
