<view class="page">
  <view class="eyebrow">WILDBOY / ORGANIZER</view>
  <view class="title">管理员身份验证</view>
  <view class="muted">仅供已配置管理员账号的活动主理人使用。</view>
  <view class="notice">
    验证成功后切换为管理身份。不会修改原微信账号权限，密码不保存到设备。
  </view>
  <view class="field">
    <text class="label">管理员账号</text>
    <input
      value="{{username}}"
      maxlength="100"
      data-field="username"
      bindinput="input"
      disabled="{{busy}}"
      placeholder="请输入管理员账号"
    />
  </view>
  <view class="field">
    <text class="label">密码</text>
    <input
      value="{{password}}"
      password
      maxlength="200"
      data-field="password"
      bindinput="input"
      disabled="{{busy}}"
      placeholder="请输入密码"
    />
  </view>
  <view wx:if="{{error}}" class="error feedback">{{error}}</view>
  <button
    class="primary"
    bindtap="submit"
    loading="{{busy}}"
    disabled="{{busy}}"
  >
    验证并进入管理
  </button>
  <button class="secondary back" bindtap="back" disabled="{{busy}}">
    返回我的
  </button>
</view>
