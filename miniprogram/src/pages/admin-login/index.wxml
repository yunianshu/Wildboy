<view class="page">
  <view class="title">管理员身份验证</view>
  <view class="notice">
    登录后切换为管理身份，不改变微信账号权限。密码不保存到设备。
  </view>
  <view class="field">
    <text class="label">管理员账号</text>
    <input
      value="{{username}}"
      maxlength="100"
      data-field="username"
      bindinput="input"
      disabled="{{busy}}"
    />
  </view>
  <view class="field">
    <text class="label">密码</text>
    <input
      value="{{password}}"
      password
      maxlength="200"
      data-field="password"
      bindinput="input"
      disabled="{{busy}}"
    />
  </view>
  <view wx:if="{{error}}" class="error feedback">{{error}}</view>
  <button
    class="primary"
    bindtap="submit"
    loading="{{busy}}"
    disabled="{{busy}}"
  >
    登录
  </button>
  <button class="secondary back" bindtap="back" disabled="{{busy}}">
    返回我的
  </button>
</view>
