@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.legal-content {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.9;
  font-size: 14px;
  margin: 24px 0;
  color: var(--rf-ink);
}
.legal-contact {
  padding-top: 16px;
  border-top: 1px solid var(--rf-line);
  color: var(--rf-ink);
  line-height: 1.7;
}
.legal-contact-title { margin-bottom: 4px; font-weight: 700; }
.legal-contact-text { white-space: pre-wrap; overflow-wrap: anywhere; }

@import "../../styles/slate-components.wxss";
