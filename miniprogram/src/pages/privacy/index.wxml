<view class="page page-motion {{pageMotionClass}}">
  <ui-state wx:if="{{loading}}" kind="loading">正在读取已发布协议…</ui-state>
  <ui-state wx:elif="{{error}}" kind="error">
    {{error}}
    <button class="secondary ui-button ui-button-block" bindtap="retry">重试</button>
  </ui-state>
  <block wx:elif="{{document}}">
    <view class="title">{{document.title}}</view>
    <view class="muted">
      版本 {{document.version}} · 发布于 {{publishedText}}
    </view>
    <view class="legal-content">{{document.content}}</view>
    <view class="notice">
      如需咨询，请使用协议中的联系渠道。
    </view>
  </block>
</view>
