<view class="page success-page">
  <view wx:if="{{loading}}" class="state">正在核对服务器报名记录…</view>
  <view wx:elif="{{error}}" class="state error"
    >{{error}}<button class="secondary" bindtap="retry">重新核对</button
    ><button class="secondary" bindtap="registrations">我的报名</button></view
  >
  <block wx:elif="{{confirmed && activity && registration}}">
    <view class="success-mark">✓</view
    ><text class="eyebrow">SEE YOU OUTSIDE</text
    ><view class="title">山野见！</view
    ><view class="muted">已确认你的报名 · 免费，无需支付</view>
    <view class="trip"
      ><image src="{{activity.coverUrl}}" mode="aspectFill" /><view
        class="trip-content"
        ><view class="trip-title">{{activity.title}}</view
        ><view class="badge">已锁定 {{registration.participants.length}} 个名额</view
        ><view class="trip-row"
          ><text>出发时间</text><view>{{activity.dateText}}</view></view
        ><view class="trip-row"
          ><text>活动地点</text><view>{{activity.location}}</view></view
        ><view class="trip-row"
          ><text>集合地点</text><view>{{activity.meetingPoint}}</view></view
        ></view
      ></view
    >
    <view class="section-head"
      ><view class="section-title">参与人信息</view></view
    >
    <view class="record"
      ><view wx:for="{{registration.participants}}" wx:key="id"
        >参与人 {{index + 1}} · {{item.participantName}}</view
      ></view
    >
    <view class="notice"
      >出发前请再次核对活动安排。天气或组织计划可能变化；请按自身能力准备装备。取消规则见活动详情。</view
    >
    <button class="primary" bindtap="details">查看活动安排</button
    ><button class="secondary" bindtap="registrations">我的报名</button>
  </block>
</view>
