@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.success-page {
  text-align: center;
  padding-top: 54rpx;
}
.success-mark {
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  border-radius: 50%;
  background: var(--rf-soft);
  color: var(--rf-primary-text);
  font-size: 58rpx;
  margin: 0 auto 32rpx;
}
.trip {
  background: #FFFFFF;
  border-radius: 18rpx;
  overflow: hidden;
  text-align: left;
  margin: 40rpx 0 28rpx;
}
.trip image {
  width: 100%;
  height: 300rpx;
}
.trip-content {
  padding: 28rpx;
}
.trip-title {
  font-weight: 650;
  font-size: 34rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.trip-row {
  padding: 20rpx 0;
  line-height: 1.6;
  display: flex;
  gap: 28rpx;
}
.trip-row text {
  color: var(--rf-muted);
  flex-shrink: 0;
}
.trip-row view {
  word-break: break-all;
}
.notice {
  text-align: left;
  margin-bottom: 30rpx;
}
button {
  margin-top: 12rpx;
}

.status-icon { width: 64rpx; height: 64rpx; }
.success-mark { display: flex; align-items: center; justify-content: center; }

@import "../../styles/slate-components.wxss";
