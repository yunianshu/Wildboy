<view class="tab-page-viewport"
  bindtouchstart="startTabSwipe" bindtouchmove="moveTabSwipe"
  bindtouchend="endTabSwipe" bindtouchcancel="cancelTabSwipe">
  <view class="shop-page page-motion {{pageMotionClass}}">
  <view class="slate-tab-header uf-custom-header" style="padding-top:{{headerLayout.top}}px">
      <view class="uf-capsule-row" style="height:{{headerLayout.height}}px;padding-right:{{headerLayout.rightInset}}px"><view class="uf-title">山野装备</view></view>
    </view>
  <view class="page slate-tab-content shop-content">
    <input class="shop-search" value="{{searchInput}}" placeholder="搜索全部装备" maxlength="80" confirm-type="search" bindinput="searchProducts" />
    <view wx:if="{{categoriesError}}" class="category-retry">
      <text class="category-retry-text">{{categoriesError}}</text>
      <button class="secondary ui-button ui-button-small" bindtap="retryCategories">重试分类</button>
    </view>
    <scroll-view wx:elif="{{categories.length}}" class="section-tabs shop-category-viewport" scroll-x enhanced mark:tabSwipeIgnore="{{true}}" show-scrollbar="{{false}}" scroll-left="{{categoryScrollLeft}}" bindtouchstart="onCategoryTouchStart" bindtouchend="onCategoryTouchEnd" bindtouchcancel="onCategoryTouchCancel">
      <view class="section-tab-list shop-category-track">
        <button id="shop-category-all" class="section-tab {{selectedCategory === '' || selectedCategory === 'all' ? 'section-tab-current' : ''}}" data-id="all" bindtap="selectCategory" hover-class="section-tab-pressed" aria-label="全部{{selectedCategory === '' || selectedCategory === 'all' ? '，已选中' : ''}}">全部</button>
        <button id="shop-category-{{item.id}}" class="section-tab {{selectedCategory === item.id ? 'section-tab-current' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCategory" hover-class="section-tab-pressed" aria-label="{{item.name}}{{selectedCategory === item.id ? '，已选中' : ''}}">{{item.name}}</button>
      </view>
    </scroll-view>
    <view class="{{!categoriesError && categories.length ? 'section-tab-panel' : ''}}">
      <view wx:if="{{refreshing}}" class="shop-refresh-hint">正在更新装备…</view>
      <ui-state wx:if="{{loading}}" kind="loading">正在加载商品…</ui-state>
      <ui-state wx:elif="{{error && !items.length}}" kind="error">{{error}}<button class="secondary ui-button ui-button-block" bindtap="retry">重试</button></ui-state>
      <ui-state wx:elif="{{!(searchTerm ? searchResults.length : items.length)}}" kind="empty">{{searchTerm ? "没有匹配的商品" : "新装备正在准备中"}}</ui-state>
      <view wx:else class="product-grid">
        <view class="product-card" aria-label="{{item.name}}" wx:for="{{searchTerm ? searchResults : items}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
          <view class="product-image-wrap"><image src="{{item.imageUrl}}" mode="aspectFill" lazy-load /></view>
          <view class="product-name">{{item.name}}</view>
          <view class="product-bottom"><view class="price-wrap"><text class="price">{{item.priceText}}</text><text wx:if="{{item.originalPriceText}}" class="original-price">{{item.originalPriceText}}</text></view><text class="stock">{{item.stock ? '有库存' : '暂时售罄'}}</text></view>
        </view>
      </view>
      <view wx:if="{{error && items.length}}" class="shop-inline-error"><text>{{error}}</text><button class="secondary ui-button ui-button-small" bindtap="retry">重试</button>    </view>
</view>
</view>
</view>
</view>

