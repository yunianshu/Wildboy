<view class="shop-page">
  <view class="shop-hero">
    <image src="/assets/equipment.jpg" mode="aspectFill" />
    <view class="hero-shade" />
    <view class="brand" style="top:{{topInset}}px"><text class="brand-name">wildboy.</text><text class="brand-caption">FIELD SUPPLY</text></view>
    <view class="hero-copy"><view class="hero-title">山野装备</view></view>
  </view>
  <view class="page shop-content">
    <view class="shop-intro"><view class="section-title">全部装备</view></view>
    <view wx:if="{{loading}}" class="state">正在加载商品…</view>
    <view wx:elif="{{error}}" class="state error">{{error}}<button class="secondary" bindtap="retry">重试</button></view>
    <view wx:elif="{{!items.length}}" class="state">新装备正在准备中</view>
    <view wx:else class="product-grid">
      <view class="product-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
        <view class="product-image-wrap"><image src="{{item.imageUrl}}" mode="aspectFill" lazy-load /><text wx:if="{{!item.stock}}" class="sold-out">暂时售罄</text></view>
        <view class="product-name">{{item.name}}</view>
        <view class="product-bottom"><text class="price">{{item.priceText}}</text><text class="stock">{{item.stock ? '有库存' : '补货中'}}</text></view>
      </view>
    </view>
  </view>
</view>
