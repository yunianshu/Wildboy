@import "../../styles/slate-theme.wxss";
@import "../../styles/section-tabs.wxss";
@import "../../styles/category-search.wxss";
@import "../../styles/user-flow.wxss";
.category-retry, .shop-inline-error { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; font-size: 13px; color: var(--rf-danger); }
.category-retry-text { flex: 1; min-width: 0; }
.shop-refresh-hint { margin-top: 12px; color: var(--rf-muted); font-size: 12px; }
.product-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 12px; margin-top: 16px; }
.product-card { display: flex; flex-direction: column; min-width: 0; padding: 8px; border: 1px solid var(--rf-line); border-radius: 12px; background: var(--rf-surface); }
.product-image-wrap { height: 144px; overflow: hidden; border-radius: 8px; background: var(--rf-soft); }
.product-image-wrap image { width: 100%; height: 100%; }
.product-name { margin: 12px 4px; font-size: 15px; font-weight: 600; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.product-bottom { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px; margin-top: auto; padding: 0 4px 4px; }
.price-wrap { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px; min-width: 0; }
.price { color: var(--rf-primary-text); font-size: 17px; font-weight: 700; }
.original-price { color: var(--rf-muted); font-size: 12px; text-decoration: line-through; }
.stock { font-size: 12px; color: var(--rf-muted); }
.shop-inline-error { margin-top: 16px; }

@import "../../styles/slate-components.wxss";
