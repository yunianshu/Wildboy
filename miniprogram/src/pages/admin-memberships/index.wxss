.card{background:white;padding:28rpx;border-radius:24rpx;margin:24rpx 0}.tabs,.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:20rpx 0}.tabs button{flex:1}.tier-list{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.tier-list button{margin:0}input,.select{padding:20rpx;background:#f4f5ef;border-radius:12rpx;margin:16rpx 0}.row input{flex:1;min-width:0}.rule{border-top:1rpx solid #ddd;margin-top:20rpx;padding-top:10rpx}.user-id{display:block;word-break:break-all;font-size:24rpx;margin:16rpx 0}.error,.notice{padding:20rpx}
