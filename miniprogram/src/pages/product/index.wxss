.product-image { width: 100%; height: 640rpx; background: #e3e7dc; }
.product-content { padding-top: 36rpx; }
.product-title { margin: 14rpx 0 16rpx; font-size: 44rpx; font-weight: 700; line-height: 1.35; }
.price-line { display: flex; align-items: center; justify-content: space-between; }
.price { color: #8a4b31; font-size: 40rpx; font-weight: 700; }
.stock { color: #7d8478; font-size: 23rpx; }
.small-title { font-size: 31rpx; }
.product-content .notice { margin: 32rpx 0; }
.quantity-row { display: flex; align-items: center; justify-content: space-between; margin-top: 38rpx; }
.stepper { display: flex; align-items: center; height: 70rpx; border: 1rpx solid #d8decf; border-radius: 12rpx; overflow: hidden; }
.stepper button { width: 70rpx; height: 70rpx; padding: 0; background: #e8ecdf; color: #193f34; font-size: 34rpx; line-height: 70rpx; border-radius: 0; }
.stepper text { min-width: 70rpx; text-align: center; }
.purchase-bar { display: flex; align-items: center; gap: 24rpx; }
.purchase-total { display: flex; flex: 1; flex-direction: column; }
.purchase-total text { color: #7d8478; font-size: 21rpx; }
.purchase-total strong { color: #8a4b31; font-size: 34rpx; }
.purchase-bar .primary { flex: 1; }
