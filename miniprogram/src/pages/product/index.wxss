@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.product-image { width: 100%; height: 220px; background: var(--rf-soft); }
.product-content { padding-top: 36rpx; }
.product-title { margin: 12px 0 16px; font-size: 24px; font-weight: 700; line-height: 1.45; }
.price-line { display: flex; align-items: center; justify-content: space-between; }
.price-wrap { display: flex; align-items: baseline; gap: 10rpx; }
.price { color: var(--rf-primary-text); font-size: 40rpx; font-weight: 700; }
.original-price { color: var(--rf-muted); font-size: 24rpx; text-decoration: line-through; }
.stock { color: var(--rf-muted); font-size: 23rpx; }
.small-title { font-size: 31rpx; }
.detail-heading { margin-top: 48rpx; }
.product-content .notice { margin: 32rpx 0; }
.quantity-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 20px; }
.stepper { display: flex; align-items: center; flex-shrink: 0; height: 44px; border: 1px solid var(--rf-line); border-radius: 8px; overflow: hidden; }
.stepper button { display: flex; align-items: center; justify-content: center; flex: 0 0 44px; width: 44px; height: 44px; margin: 0; padding: 0; background: var(--rf-soft); color: var(--rf-primary-text); font-size: 17px; line-height: 1; border-radius: 0; }
.stepper text { min-width: 70rpx; text-align: center; }
.purchase-bar { display: flex; align-items: center; gap: 24rpx; }
.purchase-total { display: flex; flex: 1; flex-direction: column; }
.purchase-total text { color: var(--rf-muted); font-size: 21rpx; }
.purchase-total .amount-strong { font-weight: 600; color: var(--rf-primary-text); font-size: 34rpx; }
.purchase-bar .primary { flex: 1; }
.product-share { padding-top: 16px; }
.product-share .muted { margin-bottom: 8px; font-size: 12px; text-align: center; }
.product-share button { width: 100%; min-height: 44px; }

.step-icon { width: 32rpx; height: 32rpx; }

@import "../../styles/slate-components.wxss";
