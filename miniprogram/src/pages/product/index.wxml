<view class="back-space page-motion {{pageMotionClass}}">
  <ui-state wx:if="{{loading}}" kind="loading">正在读取商品…</ui-state>
  <ui-state wx:elif="{{error}}" kind="error">{{error}}<button class="secondary ui-button ui-button-block" bindtap="retry">重试</button></ui-state>
  <block wx:elif="{{product}}">
    <image class="product-image" src="{{product.imageUrl}}" mode="aspectFill" bindtap="previewImage" aria-label="查看商品大图" />
    <view class="page product-content">
      <view class="product-title">{{product.name}}</view>
      <view class="price-line"><view class="price-wrap"><text class="price">{{priceText}}</text><text wx:if="{{originalPriceText}}" class="original-price">{{originalPriceText}}</text></view><text class="stock">{{product.stock ? '库存 ' + product.stock + ' 件' : '暂时售罄'}}</text></view>
      <view wx:if="{{memberPriceText}}" class="notice">{{tierName || '会员'}}优惠价 {{memberPriceText}} / 件</view>
      <view wx:elif="{{quoteLoading}}" class="muted" aria-role="status">正在核对会员价…</view>
      <view wx:elif="{{quoteError}}" class="muted" bindtap="refreshQuote">会员价暂未确认 · 点击重试</view>
      <view class="section-title small-title detail-heading">装备细节</view>
      <markdown-view wx:if="{{contentNodes.length}}" nodes="{{contentNodes}}" preview-images="{{true}}"/>
      <content-view wx:elif="{{contentBlocks.length}}" blocks="{{contentBlocks}}" preview-images="{{true}}"/>
      <text wx:else class="body-copy">{{product.description}}</text>
      <view wx:if="{{contentError}}" class="muted" bindtap="loadRichContent">{{contentError}} · 重试</view>
      <view class="notice">价格与库存以下单确认为准。</view>
      <view class="quantity-row"><view><view class="section-title small-title">购买数量</view><view class="muted">单种商品最多 99 件</view></view><view class="stepper"><button data-delta="-1" bindtap="changeQuantity" disabled="{{quantity <= 1}}" aria-label="减少购买数量"><image class="step-icon" src="/assets/icons-slate/minus.svg" mode="aspectFit" aria-hidden="{{true}}" /></button><text>{{quantity}}</text><button data-delta="1" bindtap="changeQuantity" disabled="{{quantity >= product.stock || quantity >= 99}}" aria-label="增加购买数量"><image class="step-icon" src="/assets/icons-slate/plus.svg" mode="aspectFit" aria-hidden="{{true}}" /></button></view></view>
    </view>
    <view wx:if="{{!loggedIn}}" class="muted">登录后查看会员价</view>
    <button class="secondary ui-button ui-button-block" open-type="share">分享商品</button>
    <view class="sticky-action purchase-bar"><view class="purchase-total"><text>{{memberTotalText ? '优惠后合计' : '合计'}}</text><text class="amount-strong">{{memberTotalText || totalText}}</text></view><button class="primary" disabled="{{!product.stock}}" bindtap="buy">{{product.stock ? '立即购买' : '暂时售罄'}}</button></view>
  </block>
</view>
