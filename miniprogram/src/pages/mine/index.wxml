<view class="tab-page-viewport"
  bindtouchstart="startTabSwipe" bindtouchmove="moveTabSwipe"
  bindtouchend="endTabSwipe" bindtouchcancel="cancelTabSwipe">
  <view class="my-page page-motion {{pageMotionClass}}">
    <view class="slate-tab-header uf-custom-header" style="padding-top:{{headerLayout.top}}px">
      <view class="uf-capsule-row" style="height:{{headerLayout.height}}px;padding-right:{{headerLayout.rightInset}}px"><view class="uf-title">我的</view></view>
    </view>
    <view class="page slate-tab-content my-content">
      <ui-state wx:if="{{loading}}" kind="loading">正在加载账号…</ui-state>
      <view wx:else class="profile {{user ? '' : 'guest'}}">
        <button class="avatar" bindtap="displayProfile" hover-class="avatar-pressed" aria-label="打开头像与昵称">
          <image class="{{avatarUrl ? 'avatar-photo' : 'avatar-icon'}}" src="{{avatarUrl || '/assets/icons-slate/user.svg'}}" mode="aspectFill" binderror="avatarError" aria-hidden="{{true}}" />
        </button>
        <view class="profile-main" bindtap="displayProfile">
          <view class="profile-name">{{user ? (user.nickname || '山野同行者') : '一起走进山野'}}</view>
          <view wx:if="{{user}}" class="role">{{user.role === 'ADMIN' ? '管理员' : '微信用户'}}</view>
        </view>
        <button wx:if="{{!user}}" class="login-button" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="signIn">微信登录</button>
      </view>
      <ui-state wx:if="{{error}}" kind="error">{{error}}<button class="secondary ui-button ui-button-block" bindtap="retry">重试</button></ui-state>
      <view wx:if="{{requiresConsent}}" class="notice">
        协议已更新，需重新确认；不影响查看和取消已有报名。
        <button class="secondary" bindtap="confirmLegal">查看协议</button>
      </view>
      <view wx:if="{{legalStatusError}}" class="muted inline-retry" aria-role="button" hover-class="tap-pressed" bindtap="retryLegalStatus">{{legalStatusError}}{{legalStatusRetryable ? '（点击重试）' : ''}}</view>
      <view class="section-head">
        <view>
          <view class="section-title">一路的足迹</view>
        </view>
      </view>
      <view class="menu-grid">
        <view class="menu" bindtap="registrations" hover-class="card-pressed" aria-role="button">
          <image class="menu-icon" src="/assets/icons-slate/activity.svg" mode="aspectFit" aria-hidden="{{true}}" />
          <view class="menu-title">我的活动</view>

        </view>
        <view class="menu" bindtap="orders" hover-class="card-pressed" aria-role="button">
          <image class="menu-icon" src="/assets/icons-slate/order.svg" mode="aspectFit" aria-hidden="{{true}}" />
          <view class="menu-title">装备订单</view>

        </view>
      </view>
      <view wx:if="{{user.accountSource === 'WECHAT' && user.wechatVerified}}" class="menu-row" bindtap="displayProfile" hover-class="card-pressed" aria-role="button"><view class="menu-title">头像与昵称</view><image class="row-chevron" src="/assets/icons-slate/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
      <view class="menu-row" bindtap="addresses" hover-class="card-pressed" aria-role="button"><view class="menu-title">收货地址</view><image class="row-chevron" src="/assets/icons-slate/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
      <view class="menu-row" bindtap="profile" hover-class="card-pressed" aria-role="button"><view class="menu-title">联系资料与会员身份</view><image class="row-chevron" src="/assets/icons-slate/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
      <view class="links">
        <view bindtap="privacy" hover-class="tap-pressed" aria-role="button">隐私政策<image class="row-chevron" src="/assets/icons-slate/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
        <view bindtap="terms" hover-class="tap-pressed" aria-role="button">用户协议<image class="row-chevron" src="/assets/icons-slate/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
        <view wx:if="{{user}}" class="sign-out-link" bindtap="signOut" hover-class="tap-pressed" aria-role="button">退出当前账号<image class="row-chevron" src="/assets/icons-slate/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
      </view>
      <view class="app-version">{{version}}</view>
    </view>
  </view>
</view>
