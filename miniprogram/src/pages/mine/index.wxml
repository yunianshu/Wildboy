<view class="my-page page-motion {{pageMotionClass}}">
  <view class="my-hero">
    <image src="/assets/hero-hiking.jpg" mode="aspectFill" />
    <view class="hero-shade" />
    <view class="brand" style="top:{{topInset}}px">
      <text class="brand-name">wildboy.</text>
      <text class="brand-caption">YOUR OUTDOOR STORIES</text>
    </view>
    <view class="hero-copy">
      <view class="hero-title">我的山野</view>
    </view>
  </view>
  <view class="page my-content">
    <ui-state wx:if="{{loading}}" kind="loading">正在加载账号…</ui-state>
    <view wx:elif="{{user}}" class="profile">
      <view class="avatar"><image class="avatar-icon" src="/assets/icons/user.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
      <view class="profile-main">
        <view class="profile-name">{{user.nickname || '山野同行者'}}</view>
        <view class="role">{{user.role === 'ADMIN' ? '管理员' : '微信用户'}}</view>
      </view>
      <image class="profile-mark" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" />
    </view>
    <view wx:else class="profile guest">
      <view class="avatar"><image class="avatar-icon" src="/assets/icons/user.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
      <view class="profile-main">
        <view class="profile-name">一起走进山野</view>
      </view>
      <button class="login-button" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="signIn">微信登录</button>
    </view>
    <ui-state wx:if="{{error}}" kind="error">{{error}}<button class="secondary ui-button ui-button-block" bindtap="retry">重试</button></ui-state>
    <view wx:if="{{requiresConsent}}" class="notice">
      协议已更新，需重新确认；不影响查看和取消已有报名。
      <button class="secondary" bindtap="confirmLegal">查看协议</button>
    </view>
    <view wx:if="{{legalStatusError}}" class="muted" bindtap="retryLegalStatus">{{legalStatusError}}{{legalStatusRetryable ? '（点击重试）' : ''}}</view>
    <view class="section-head">
      <view>
        <view class="section-title">一路的足迹</view>
      </view>
    </view>
    <view class="menu-grid">
      <view class="menu" bindtap="registrations">
        <image class="menu-icon" src="/assets/icons/activity.svg" mode="aspectFit" aria-hidden="{{true}}" />
        <view class="menu-title">我的报名</view>

      </view>
      <view class="menu" bindtap="orders">
        <image class="menu-icon" src="/assets/icons/order.svg" mode="aspectFit" aria-hidden="{{true}}" />
        <view class="menu-title">我的订单</view>

      </view>
    </view>
    <view class="menu-row" bindtap="profile"><view class="menu-title">联系资料</view><image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
    <view class="menu-row" bindtap="notifications"><view class="menu-title">活动消息</view><image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
    <view class="menu-row" bindtap="addresses"><view class="menu-title">收货地址</view><image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
    <view class="section-head compact">
      <view class="section-title">继续探索</view>
    </view>
    <view class="menu-row" bindtap="explore">
      <view><view class="menu-title">发现下一次出发</view></view>
      <image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" />
    </view>
    <view wx:if="{{user.role === 'ADMIN'}}" class="menu-row" bindtap="userManage">
      <view><view class="menu-title">用户管理</view></view>
      <image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" />
    </view>
    <view wx:if="{{user.role === 'ADMIN'}}" class="menu-row" bindtap="manage">
      <view><view class="menu-title">活动管理</view></view>
      <image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" />
    </view>
    <view wx:if="{{user.role === 'ADMIN'}}" class="menu-row" bindtap="legalManage">
      <view><view class="menu-title">协议管理</view></view>
      <image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" />
    </view>
    <view wx:if="{{user.role === 'ADMIN'}}" class="menu-row" bindtap="shopManage"><view><view class="menu-title">商品管理</view></view><image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
    <view wx:if="{{user.role === 'ADMIN'}}" class="menu-row" bindtap="orderManage"><view><view class="menu-title">订单管理</view></view><image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
    <view class="links">
      <view bindtap="privacy">隐私政策<image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
      <view bindtap="terms">用户协议<image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
      <view wx:if="{{user}}" bindtap="signOut">退出当前账号<image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
    </view>
    <view wx:if="{{adminLoginEnabled}}" class="admin-auth" bindtap="adminSignIn">管理员登录<image class="row-chevron" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
  </view>
</view>
