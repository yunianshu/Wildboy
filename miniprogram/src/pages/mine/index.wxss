.my-page {
  padding-top: 42rpx;
}
.profile {
  position: relative;
  background: #193f34;
  color: #fffdf4;
  border-radius: 20rpx;
  padding: 34rpx;
  margin: 32rpx 0 48rpx;
  min-height: 244rpx;
}
.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #dbe6c8;
  color: #193f34;
  font-size: 42rpx;
  font-weight: 700;
  text-align: center;
  line-height: 84rpx;
  float: left;
  margin-right: 24rpx;
}
.profile-name {
  font-size: 34rpx;
  font-weight: 650;
  padding-top: 8rpx;
}
.role {
  display: inline-block;
  background: #dbe6c8;
  color: #193f34;
  border-radius: 24rpx;
  padding: 5rpx 18rpx;
  font-size: 20rpx;
  margin-top: 10rpx;
}
.profile-note {
  clear: both;
  padding-top: 28rpx;
  font-size: 24rpx;
  color: #d6dfcc;
  line-height: 1.7;
}
.login-button {
  margin: 24rpx 0 0;
  background: #e4ebd7;
  color: #193f34;
}
.section {
  margin-bottom: 22rpx;
}
.menu {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fffdf7;
  border-radius: 14rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.menu-title {
  font-size: 30rpx;
  font-weight: 650;
  margin-bottom: 8rpx;
}
.menu-title .badge {
  margin-left: 16rpx;
}
.links {
  margin-top: 54rpx;
}
.links view {
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid #dce1d5;
}
.links text {
  float: right;
}
.admin-auth {
  text-align: center;
  font-size: 24rpx;
  color: #5c6d60;
  padding: 34rpx 20rpx;
}
.notice {
  margin-top: 28rpx;
}
