@import "../../styles/slate-theme.wxss";
@import "../../styles/user-flow.wxss";
.profile { display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--rf-surface); border: 1px solid var(--rf-line); border-radius: 12px; }
button.avatar { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; flex-shrink: 0; margin: 0; padding: 0; border-radius: 50%; background: var(--rf-soft); }
button.avatar-pressed { background: var(--rf-line); }
.avatar-icon { width: 28px; height: 28px; }
.profile-main { flex: 1; min-width: 0; }
.profile-name { font-size: 18px; font-weight: 600; overflow-wrap: break-word; }
.role { display: inline-block; margin-top: 6px; color: var(--rf-muted); font-size: 12px; }
.guest { flex-wrap: wrap; }
.guest .login-button { flex: 0 0 100%; }
.login-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 44px; line-height: 1.4; margin: 0; color: var(--rf-on-primary); background: var(--rf-primary); border-radius: 8px; }
.my-content .section-head { margin: 24px 0 12px; }
.menu-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 12px; margin-bottom: 16px; }
.menu { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 16px; border-radius: 12px; border: 1px solid var(--rf-line); background: var(--rf-surface); }
.menu-icon { width: 24px; height: 24px; }
.menu-title { font-size: 15px; font-weight: 500; line-height: 1.5; }
.menu-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; padding: 16px; margin-bottom: 8px; border-radius: 12px; background: var(--rf-surface); }
.links { margin-top: 24px; }
.links view { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; padding: 12px 0; border-bottom: 1px solid var(--rf-line); }
.row-chevron { width: 18px; height: 18px; flex-shrink: 0; }
.admin-auth { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; margin-top: 16px; color: var(--rf-muted); font-size: 13px; }
.admin-auth image { width: 16px; height: 16px; }
.notice { margin-top: 16px; }
.app-version { margin-top: 24px; text-align: center; color: var(--rf-muted); font-size: 12px; }

@import "../../styles/slate-components.wxss";
