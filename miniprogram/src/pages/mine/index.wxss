.my-hero {
  height: 420rpx;
  position: relative;
  overflow: hidden;
  background: #23483b;
}
.my-hero > image,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.hero-shade {
  background: linear-gradient(180deg, rgba(10, 35, 26, .3), rgba(10, 35, 26, .76));
}
.brand {
  position: absolute;
  left: 32rpx;
  display: flex;
  flex-direction: column;
  color: #fff;
}
.brand-name {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}
.brand-caption {
  margin-top: 4rpx;
  font-size: 15rpx;
  letter-spacing: 3rpx;
  opacity: .82;
}
.hero-copy {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 46rpx;
  color: #fff;
}
.hero-kicker {
  font-size: 16rpx;
  letter-spacing: 3rpx;
  opacity: .76;
}
.hero-title {
  margin-top: 10rpx;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}
.hero-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  opacity: .86;
}
.my-content {
  position: relative;
  padding-top: 0;
}
.profile {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 132rpx;
  padding: 28rpx;
  margin-top: -22rpx;
  background: #fffdf7;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 36rpx rgba(25, 63, 52, .08);
}
.avatar {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #dbe6c8;
  color: #193f34;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  line-height: 76rpx;
}
.profile-main {
  flex: 1;
  min-width: 0;
}
.profile-name {
  font-size: 32rpx;
  font-weight: 650;
}
.profile-note {
  margin-top: 8rpx;
  color: #7c8178;
  font-size: 23rpx;
  line-height: 1.6;
}
.role {
  display: inline-block;
  margin-top: 8rpx;
  padding: 3rpx 14rpx;
  border-radius: 24rpx;
  background: #e3ead7;
  color: #52654b;
  font-size: 19rpx;
}
.profile-mark {
  color: #8a947f;
  font-size: 34rpx;
}
.guest {
  flex-wrap: wrap;
}
.guest .login-button {
  flex: 0 0 100%;
}
.login-button {
  width: 100%;
  margin-top: 8rpx;
  background: #193f34;
  color: #fffdf4;
}
.my-content .section-head {
  margin: 44rpx 0 22rpx;
}
.my-content .section-head.compact {
  margin-top: 36rpx;
}
.menu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.menu {
  min-height: 172rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #e8ecdf;
}
.menu:nth-child(2) {
  background: #eee9dc;
}
.menu-icon {
  display: block;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}
.menu-title {
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.5;
}
.menu .muted {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
}
.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 14rpx;
  border-radius: 14rpx;
  background: #fffdf7;
}
.menu-row .muted {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
}
.menu-title .badge {
  margin-left: 12rpx;
}
.links {
  margin-top: 36rpx;
}
.links view {
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #dce1d5;
}
.links text {
  float: right;
}
.admin-auth {
  padding: 28rpx 20rpx 12rpx;
  text-align: center;
  color: #5c6d60;
  font-size: 23rpx;
}
.notice {
  margin-top: 24rpx;
}
