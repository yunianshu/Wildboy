# Public AnyService origin for the Wildboy API.
# Rendered by deploy/deploy.sh: __ANY_AUTH_HEADER__ is replaced with the
# credential from /root/wildboy-deploy/anyservice-cred.txt. Only requests
# carrying the AnyService source credential are forwarded, so the API is not
# anonymously reachable by IP even though port 80 is public.
map_hash_bucket_size 128;
map $http_x_anyservice_authorization $wildboy_anyservice_allowed {
    default 0;
    "__ANY_AUTH_HEADER__" 1;
}

server {
    listen 80;
    server_name _;
    server_tokens off;
    client_max_body_size 6m;

    location /api/ {
        if ($wildboy_anyservice_allowed = 0) {
            return 403;
        }
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # AnyService supplies the real client address; pass it through so the
        # backend login limiter sees one bucket per user instead of one global
        # bucket owned by this reverse proxy.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        return 404;
    }
}
