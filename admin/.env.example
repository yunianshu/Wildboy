# Only for npm run dev, ignored by production login UI. Backend dev profile required.
VITE_ENABLE_DEV_LOGIN=false
# Vite development proxy only; production reverse-proxy /api/v1 to backend.
API_PROXY_TARGET=http://localhost:8080
# Optional public Gaode Web JS API key; restrict it to the allowed admin domains.
# The security code stays behind the same-origin /_AMapService proxy, never in VITE_*.
# See docs/admin-amap-picker.md.
VITE_AMAP_JS_KEY=
